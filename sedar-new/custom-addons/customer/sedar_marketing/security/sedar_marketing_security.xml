<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sedar_marketing" model="ir.module.category">
        <field name="name">SEDAR Marketing</field>
        <field name="sequence">15</field>
    </record>
    <record id="privilege_sedar_marketing" model="res.groups.privilege">
        <field name="name">Marketing</field>
        <field name="category_id" ref="module_category_sedar_marketing"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_marketing_officer" model="res.groups">
        <field name="name">Marketing Officer</field>
        <field name="privilege_id" ref="privilege_sedar_marketing"/>
        <field name="implied_ids" eval="[Command.link(ref('sedar_marine_operations.group_customer_relations'))]"/>
    </record>
    <record id="group_marketing_manager" model="res.groups">
        <field name="name">Marketing Manager</field>
        <field name="privilege_id" ref="privilege_sedar_marketing"/>
        <field name="implied_ids" eval="[Command.link(ref('group_marketing_officer')), Command.link(ref('sedar_marine_operations.group_commercial_manager'))]"/>
    </record>
</odoo>
