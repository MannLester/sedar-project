<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_sedar_marketing_customer" model="ir.sequence">
        <field name="name">SEDAR Customer</field><field name="code">sedar.marketing.customer</field>
        <field name="prefix">CUS-</field><field name="padding">3</field>
    </record>
    <record id="seq_sedar_marketing_quotation" model="ir.sequence">
        <field name="name">SEDAR Marketing Quotation</field><field name="code">sedar.marketing.quotation</field>
        <field name="prefix">QT-%(year)s-</field><field name="padding">3</field>
    </record>
    <record id="seq_sedar_marketing_contract" model="ir.sequence">
        <field name="name">SEDAR Marketing Contract</field><field name="code">sedar.marketing.contract</field>
        <field name="prefix">CT-%(year)s-</field><field name="padding">3</field>
    </record>
    <record id="seq_sedar_marketing_document" model="ir.sequence">
        <field name="name">SEDAR Customer Document</field><field name="code">sedar.marketing.document</field>
        <field name="prefix">DOC-%(year)s-</field><field name="padding">3</field>
    </record>
    <record id="seq_sedar_marketing_document_request" model="ir.sequence">
        <field name="name">SEDAR Customer Document Request</field><field name="code">sedar.marketing.document.request</field>
        <field name="prefix">DR-%(year)s-</field><field name="padding">3</field>
    </record>
</odoo>
