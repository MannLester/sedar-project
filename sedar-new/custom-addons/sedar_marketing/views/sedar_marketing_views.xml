<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sedar_marketing_dashboard_form" model="ir.ui.view">
        <field name="name">sedar.marketing.dashboard.form</field>
        <field name="model">sedar.marketing.dashboard</field>
        <field name="arch" type="xml">
            <form string="Marketing Dashboard" create="0" edit="0" class="o_sedar_marketing_dashboard">
                <sheet>
                    <div class="o_sedar_marketing_titlebar">
                        <div><h1>Marketing Dashboard</h1><p>Overview of customer relationships and service operations.</p></div>
                        <div class="o_sedar_marketing_actions">
                            <button name="action_new_service_request" type="object" string="New Service Request" class="btn-primary"/>
                            <button name="action_schedule_appointment" type="object" string="Schedule Appointment"/>
                        </div>
                    </div>
                    <div class="o_sedar_metric_grid">
                        <button name="action_open_service_requests" type="object" class="o_sedar_metric_card">
                            <span class="o_sedar_metric_label">Service Requests</span><field name="service_request_count" class="o_sedar_metric_value"/>
                            <span class="o_sedar_metric_hint"><field name="pending_service_request_count"/> active</span>
                        </button>
                        <button name="action_open_quotations" type="object" class="o_sedar_metric_card">
                            <span class="o_sedar_metric_label">Quotations</span><field name="quotation_count" class="o_sedar_metric_value"/>
                            <span class="o_sedar_metric_hint"><field name="pending_quotation_count"/> awaiting action</span>
                        </button>
                        <button name="action_open_contracts" type="object" class="o_sedar_metric_card">
                            <span class="o_sedar_metric_label">Contracts</span><field name="contract_count" class="o_sedar_metric_value"/>
                            <span class="o_sedar_metric_hint"><field name="active_contract_count"/> active</span>
                        </button>
                        <button name="action_open_service_requests" type="object" class="o_sedar_metric_card">
                            <span class="o_sedar_metric_label">Completed Services</span><field name="completed_service_count" class="o_sedar_metric_value"/>
                        </button>
                    </div>
                    <div class="o_sedar_dashboard_columns">
                        <section class="o_sedar_panel">
                            <h2>Upcoming Appointment</h2>
                            <field name="upcoming_appointment_id" context="{'form_view_ref': 'sedar_marketing.view_sedar_marketing_appointment_form'}"/>
                            <div class="o_sedar_metric_hint"><field name="today_appointment_count"/> appointments today</div>
                            <button name="action_open_appointments" type="object" string="View Full Calendar" class="btn-link"/>
                        </section>
                        <section class="o_sedar_panel">
                            <h2>Recent Activity</h2>
                            <field name="recent_activity_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0"><field name="occurred_at"/><field name="description"/><field name="actor_name"/><field name="visibility"/></list>
                            </field>
                        </section>
                    </div>
                    <section class="o_sedar_panel"><h2>Internal Notes</h2>
                        <field name="recent_note_ids" nolabel="1" readonly="1"><list create="0" delete="0" edit="0"><field name="customer_id"/><field name="author_id"/><field name="note"/><field name="create_date"/></list></field>
                    </section>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sedar_marketing_customer_search" model="ir.ui.view">
        <field name="name">sedar.marketing.customer.search</field><field name="model">res.partner</field>
        <field name="arch" type="xml"><search string="Customers">
            <field name="sedar_customer_code"/><field name="name"/><field name="sedar_primary_contact_id"/>
            <field name="sedar_assigned_marketing_user_id"/><field name="sedar_customer_type"/>
            <filter name="active_accounts" string="Active" domain="[('sedar_account_status','=','active')]"/>
            <filter name="prospects" string="Prospects" domain="[('sedar_account_status','=','prospect')]"/>
            <filter name="follow_up" string="Needs Follow-up" domain="[('sedar_next_follow_up_date','&lt;=',context_today().strftime('%Y-%m-%d'))]"/>
            <separator/><filter name="group_status" string="Status" context="{'group_by':'sedar_account_status'}"/>
            <filter name="group_type" string="Customer Type" context="{'group_by':'sedar_customer_type'}"/>
            <filter name="group_rep" string="Representative" context="{'group_by':'sedar_assigned_marketing_user_id'}"/>
        </search></field>
    </record>

    <record id="view_sedar_marketing_customer_list" model="ir.ui.view">
        <field name="name">sedar.marketing.customer.list</field><field name="model">res.partner</field>
        <field name="arch" type="xml"><list string="Customer Directory" decoration-danger="sedar_account_status == 'restricted'" decoration-muted="sedar_account_status == 'inactive'">
            <field name="sedar_customer_code"/><field name="name"/><field name="sedar_primary_contact_id"/>
            <field name="sedar_customer_type"/><field name="sedar_total_service_request_count" string="Requests"/>
            <field name="sedar_active_contract_count" string="Active Contracts"/><field name="sedar_last_interaction_at"/>
            <field name="sedar_assigned_marketing_user_id"/><field name="sedar_account_status"/>
        </list></field>
    </record>

    <record id="view_sedar_marketing_customer_form" model="ir.ui.view">
        <field name="name">sedar.marketing.customer.form</field><field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Customer Account" class="o_sedar_customer_profile">
                <sheet>
                    <field name="sedar_is_customer_account" invisible="1"/>
                    <div class="o_sedar_customer_header">
                        <div class="oe_title"><span class="o_sedar_eyebrow">Customer Account</span><h1><field name="name"/></h1>
                            <div class="o_sedar_header_badges"><field name="sedar_customer_code"/><field name="sedar_customer_type"/><field name="sedar_account_status" widget="badge"/></div>
                        </div>
                        <div class="o_sedar_header_meta"><div><span>Assigned Representative</span><field name="sedar_assigned_marketing_user_id"/></div><div><span>Last Interaction</span><field name="sedar_last_interaction_at"/></div><div><span>Relationship</span><field name="sedar_relationship_status"/></div></div>
                    </div>
                    <div class="o_sedar_metric_grid o_sedar_customer_metrics">
                        <div class="o_sedar_metric_card"><span class="o_sedar_metric_label">Total Service Requests</span><field name="sedar_total_service_request_count" class="o_sedar_metric_value"/></div>
                        <div class="o_sedar_metric_card"><span class="o_sedar_metric_label">Active Quotations</span><field name="sedar_active_quotation_count" class="o_sedar_metric_value"/></div>
                        <div class="o_sedar_metric_card"><span class="o_sedar_metric_label">Active Contracts</span><field name="sedar_active_contract_count" class="o_sedar_metric_value"/></div>
                        <div class="o_sedar_metric_card"><span class="o_sedar_metric_label">Completed Services</span><field name="sedar_completed_service_count" class="o_sedar_metric_value"/></div>
                    </div>
                    <notebook>
                        <page string="Overview" name="overview">
                            <div class="o_sedar_dashboard_columns">
                                <section class="o_sedar_panel"><h2>Company Information</h2><group>
                                    <group><field name="name"/><field name="sedar_customer_code"/><field name="sedar_customer_type"/><field name="sedar_account_status"/><field name="vat" string="Tax Identification Number"/></group>
                                    <group><field name="street"/><field name="street2"/><field name="city"/><field name="state_id"/><field name="country_id"/><field name="email"/><field name="phone"/><field name="website"/></group>
                                </group></section>
                                <section class="o_sedar_panel"><h2>Primary Contact</h2><group><field name="sedar_primary_contact_id" domain="[('commercial_partner_id','=',id),('id','!=',id)]"/></group>
                                    <h2>Marketing Relationship</h2><group><field name="sedar_lead_source"/><field name="sedar_customer_since"/><field name="sedar_next_follow_up_date"/><field name="sedar_relationship_status"/></group>
                                </section>
                            </div>
                            <section class="o_sedar_panel"><h2>Recent Activity</h2><field name="sedar_marketing_activity_ids" readonly="1" nolabel="1"><list create="0" delete="0" edit="0" limit="5"><field name="occurred_at"/><field name="description"/><field name="actor_name"/><field name="visibility"/></list></field></section>
                            <section class="o_sedar_panel"><h2>Marketing-only Internal Notes</h2><field name="sedar_marketing_note_ids" nolabel="1"><list editable="bottom"><field name="author_id" readonly="1"/><field name="note"/><field name="create_date" readonly="1"/></list></field></section>
                        </page>
                        <page string="Contacts" name="contacts">
                            <field name="child_ids" context="{'default_parent_id': id, 'default_type': 'contact'}"><list>
                                <field name="name"/><field name="function"/><field name="sedar_contact_type_ids" widget="many2many_tags"/><field name="email"/><field name="phone"/><field name="sedar_preferred_contact_method"/><field name="sedar_last_contacted_at"/><field name="sedar_contact_status"/><field name="sedar_is_primary_contact"/>
                            </list></field>
                        </page>
                        <page string="Service Requests" name="service_requests"><field name="sedar_service_order_ids" context="{'default_client_id': id}"><list><field name="name"/><field name="assisted_vessel_name"/><field name="service_type_id"/><field name="requested_start"/><field name="port_id"/><field name="number_of_tugs"/><field name="priority"/><field name="marketing_status"/><field name="marketing_representative_id"/></list></field></page>
                        <page string="Quotations" name="quotations"><field name="sedar_marketing_quotation_ids" context="{'default_customer_id': id}"><list><field name="name"/><field name="service_order_id"/><field name="subject"/><field name="issued_at"/><field name="valid_until"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/><field name="status"/><field name="prepared_by_id"/></list></field></page>
                        <page string="Contracts" name="contracts"><field name="sedar_marketing_contract_ids" context="{'default_customer_id': id}"><list><field name="name"/><field name="title"/><field name="quotation_id"/><field name="effective_date"/><field name="expiration_date"/><field name="contract_value"/><field name="currency_id" column_invisible="True"/><field name="signature_status"/><field name="status"/><field name="managed_by_id"/></list></field></page>
                        <page string="Transaction History" name="transactions"><field name="sedar_marketing_transaction_ids" readonly="1" nolabel="1"><list create="0" delete="0" edit="0"><field name="occurred_at"/><field name="transaction_type"/><field name="reference"/><field name="description"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="status"/><field name="source_department"/></list></field></page>
                        <page string="Appointments" name="appointments"><field name="sedar_marketing_appointment_ids" context="{'default_sedar_is_marketing_appointment': True, 'default_sedar_customer_id': id}"><list><field name="start"/><field name="stop"/><field name="name"/><field name="sedar_contact_id"/><field name="sedar_appointment_type"/><field name="sedar_meeting_method"/><field name="user_id"/><field name="sedar_appointment_status"/></list></field></page>
                        <page string="Documents" name="documents">
                            <separator string="Documents"/><field name="sedar_marketing_document_ids" context="{'default_customer_id': id}"><list><field name="name"/><field name="title"/><field name="document_type"/><field name="department"/><field name="visibility"/><field name="source"/><field name="current_version"/><field name="expiry_date"/><field name="status"/><field name="is_marketing_editable"/></list></field>
                            <separator string="Document Requests"/><field name="sedar_marketing_document_request_ids" context="{'default_customer_id': id}"><list><field name="name"/><field name="title"/><field name="document_type"/><field name="department"/><field name="requested_at"/><field name="due_date"/><field name="status"/></list></field>
                        </page>
                        <page string="Activity Log" name="activity_log"><field name="sedar_marketing_activity_ids" readonly="1" nolabel="1"><list create="0" delete="0" edit="0"><field name="occurred_at"/><field name="module"/><field name="action"/><field name="description"/><field name="actor_name"/><field name="actor_department"/><field name="visibility"/><field name="reference"/><field name="change_summary"/></list></field></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sedar_marketing_contact_extension" model="ir.ui.view">
        <field name="name">res.partner.sedar.marketing.contact</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="SEDAR Marketing Contact" invisible="not parent_id">
            <group><group><field name="sedar_contact_type_ids" widget="many2many_tags"/><field name="sedar_contact_status"/><field name="sedar_preferred_contact_method"/><field name="tz"/></group>
            <group><field name="sedar_availability_day_ids" widget="many2many_tags"/><field name="sedar_preferred_contact_start" widget="float_time"/><field name="sedar_preferred_contact_end" widget="float_time"/><field name="sedar_last_contacted_at"/></group></group>
            <group string="Authorizations"><field name="sedar_can_approve_quotations"/><field name="sedar_can_sign_contracts"/><field name="sedar_can_coordinate_operations"/></group><field name="sedar_contact_internal_notes"/>
        </page></xpath></field>
    </record>

    <record id="view_sedar_marketing_service_request_form" model="ir.ui.view">
        <field name="name">sedar.marine.service.order.marketing.form</field><field name="model">sedar.marine.service.order</field><field name="inherit_id" ref="sedar_marine_operations.view_service_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_marketing_submit_review" type="object" string="Submit for Review" class="btn-primary" invisible="marketing_status != 'draft'" groups="sedar_marketing.group_marketing_officer"/>
                <button name="action_marketing_send_operations" type="object" string="Request Operations Review" class="btn-primary" invisible="marketing_status != 'under_review'" groups="sedar_marketing.group_marketing_officer"/>
                <button name="action_marketing_prepare_quotation" type="object" string="Quotation Prepared" invisible="marketing_status not in ['under_review','awaiting_operations']" groups="sedar_marketing.group_marketing_officer"/>
                <button name="action_marketing_send_customer" type="object" string="Send to Customer" class="btn-primary" invisible="marketing_status != 'quotation_prepared'" groups="sedar_marketing.group_marketing_officer"/>
                <button name="action_marketing_approve" type="object" string="Record Customer Approval" class="btn-primary" invisible="marketing_status != 'awaiting_customer'" groups="sedar_marketing.group_marketing_officer"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside"><page string="Marketing" groups="sedar_marketing.group_marketing_officer"><group><group><field name="marketing_status"/><field name="marketing_representative_id"/><field name="requested_operations_reviewer_id"/><field name="marketing_follow_up_date"/></group><group><field name="marketing_tag_ids" widget="many2many_tags"/><field name="marketing_internal_notes"/></group></group><separator string="Quotations"/><field name="marketing_quotation_ids"><list><field name="name"/><field name="revision_number"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/><field name="valid_until"/><field name="status"/></list></field><separator string="Contracts"/><field name="marketing_contract_ids"><list><field name="name"/><field name="title"/><field name="effective_date"/><field name="expiration_date"/><field name="signature_status"/><field name="status"/></list></field></page></xpath>
        </field>
    </record>

    <record id="view_sedar_marketing_quotation_list" model="ir.ui.view"><field name="name">sedar.marketing.quotation.list</field><field name="model">sedar.marketing.quotation</field><field name="arch" type="xml"><list decoration-success="status == 'customer_approved'" decoration-muted="status in ['expired','superseded']"><field name="name"/><field name="revision_number"/><field name="customer_id"/><field name="service_order_id"/><field name="subject"/><field name="issued_at"/><field name="valid_until"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/><field name="status"/><field name="prepared_by_id"/></list></field></record>
    <record id="view_sedar_marketing_quotation_form" model="ir.ui.view"><field name="name">sedar.marketing.quotation.form</field><field name="model">sedar.marketing.quotation</field><field name="arch" type="xml"><form string="Marketing Quotation"><header>
        <button name="action_submit_internal_approval" type="object" string="Submit for Internal Approval" class="btn-primary" invisible="status != 'draft'"/><button name="action_approve_internal" type="object" string="Approve Internally" class="btn-primary" invisible="status != 'internal_approval'" groups="sedar_marketing.group_marketing_manager"/><button name="action_send" type="object" string="Send" class="btn-primary" invisible="status != 'ready'"/><button name="action_mark_viewed" type="object" string="Mark Viewed" invisible="status != 'sent'"/><button name="action_record_customer_approval" type="object" string="Record Approval" class="btn-primary" invisible="status not in ['sent','viewed']"/><button name="action_record_rejection" type="object" string="Record Rejection" invisible="status not in ['sent','viewed']"/><button name="action_create_revision" type="object" string="Create Revision" invisible="status not in ['sent','viewed','customer_approved','rejected']"/>
        <field name="status" widget="statusbar" statusbar_visible="draft,internal_approval,ready,sent,viewed,customer_approved"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><div>Revision <field name="revision_number"/></div></div><group><group><field name="service_order_id"/><field name="customer_id"/><field name="contact_id" domain="[('commercial_partner_id','=',customer_id)]"/><field name="subject"/><field name="purchase_order_reference"/></group><group><field name="prepared_by_id"/><field name="issued_at"/><field name="validity_days"/><field name="valid_until"/><field name="currency_id"/></group></group><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="description"/><field name="quantity"/><field name="unit_price"/><field name="tax_rate"/><field name="subtotal" readonly="1"/><field name="tax_amount" readonly="1"/><field name="currency_id" column_invisible="True"/></list></field><group class="oe_subtotal_footer"><field name="amount_untaxed"/><field name="tax_amount"/><field name="amount_total"/></group><notebook><page string="Terms"><field name="terms_reference"/><field name="terms_and_conditions"/></page><page string="Customer Response"><group><field name="response_type"/><field name="response_contact_id" domain="[('commercial_partner_id','=',customer_id)]"/><field name="response_date"/><field name="customer_notes"/><field name="rejection_reason"/></group></page><page string="Revision"><field name="original_quotation_id"/><field name="supersedes_quotation_id"/><field name="superseded_by_quotation_id"/><field name="revision_reason"/></page><page string="Internal Notes"><field name="internal_notes"/></page></notebook></sheet><chatter/></form></field></record>

    <record id="view_sedar_marketing_contract_list" model="ir.ui.view"><field name="name">sedar.marketing.contract.list</field><field name="model">sedar.marketing.contract</field><field name="arch" type="xml"><list decoration-success="status == 'active'" decoration-muted="status in ['expired','superseded','terminated']"><field name="name"/><field name="title"/><field name="customer_id"/><field name="quotation_id"/><field name="service_type_id"/><field name="effective_date"/><field name="expiration_date"/><field name="contract_value"/><field name="currency_id" column_invisible="True"/><field name="signature_status"/><field name="status"/><field name="managed_by_id"/></list></field></record>
    <record id="view_sedar_marketing_contract_form" model="ir.ui.view"><field name="name">sedar.marketing.contract.form</field><field name="model">sedar.marketing.contract</field><field name="arch" type="xml"><form string="Marketing Contract"><header><button name="action_submit_internal_review" type="object" string="Submit for Internal Review" class="btn-primary" invisible="status != 'draft'"/><button name="action_approve_internal_review" type="object" string="Approve Review" class="btn-primary" invisible="status != 'internal_review'" groups="sedar_marketing.group_marketing_manager"/><button name="action_send_for_signature" type="object" string="Send for Signature" class="btn-primary" invisible="status != 'ready_signature'"/><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="status != 'awaiting_signatures'"/><button name="action_request_termination" type="object" string="Request Termination" invisible="status != 'active'"/><button name="action_approve_termination" type="object" string="Approve Termination" invisible="termination_request_status != 'pending'" groups="sedar_marketing.group_marketing_manager"/><field name="status" widget="statusbar" statusbar_visible="draft,internal_review,ready_signature,awaiting_signatures,active"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="title"/></h2></div><group><group><field name="quotation_id" domain="[('status','=','customer_approved')]"/><field name="service_order_id"/><field name="customer_id"/><field name="contact_id" domain="[('commercial_partner_id','=',customer_id)]"/><field name="service_type_id"/><field name="vessel_name"/></group><group><field name="effective_date"/><field name="expiration_date"/><field name="contract_value"/><field name="currency_id"/><field name="prepared_by_id"/><field name="managed_by_id"/><field name="signature_status"/></group></group><notebook><page string="Terms"><field name="description"/><field name="terms_and_conditions"/></page><page string="Signatures"><group><field name="selected_customer_contact_id" domain="[('commercial_partner_id','=',customer_id),('sedar_can_sign_contracts','=',True)]"/><field name="sent_for_signature_at"/><field name="fully_executed_at"/></group><field name="signature_ids"><list editable="bottom"><field name="party"/><field name="signatory_name"/><field name="organization"/><field name="position"/><field name="signature_role"/><field name="signed_at"/><field name="verification_status"/><field name="supporting_document_name"/></list></field></page><page string="Termination"><group><field name="termination_reason"/><field name="termination_explanation"/><field name="requested_termination_date"/><field name="termination_request_status"/><field name="termination_requested_by_id"/><field name="termination_requested_at"/><field name="termination_effective_date"/></group></page><page string="Internal Notes"><field name="internal_notes"/></page></notebook></sheet><chatter/></form></field></record>

    <record id="view_sedar_marketing_appointment_form" model="ir.ui.view"><field name="name">calendar.event.sedar.marketing.form</field><field name="model">calendar.event</field><field name="arch" type="xml"><form string="Marketing Appointment"><header><button name="action_sedar_confirm" type="object" string="Confirm" class="btn-primary" invisible="sedar_appointment_status not in ['pending','scheduled','rescheduled']"/><button name="action_sedar_reschedule" type="object" string="Mark Rescheduled" invisible="sedar_appointment_status not in ['pending','scheduled','confirmed']"/><button name="action_sedar_complete" type="object" string="Complete" class="btn-primary" invisible="sedar_appointment_status not in ['scheduled','confirmed','rescheduled']"/><button name="action_sedar_no_show" type="object" string="No Show" invisible="sedar_appointment_status not in ['scheduled','confirmed','rescheduled']"/><button name="action_sedar_cancel" type="object" string="Cancel" invisible="sedar_appointment_status not in ['pending','scheduled','confirmed','rescheduled']"/><button name="action_sedar_complete_follow_up" type="object" string="Complete Follow-up" invisible="not sedar_follow_up_required or sedar_follow_up_completed"/><field name="sedar_appointment_status" widget="statusbar" statusbar_visible="pending,scheduled,confirmed,rescheduled,completed"/></header><sheet><field name="sedar_is_marketing_appointment" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="sedar_customer_id"/><field name="sedar_contact_id" domain="[('commercial_partner_id','=',sedar_customer_id)]"/><field name="sedar_appointment_type"/><field name="user_id" string="Assigned Representative"/></group><group><field name="start"/><field name="stop"/><field name="allday"/><field name="sedar_meeting_method"/><field name="location" invisible="sedar_meeting_method != 'in_person'"/><field name="sedar_phone_number" invisible="sedar_meeting_method != 'pho