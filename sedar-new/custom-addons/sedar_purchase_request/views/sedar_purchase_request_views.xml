<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sedar_purchase_request_search" model="ir.ui.view">
        <field name="name">sedar.purchase.request.search</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Purchase Requests">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="vendor_id"/>
                <field name="maintenance_request_id"/>
                <field name="service_order_id"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="po_created" string="RFQ Created" domain="[('state', '=', 'po_created')]"/>
                <filter name="urgent" string="Urgent / Emergency" domain="[('priority', 'in', ['urgent', 'emergency'])]"/>
                <separator/>
                <filter name="group_state" string="Group by Status" context="{'group_by': 'state'}"/>
                <filter name="group_source" string="Group by Source" context="{'group_by': 'source_type'}"/>
                <filter name="group_vendor" string="Group by Vendor" context="{'group_by': 'vendor_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_sedar_purchase_request_list" model="ir.ui.view">
        <field name="name">sedar.purchase.request.list</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="priority == 'urgent'" decoration-danger="priority == 'emergency'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="source_type"/>
                <field name="vendor_id"/>
                <field name="required_date"/>
                <field name="priority"/>
                <field name="estimated_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="purchase_order_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sedar_purchase_request_form" model="ir.ui.view">
        <field name="name">sedar.purchase.request.form</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ['draft', 'rejected']"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="sedar_purchase_request.group_sedar_purchase_request_manager" invisible="state != 'submitted'"/>
                    <button name="action_create_rfq" type="object" string="Create RFQ" class="btn-primary" groups="sedar_purchase_request.group_sedar_purchase_request_manager" invisible="state != 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" groups="sedar_purchase_request.group_sedar_purchase_request_manager" invisible="state not in ['submitted', 'approved']"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ['po_created', 'cancelled']"/>
                    <button name="action_open_purchase_order" type="object" string="Open RFQ / PO" invisible="not purchase_order_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,po_created"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id"/>
                            <field name="department_id"/>
                            <field name="source_type"/>
                            <field name="maintenance_request_id" invisible="source_type != 'maintenance'"/>
                            <field name="service_order_id" invisible="source_type not in ['inventory', 'operations']"/>
                        </group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="required_date"/>
                            <field name="priority"/>
                            <field name="currency_id"/>
                            <field name="estimated_total" readonly="1"/>
                        </group>
                    </group>
                    <field name="justification"/>
                    <notebook>
                        <page string="Request Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="estimated_unit_price"/>
                                    <field name="estimated_subtotal"/>
                                    <field name="source_location_id"/>
                                    <field name="maintenance_part_line_id"/>
                                    <field name="inventory_requirement_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval and RFQ">
                            <group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_at" readonly="1"/>
                                    <field name="rejected_by_id" readonly="1"/>
                                    <field name="rejected_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="purchase_order_id" readonly="1"/>
                                    <field name="purchase_order_state" readonly="1"/>
                                    <field name="company_id"/>
                                </group>
                            </group>
                            <field name="rejection_reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sedar_purchase_requests" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">sedar.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sedar_purchase_request_search"/>
    </record>

    <menuitem id="menu_sedar_procurement_root" name="Procurement" parent="sedar_marine_operations.menu_marine_operations" sequence="80" groups="sedar_purchase_request.group_sedar_purchase_request_user,sedar_marine_inventory.group_marine_inventory_user,sedar_marine_maintenance.group_marine_maintenance_user"/>
    <menuitem id="menu_sedar_purchase_requests" name="Purchase Requests" parent="menu_sedar_procurement_root" action="action_sedar_purchase_requests" sequence="10"/>
</odoo>
