<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sedar_purchase_request_search" model="ir.ui.view">
        <field name="name">sedar.purchase.request.search</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Purchase Requests">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="equipment_id"/>
                <field name="maintenance_request_id"/>
                <field name="service_order_id"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="urgent" string="Urgent / Emergency" domain="[('priority', 'in', ['urgent', 'emergency'])]"/>
                <separator/>
                <filter name="group_state" string="Group by Internal Progress" context="{'group_by': 'state'}"/>
                <filter name="group_procurement_progress" string="Group by Procurement Progress" context="{'group_by': 'procurement_progress'}"/>
                <filter name="group_source" string="Group by Source" context="{'group_by': 'source_type'}"/>
            </search>
        </field>
    </record>

    <record id="view_sedar_purchase_request_list" model="ir.ui.view">
        <field name="name">sedar.purchase.request.list</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="priority == 'urgent'" decoration-danger="priority == 'emergency'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="source_type"/>
                <field name="equipment_id" optional="show"/>
                <field name="required_date"/>
                <field name="priority"/>
                <field name="estimated_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="purchase_order_count" string="Purchase Orders" optional="show"/>
                <field name="state" string="Internal Progress"/>
                <field name="procurement_progress" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sedar_purchase_request_form" model="ir.ui.view">
        <field name="name">sedar.purchase.request.form</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ['draft', 'rejected']"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="state != 'submitted' or not is_procurement_inventory_officer"/>
                    <button name="action_reject" type="object" string="Reject" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="state not in ['submitted', 'approved'] or not is_procurement_inventory_officer"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ['draft', 'submitted', 'rejected']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,po_created"/>
                    <field name="is_procurement_inventory_officer" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="purchase_order_count == 0 or not is_procurement_inventory_officer">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="not is_procurement_inventory_officer or state not in ['draft', 'rejected']"/>
                            <field name="department_id" readonly="state not in ['draft', 'rejected']"/>
                            <field name="source_type" readonly="state not in ['draft', 'rejected']"/>
                            <field name="maintenance_request_id" readonly="state not in ['draft', 'rejected']" invisible="source_type != 'maintenance'"/>
                            <field name="service_order_id" readonly="state not in ['draft', 'rejected']" invisible="source_type not in ['inventory', 'operations']"/>
                            <field name="equipment_id" readonly="state not in ['draft', 'rejected']"/>
                        </group>
                        <group>
                            <field name="required_date" readonly="state not in ['draft', 'rejected']"/>
                            <field name="priority" readonly="state not in ['draft', 'rejected']"/>
                            <field name="currency_id" readonly="state not in ['draft', 'rejected']"/>
                            <field name="estimated_total" readonly="1"/>
                            <field name="procurement_progress" readonly="1"/>
                        </group>
                    </group>
                    <field name="justification" readonly="state not in ['draft', 'rejected']"/>
                    <notebook>
                        <page string="Request Lines">
                            <field name="line_ids" readonly="state not in ['draft', 'rejected']">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="estimated_unit_price"/>
                                    <field name="estimated_subtotal"/>
                                    <field name="source_location_id"/>
                                    <field name="maintenance_part_line_id"/>
                                    <field name="inventory_requirement_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Review">
                            <group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_at" readonly="1"/>
                                    <field name="rejected_by_id" readonly="1"/>
                                    <field name="rejected_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="company_id" readonly="not is_procurement_inventory_officer or state not in ['draft', 'rejected']"/>
                                </group>
                            </group>
                            <field name="rejection_reason" readonly="not is_procurement_inventory_officer or state not in ['submitted', 'approved']"/>
                        </page>
                    </notebook>
                    <field name="vendor_id" invisible="1"/>
                    <field name="purchase_order_id" invisible="1"/>
                    <field name="purchase_order_state" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_res_config_settings_sedar_purchase_request" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sedar.purchase.request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="SEDAR Purchase Requests">
                    <setting string="Procurement and Inventory Officer" help="Receives the review activity when an internal Purchase Request is submitted.">
                        <field name="sedar_procurement_inventory_officer_id" domain="[['all_group_ids', 'in', %(sedar_marine_inventory.group_marine_inventory_manager)d]]"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="action_sedar_purchase_requests" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">sedar.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sedar_purchase_request_search"/>
    </record>

    <menuitem id="menu_sedar_procurement_root" name="Procurement" parent="sedar_marine_operations.menu_marine_operations" sequence="80" groups="sedar_purchase_request.group_sedar_purchase_request_user,sedar_marine_inventory.group_marine_inventory_user,sedar_marine_maintenance.group_marine_maintenance_user"/>
    <menuitem id="menu_sedar_purchase_requests" name="Purchase Requests" parent="menu_sedar_procurement_root" action="action_sedar_purchase_requests" sequence="10"/>
</odoo>
