<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sedar_purchase_request_search" model="ir.ui.view">
        <field name="name">sedar.purchase.request.search</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Purchase Requests">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="equipment_id"/>
                <field name="maintenance_request_id"/>
                <field name="service_order_id"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="urgent" string="Urgent / Emergency" domain="[('priority', 'in', ['urgent', 'emergency'])]"/>
                <separator/>
                <filter name="group_state" string="Group by Internal Progress" context="{'group_by': 'state'}"/>
                <filter name="group_procurement_progress" string="Group by Procurement Progress" context="{'group_by': 'procurement_progress'}"/>
                <filter name="group_source" string="Group by Source" context="{'group_by': 'source_type'}"/>
            </search>
        </field>
    </record>

    <record id="view_sedar_purchase_request_list" model="ir.ui.view">
        <field name="name">sedar.purchase.request.list</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="priority == 'urgent'" decoration-danger="priority == 'emergency'">
                <field name="name"/>
                <field name="state" string="Internal Progress"/>
                <field name="procurement_progress" optional="show"/>
                <field name="required_date"/>
                <field name="priority"/>
                <field name="source_type"/>
                <field name="requester_id"/>
                <field name="equipment_id" optional="hide"/>
                <field name="estimated_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="bid_count" string="Bidders" optional="hide" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
                <field name="winning_bidder_ids" widget="many2many_tags" optional="hide" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
                <field name="awarded_total" sum="Awarded Value" optional="hide" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
                <field name="purchase_order_count" string="Purchase Orders" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sedar_purchase_request_form" model="ir.ui.view">
        <field name="name">sedar.purchase.request.form</field>
        <field name="model">sedar.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ['draft', 'rejected']"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="state != 'submitted' or not is_procurement_inventory_officer"/>
                    <button name="action_reject" type="object" string="Reject" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="state not in ['submitted', 'approved'] or not is_procurement_inventory_officer"/>
                    <button name="action_create_purchase_orders" type="object" string="Create Purchase Orders" class="btn-primary" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="state != 'approved' or procurement_progress != 'fully_awarded' or not is_procurement_inventory_officer"/>
                    <button name="action_open_handoff_recovery_wizard" type="object" string="Recover Handoff" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="not legacy_handoff_recovery_required or not is_procurement_inventory_officer"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ['draft', 'submitted', 'rejected']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,po_created"/>
                    <field name="is_procurement_inventory_officer" invisible="1"/>
                    <field name="procurement_progress" invisible="1"/>
                    <field name="legacy_handoff_recovery_required" invisible="1"/>
                </header>
                <sheet>
                    <field name="id" invisible="1"/>
                    <div class="o_sedar_mobile_procurement_actions d-md-none mb-3" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="not is_procurement_inventory_officer">
                        <button name="action_open_bids" type="object" string="Bids" class="btn btn-secondary me-2 mb-2" invisible="state not in ['approved', 'po_created']"/>
                        <button name="action_open_bid_comparison" type="object" string="Compare Bids" class="btn btn-secondary me-2 mb-2" invisible="state not in ['approved', 'po_created']"/>
                        <button name="action_open_purchase_orders" type="object" string="Purchase Orders" class="btn btn-secondary mb-2" invisible="purchase_order_count == 0"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_bids" type="object" class="oe_stat_button" icon="fa-file-text-o" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="state not in ['approved', 'po_created'] or not is_procurement_inventory_officer">
                            <field name="bid_count" widget="statinfo" string="Bids"/>
                        </button>
                        <button name="action_open_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="purchase_order_count == 0 or not is_procurement_inventory_officer">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                        <button name="action_open_awards" type="object" class="oe_stat_button" icon="fa-trophy" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="award_count == 0 or not is_procurement_inventory_officer">
                            <field name="award_count" widget="statinfo" string="Awards"/>
                        </button>
                        <button name="action_open_bid_comparison" type="object" class="oe_stat_button" icon="fa-balance-scale" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="state not in ['approved', 'po_created'] or not is_procurement_inventory_officer">
                            <div class="o_stat_info"><span class="o_stat_text">Compare Bids</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="not is_procurement_inventory_officer or state not in ['draft', 'rejected']"/>
                            <field name="department_id" readonly="state not in ['draft', 'rejected']"/>
                            <field name="source_type" readonly="state not in ['draft', 'rejected']"/>
                            <field name="maintenance_request_id" readonly="state not in ['draft', 'rejected']" invisible="source_type != 'maintenance'"/>
                            <field name="service_order_id" readonly="state not in ['draft', 'rejected']" invisible="source_type not in ['inventory', 'operations']"/>
                            <field name="equipment_id" readonly="state not in ['draft', 'rejected']"/>
                        </group>
                        <group>
                            <field name="required_date" readonly="state not in ['draft', 'rejected']"/>
                            <field name="priority" readonly="state not in ['draft', 'rejected']"/>
                            <field name="currency_id" readonly="state not in ['draft', 'rejected']"/>
                            <field name="estimated_total" readonly="1"/>
                            <field name="procurement_progress" readonly="1"/>
                            <field name="bid_count" string="Bidders" readonly="1" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
                            <field name="winning_bidder_ids" widget="many2many_tags" readonly="1" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
                            <field name="awarded_total" readonly="1" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
                        </group>
                    </group>
                    <field name="justification" readonly="state not in ['draft', 'rejected']"/>
                    <notebook>
                        <page string="Request Lines">
                            <field name="line_ids" readonly="state not in ['draft', 'rejected']">
                                <list editable="bottom" open_form_view="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <button name="action_open_award_wizard" type="object" string="Award" icon="fa-trophy" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="parent.state != 'approved' or not parent.is_procurement_inventory_officer or line_state != 'active' or current_award_id"/>
                                    <button name="action_open_cancel_wizard" type="object" string="Cancel Line" icon="fa-ban" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="parent.state != 'approved' or not parent.is_procurement_inventory_officer or line_state != 'active' or current_award_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id" optional="hide"/>
                                    <field name="estimated_unit_price" optional="hide"/>
                                    <field name="estimated_subtotal" optional="hide"/>
                                    <field name="source_location_id" optional="hide"/>
                                    <field name="maintenance_part_line_id" optional="hide"/>
                                    <field name="inventory_requirement_id" optional="hide"/>
                                    <field name="line_state" groups="sedar_marine_inventory.group_marine_inventory_manager" optional="show"/>
                                    <field name="current_award_id" groups="sedar_marine_inventory.group_marine_inventory_manager" optional="hide"/>
                                    <field name="bid_count" string="Bidders" groups="sedar_marine_inventory.group_marine_inventory_manager" optional="show"/>
                                </list>
                                <form string="Requested Product">
                                    <header>
                                        <button name="action_open_award_wizard" type="object" string="Compare and Award" class="btn-primary" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="parent.state != 'approved' or not parent.is_procurement_inventory_officer or line_state != 'active' or current_award_id"/>
                                        <button name="action_open_cancel_wizard" type="object" string="Cancel Product" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="parent.state != 'approved' or not parent.is_procurement_inventory_officer or line_state != 'active' or current_award_id"/>
                                    </header>
                                    <sheet>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="quantity"/>
                                            <field name="product_uom_id"/>
                                            <field name="need_reason"/>
                                        </group>
                                        <group groups="sedar_marine_inventory.group_marine_inventory_manager">
                                            <field name="line_state"/>
                                            <field name="current_award_id"/>
                                            <field name="cancellation_reason" invisible="line_state != 'cancelled'"/>
                                            <field name="cancelled_by_id" invisible="line_state != 'cancelled'"/>
                                            <field name="cancelled_at" invisible="line_state != 'cancelled'"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Awards" groups="sedar_marine_inventory.group_marine_inventory_manager" invisible="not is_procurement_inventory_officer">
                            <field name="award_ids" readonly="1">
                                <list create="0" delete="0" decoration-muted="state == 'reset'">
                                    <field name="product_id"/>
                                    <field name="bidder_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="award_reason" optional="show"/>
                                    <field name="awarded_by_id" optional="show"/>
                                    <field name="awarded_at" optional="show"/>
                                    <field name="state"/>
                                    <button name="action_open_reset_wizard" type="object" string="Reset" icon="fa-undo" invisible="state != 'awarded' or purchase_order_line_id"/>
                                    <field name="purchase_order_line_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Review">
                            <group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_at" readonly="1"/>
                                    <field name="rejected_by_id" readonly="1"/>
                                    <field name="rejected_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="company_id" readonly="not is_procurement_inventory_officer or state not in ['draft', 'rejected']"/>
                                </group>
                            </group>
                            <field name="rejection_reason" readonly="not is_procurement_inventory_officer or state not in ['submitted', 'approved']"/>
                            <group string="Legacy Handoff Recovery" invisible="not handoff_recovered_at">
                                <field name="handoff_recovery_reason" readonly="1"/>
                                <field name="handoff_recovered_by_id" readonly="1"/>
                                <field name="handoff_recovered_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="vendor_id" invisible="1"/>
                    <field name="purchase_order_id" invisible="1"/>
                    <field name="purchase_order_state" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sedar_purchase_line_award_list" model="ir.ui.view">
        <field name="name">sedar.purchase.line.award.list</field>
        <field name="model">sedar.purchase.line.award</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="state == 'reset'">
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="bidder_id"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="unit_price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="awarded_by_id" optional="show"/>
                <field name="awarded_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sedar_purchase_line_award_form" model="ir.ui.view">
        <field name="name">sedar.purchase.line.award.form</field>
        <field name="model">sedar.purchase.line.award</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" string="Line Award">
                <header>
                    <button name="action_open_reset_wizard" type="object" string="Reset Award" invisible="state != 'awarded' or purchase_order_line_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="awarded,ordered,reset"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="request_line_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                        </group>
                        <group>
                            <field name="bid_id"/>
                            <field name="bid_line_id"/>
                            <field name="bidder_id"/>
                            <field name="unit_price"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="award_reason"/>
                        <field name="expired_bid_override"/>
                        <field name="expired_bid_override_reason" invisible="not expired_bid_override"/>
                        <field name="zero_price_confirmed"/>
                    </group>
                    <group string="Audit">
                        <group>
                            <field name="awarded_by_id"/>
                            <field name="awarded_at"/>
                            <field name="purchase_order_line_id"/>
                        </group>
                        <group invisible="state != 'reset'">
                            <field name="reset_reason"/>
                            <field name="reset_by_id"/>
                            <field name="reset_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sedar_purchase_line_award_wizard_form" model="ir.ui.view">
        <field name="name">sedar.purchase.line.award.wizard.form</field>
        <field name="model">sedar.purchase.line.award.wizard</field>
        <field name="arch" type="xml">
            <form string="Award Product Line">
                <group>
                    <group>
                        <field name="request_line_id"/>
                        <field name="bid_line_id" domain="[('request_line_id', '=', request_line_id), ('bid_id.state', '=', 'received')]" options="{'no_create': True, 'no_open': True}"/>
                        <field name="award_reason" placeholder="Explain the best-value decision (price, availability, delivery, warranty, or terms)."/>
                    </group>
                    <group string="Selected Bid" invisible="not bid_line_id">
                        <field name="bidder_id"/>
                        <field name="quantity"/>
                        <field name="product_uom_id"/>
                        <field name="unit_price"/>
                        <field name="currency_id"/>
                        <field name="validity_date"/>
                        <field name="promised_delivery_date"/>
                        <field name="availability_note"/>
                        <field name="warranty_notes"/>
                    </group>
                </group>
                <group string="Exceptions">
                    <group>
                        <field name="expired_bid_override"/>
                        <field name="expired_bid_override_reason" invisible="not expired_bid_override" required="expired_bid_override"/>
                    </group>
                    <group>
                        <field name="zero_price_confirmed"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Record Award" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sedar_purchase_bid_line_search" model="ir.ui.view">
        <field name="name">sedar.purchase.bid.line.search</field>
        <field name="model">sedar.purchase.bid.line</field>
        <field name="arch" type="xml">
            <search string="Bid Comparison">
                <field name="request_line_id"/>
                <field name="bidder_id"/>
                <field name="product_id"/>
                <filter name="group_request" string="Group by Purchase Request" context="{'group_by': 'request_id'}"/>
                <filter name="group_request_line" string="Group by Requested Product" context="{'group_by': 'request_line_id'}"/>
                <filter name="group_bidder" string="Group by Bidder" context="{'group_by': 'bidder_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_sedar_purchase_bid_line_comparison_list" model="ir.ui.view">
        <field name="name">sedar.purchase.bid.line.comparison.list</field>
        <field name="model">sedar.purchase.bid.line</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <list string="Bid Comparison" create="0" edit="0" delete="0">
                <field name="request_line_id" optional="hide"/>
                <field name="product_id" optional="hide"/>
                <field name="bidder_id" width="240px"/>
                <field name="unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="quantity" optional="hide"/>
                <field name="product_uom_id" optional="hide"/>
                <field name="availability_note" optional="hide"/>
                <field name="promised_delivery_date" optional="hide"/>
                <field name="validity_date" optional="hide"/>
                <field name="subtotal" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sedar_purchase_bid_line_comparison_form" model="ir.ui.view">
        <field name="name">sedar.purchase.bid.line.comparison.form</field>
        <field name="model">sedar.purchase.bid.line</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <form string="Quoted Product" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="request_line_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                        </group>
                        <group>
                            <field name="bid_id"/>
                            <field name="bidder_id"/>
                            <field name="unit_price"/>
                            <field name="currency_id"/>
                            <field name="subtotal"/>
                        </group>
                    </group>
                    <group string="Availability and Delivery">
                        <field name="availability_note"/>
                        <field name="promised_delivery_date"/>
                        <field name="validity_date"/>
                        <field name="delivery_terms"/>
                        <field name="warranty_notes"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sedar_purchase_line_award_reset_wizard_form" model="ir.ui.view">
        <field name="name">sedar.purchase.line.award.reset.wizard.form</field>
        <field name="model">sedar.purchase.line.award.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Line Award">
                <group>
                    <group>
                        <field name="award_id"/>
                        <field name="reason" placeholder="Why must this award be reset?"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reset Award" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sedar_purchase_request_line_cancel_wizard_form" model="ir.ui.view">
        <field name="name">sedar.purchase.request.line.cancel.wizard.form</field>
        <field name="model">sedar.purchase.request.line.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Requested Product">
                <group>
                    <group>
                        <field name="request_line_id"/>
                        <field name="reason" placeholder="Why is this requested product no longer part of the approved need?"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Product" class="btn-primary"/>
                    <button string="Keep Product" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sedar_purchase_request_recovery_wizard_form" model="ir.ui.view">
        <field name="name">sedar.purchase.request.recovery.wizard.form</field>
        <field name="model">sedar.purchase.request.recovery.wizard</field>
        <field name="arch" type="xml">
            <form string="Recover Legacy Handoff">
                <group>
                    <group>
                        <field name="request_id"/>
                        <field name="reason" placeholder="Explain why this incomplete legacy handoff is being returned to procurement review."/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Return to Approved" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_purchase_order_form_sedar_award_source" model="ir.ui.view">
        <field name="name">purchase.order.form.sedar.award.source</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sedar_purchase_request_id" readonly="1" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
                <field name="sedar_bid_id" readonly="1" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_sedar_purchase_bid_search" model="ir.ui.view">
        <field name="name">sedar.purchase.bid.search</field>
        <field name="model">sedar.purchase.bid</field>
        <field name="arch" type="xml">
            <search string="Bidder List">
                <field name="name"/>
                <field name="request_id"/>
                <field name="bidder_id"/>
                <filter name="active_bids" string="Active Bids" domain="['&amp;', ('state', '!=', 'withdrawn'), '|', ('validity_date', '=', False), ('validity_date', '&gt;=', context_today())]"/>
                <filter name="partial_coverage" string="Partial Coverage" domain="[('coverage_state', '=', 'partial')]"/>
                <filter name="has_awards" string="Has Awards" domain="[('award_count', '&gt;', 0)]"/>
                <filter name="no_awards" string="No Awards" domain="[('award_count', '=', 0)]"/>
                <filter name="closed_expired_history" string="Closed / Expired History" domain="['|', ('state', '=', 'withdrawn'), '&amp;', ('validity_date', '!=', False), ('validity_date', '&lt;', context_today())]"/>
                <separator/>
                <filter name="group_request" string="Group by Purchase Request" context="{'group_by': 'request_id'}"/>
                <filter name="group_bidder" string="Group by Bidder" context="{'group_by': 'bidder_id'}"/>
                <filter name="group_state" string="Group by Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_sedar_purchase_bid_list" model="ir.ui.view">
        <field name="name">sedar.purchase.bid.list</field>
        <field name="model">sedar.purchase.bid</field>
        <field name="arch" type="xml">
            <list string="Bidder List" decoration-muted="state == 'withdrawn'">
                <field name="name" optional="hide"/>
                <field name="request_id"/>
                <field name="state"/>
                <field name="bidder_id"/>
                <field name="received_date" optional="hide"/>
                <field name="validity_date" optional="hide"/>
                <field name="promised_delivery_date" optional="hide"/>
                <field name="quoted_line_count" string="Quoted Lines" optional="hide"/>
                <field name="active_request_line_count" string="Request Lines" optional="hide"/>
                <field name="coverage_state" string="Coverage" optional="show"/>
                <field name="total_amount" sum="Total"/>
                <field name="award_count" string="Awards" optional="hide"/>
                <field name="awarded_amount" sum="Awarded Value" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sedar_purchase_bid_form" model="ir.ui.view">
        <field name="name">sedar.purchase.bid.form</field>
        <field name="model">sedar.purchase.bid</field>
        <field name="arch" type="xml">
            <form string="Bid">
                <header>
                    <button name="action_receive" type="object" string="Mark Received" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_withdraw" type="object" string="Withdraw" invisible="state != 'received'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,withdrawn"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" readonly="id or state != 'draft'"/>
                            <field name="bidder_id" readonly="id or state != 'draft'"/>
                            <field name="received_date" readonly="state != 'draft'"/>
                            <field name="validity_date" readonly="state != 'draft'"/>
                            <field name="promised_delivery_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="capture_source" readonly="1"/>
                            <field name="quotation_file" filename="quotation_filename" readonly="state != 'draft'"/>
                            <field name="quotation_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quoted Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="id" column_invisible="True"/>
                                    <field name="request_line_id" domain="[('request_id', '=', parent.request_id)]" readonly="id"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="availability_note" optional="show"/>
                                    <field name="promised_delivery_date" optional="show"/>
                                </list>
                                <form string="Quoted Product">
                                    <field name="id" invisible="1"/>
                                    <group>
                                        <group>
                                            <field name="request_line_id" domain="[('request_id', '=', parent.request_id)]" readonly="id"/>
                                            <field name="product_id" readonly="1"/>
                                            <field name="quantity" readonly="1"/>
                                            <field name="product_uom_id" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="unit_price"/>
                                            <field name="subtotal" readonly="1"/>
                                            <field name="currency_id" invisible="1"/>
                                            <field name="availability_note"/>
                                            <field name="promised_delivery_date"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="delivery_terms"/>
                                        <field name="notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Commercial Terms">
                            <group>
                                <field name="delivery_terms" readonly="state != 'draft'"/>
                                <field name="availability_notes" readonly="state != 'draft'"/>
                                <field name="payment_terms" readonly="state != 'draft'"/>
                                <field name="warranty_notes" readonly="state != 'draft'"/>
                                <field name="commercial_notes" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Audit">
                            <group>
                                <group>
                                    <field name="received_by_id" readonly="1"/>
                                    <field name="received_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="withdrawn_by_id" readonly="1"/>
                                    <field name="withdrawn_at" readonly="1"/>
                                </group>
                            </group>
                            <field name="withdrawal_reason" readonly="state != 'received'" required="state == 'received'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_res_config_settings_sedar_purchase_request" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sedar.purchase.request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="SEDAR Purchase Requests">
                    <setting string="Procurement and Inventory Officer" help="Receives the review activity when an internal Purchase Request is submitted.">
                        <field name="sedar_procurement_inventory_officer_id" domain="[['all_group_ids', 'in', %(sedar_marine_inventory.group_marine_inventory_manager)d]]"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="action_sedar_purchase_requests" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">sedar.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sedar_purchase_request_search"/>
    </record>

    <record id="action_sedar_purchase_bids" model="ir.actions.act_window">
        <field name="name">Bidder List</field>
        <field name="res_model">sedar.purchase.bid</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sedar_purchase_bid_search"/>
        <field name="context">{'search_default_active_bids': 1}</field>
        <field name="group_ids" eval="[Command.link(ref('sedar_marine_inventory.group_marine_inventory_manager'))]"/>
    </record>

    <record id="action_sedar_purchase_bid_comparison" model="ir.actions.act_window">
        <field name="name">Bid Comparison</field>
        <field name="res_model">sedar.purchase.bid.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bid_id.state', '=', 'received')]</field>
        <field name="context">{'search_default_group_request': 1, 'search_default_group_request_line': 2}</field>
        <field name="search_view_id" ref="view_sedar_purchase_bid_line_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_sedar_purchase_bid_line_comparison_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_sedar_purchase_bid_line_comparison_form')})]"/>
        <field name="group_ids" eval="[Command.link(ref('sedar_marine_inventory.group_marine_inventory_manager'))]"/>
    </record>

    <record id="view_sedar_generated_purchase_order_list" model="ir.ui.view">
        <field name="name">sedar.generated.purchase.order.list</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders" create="0" sample="0">
                <field name="sedar_purchase_request_id" string="Source Request"/>
                <field name="state"/>
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Vendor"/>
                <field name="date_order"/>
                <field name="user_id" string="Buyer" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_sedar_generated_purchase_orders" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sedar_purchase_request_id', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_sedar_generated_purchase_order_list')})]"/>
        <field name="group_ids" eval="[Command.link(ref('sedar_marine_inventory.group_marine_inventory_manager'))]"/>
    </record>

    <menuitem id="menu_sedar_procurement_root" name="Procurement" parent="sedar_marine_operations.menu_marine_operations" sequence="80" groups="sedar_purchase_request.group_sedar_purchase_request_user,sedar_marine_inventory.group_marine_inventory_user,sedar_marine_maintenance.group_marine_maintenance_user"/>
    <menuitem id="menu_sedar_purchase_requests" name="Purchase Requests" parent="menu_sedar_procurement_root" action="action_sedar_purchase_requests" sequence="10"/>
    <menuitem id="menu_sedar_purchase_bids" name="Bidder List" parent="menu_sedar_procurement_root" action="action_sedar_purchase_bids" sequence="20" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
    <menuitem id="menu_sedar_purchase_bid_comparison" name="Bid Comparison" parent="menu_sedar_procurement_root" action="action_sedar_purchase_bid_comparison" sequence="30" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
    <menuitem id="menu_sedar_generated_purchase_orders" name="Purchase Orders" parent="menu_sedar_procurement_root" action="action_sedar_generated_purchase_orders" sequence="40" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
    <menuitem id="menu_sedar_procurement_inventory" name="Inventory" parent="menu_sedar_procurement_root" sequence="50" groups="sedar_marine_inventory.group_marine_inventory_manager,sedar_marine_maintenance.group_marine_maintenance_manager"/>
    <menuitem id="menu_sedar_procurement_storage" name="Storage" parent="menu_sedar_procurement_inventory" action="sedar_marine_inventory.action_inventory_check" sequence="10" groups="sedar_marine_inventory.group_marine_inventory_manager"/>
    <menuitem id="menu_sedar_procurement_currently_in_use" name="Currently In Use" parent="menu_sedar_procurement_inventory" action="sedar_marine_inventory.action_inventory_currently_in_use" sequence="20" groups="sedar_marine_inventory.group_marine_inventory_manager,sedar_marine_maintenance.group_marine_maintenance_manager"/>

    <!-- This downstream workspace replaces the legacy parallel Marine Inventory tree. -->
