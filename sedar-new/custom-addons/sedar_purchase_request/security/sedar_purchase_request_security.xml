    <record id="group_sedar_purchase_request_manager" model="res.groups">
        <field name="name">Purchase Request Manager</field>
        <field name="privilege_id" ref="sedar_marine_operations.privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('group_sedar_purchase_request_user')), Command.link(ref('purchase.group_purchase_manager'))]"/>
    </record>
</odoo>
