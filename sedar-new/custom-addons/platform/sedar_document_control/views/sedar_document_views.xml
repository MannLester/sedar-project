    <record id="view_sedar_document_type_list" model="ir.ui.view"><field name="name">sedar.document.type.list</field><field name="model">sedar.document.type</field><field name="arch" type="xml"><list string="Document Catalogue"><field name="code"/><field name="name"/><field name="department"/><field name="revision"/><field name="effective_date"/><field name="approval_status"/></list></field></record>
    <record id="view_sedar_document_type_form" model="ir.ui.view"><field name="name">sedar.document.type.form</field><field name="model">sedar.document.type</field><field name="arch" type="xml"><form string="Document Catalogue Entry"><sheet><group><group><field name="code"/><field name="name"/><field name="department"/><field name="approval_status"/></group><group><field name="revision"/><field name="effective_date"/><field name="issue_number"/><field name="source_filename"/></group></group><notebook><page string="Field Definition"><field name="field_definition"/></page><page string="Typed Fields"><field name="field_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="technical_name"/><field name="field_type"/><field name="required"/></list></field></page><page string="Source Documents"><field name="document_ids"><list><field name="name"/><field name="filename"/><field name="state"/></list></field></page></notebook></sheet></form></field></record>
