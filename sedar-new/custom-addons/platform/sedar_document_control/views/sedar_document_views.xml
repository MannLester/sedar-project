    <menuitem id="menu_sedar_documents" name="Controlled Documents" parent="menu_sedar_document_control" action="action_sedar_documents" sequence="20"/>
    <menuitem id="menu_sedar_document_fields" name="Typed Template Fields" parent="menu_sedar_document_control" action="action_sedar_document_fields" sequence="30"/>
    <menuitem id="menu_sedar_document_requests" name="Employee Document Requests" parent="menu_sedar_document_control" action="action_sedar_document_requests" sequence="40"/>
</odoo>
