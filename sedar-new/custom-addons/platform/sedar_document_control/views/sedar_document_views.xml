"field_type != 'signature'"/><field name="comment"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet></form></field></record>
    <record id="action_sedar_document_types" model="ir.actions.act_window"><field name="name">Document Catalogue</field><field name="res_model">sedar.document.type</field><field name="view_mode">list,form</field></record>
    <record id="action_sedar_documents" model="ir.actions.act_window"><field name="name">Controlled Documents</field><field name="res_model">sedar.document</field><field name="view_mode">list,form</field></record>
    <record id="action_sedar_document_fields" model="ir.actions.act_window"><field name="name">Typed Template Fields</field><field name="res_model">sedar.document.field</field><field name="view_mode">list,form</field></record>
    <record id="action_sedar_document_requests" model="ir.actions.act_window"><field name="name">Employee Document Requests</field><field name="res_model">sedar.document.request</field><field name="view_mode">list,form</field></record>
