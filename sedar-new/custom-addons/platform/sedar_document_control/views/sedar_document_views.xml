    <record id="view_sedar_document_request_list" model="ir.ui.view"><field name="name">sedar.document.request.list</field><field name="model">sedar.document.request</field><field name="arch" type="xml"><list string="Employee Document Requests"><field name="name"/><field name="document_type_id"/><field name="subject_name"/><field name="assigned_user_id"/><field name="state"/><field name="completion_percent" widget="percentage"/><field name="due_date"/></list></field></record>
