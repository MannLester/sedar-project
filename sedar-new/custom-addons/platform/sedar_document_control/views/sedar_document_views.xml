    <record id="view_sedar_document_form" model="ir.ui.view"><field name="name">sedar.document.form</field><field name="model">sedar.document</field><field name="arch" type="xml"><form string="Controlled Document"><sheet><group><field name="name"/><field name="document_type_id"/><field name="state"/><field name="filename"/><field name="file" filename="filename"/></group><field name="notes"/></sheet></form></field></record>
    <record id="view_sedar_document_field_list" model="ir.ui.view"><field name="name">sedar.document.field.list</field><field name="model">sedar.document.field</field><field name="arch" type="xml"><list string="Typed Template Fields"><field name="sequence"/><field name="name"/><field name="technical_name"/><field name="document_type_id"/><field name="field_type"/><field name="required"/></list></field></record>
