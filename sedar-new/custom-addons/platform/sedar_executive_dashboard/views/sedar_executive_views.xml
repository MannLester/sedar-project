<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sedar_corporate_record_list" model="ir.ui.view">
        <field name="name">sedar.corporate.record.list</field><field name="model">sedar.corporate.record</field>
        <field name="arch" type="xml"><list string="Corporate Governance Register"><field name="reference"/><field name="name"/><field name="record_type"/><field name="owner_id"/><field name="valid_until"/><field name="compliance_status"/><field name="approval_state"/><field name="confidential"/></list></field>
    </record>
    <record id="view_sedar_corporate_record_form" model="ir.ui.view">
        <field name="name">sedar.corporate.record.form</field><field name="model">sedar.corporate.record</field>
        <field name="arch" type="xml"><form string="Corporate Governance Record"><sheet><group><group><field name="reference"/><field name="name"/><field name="record_type"/><field name="document_id"/></group><group><field name="owner_id"/><field name="state"/><field name="approval_state"/><field name="confidential"/></group></group><group><group><field name="partner_id"/><field name="tugboat_id"/></group><group><field name="valid_from"/><field name="valid_until"/><field name="renewal_date"/><field name="compliance_status"/><field name="days_to_expiry"/></group></group><notebook><page string="Description"><field name="description"/><field name="next_action"/></page></notebook></sheet></form></field>
    </record>
    <record id="view_sedar_document_form_executive" model="ir.ui.view">
        <field name="name">sedar.document.form.executive.metadata</field><field name="model">sedar.document</field>
        <field name="inherit_id" ref="sedar_document_control.view_sedar_document_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet/group" position="after"><group string="Governance Metadata"><field name="document_category"/><field name="owner_id"/><field name="approval_state"/><field name="confidential"/><field name="valid_from"/><field name="valid_until"/><field name="renewal_date"/><field name="governance_status"/><field name="partner_id"/><field name="tugboat_id"/></group></xpath></field>
    </record>
    <record id="view_sedar_executive_dashboard_form" model="ir.ui.view">
        <field name="name">sedar.executive.dashboard.form</field>
        <field name="model">sedar.executive.dashboard</field>
        <field name="arch" type="xml">
            <form string="Executive Company Dashboard" create="0" edit="0">
                <sheet class="sedar_executive_dashboard">
                    <field name="currency_id" invisible="1"/>
                    <field name="dashboard_perspective" invisible="1"/>
                    <div class="sedar_executive_header">
                        <div>
                            <span class="sedar_eyebrow">EXECUTIVE CONTROL ROOM</span>
                            <h1><field name="name"/></h1>
                            <p>Vessels, people, cash, and customers in one decision-focused view.</p>
                        </div>
                        <div class="sedar_as_of">
                            <span>As of</span>
                            <strong><field name="reporting_date"/></strong>
                            <small>Refreshed <field name="last_refreshed"/></small>
                        </div>
                    </div>
                    <div class="sedar_preset_bar">
                        <div>
                            <span class="sedar_eyebrow">DASHBOARD VIEW</span>
                            <strong><field name="perspective_title"/></strong>
                            <small><field name="perspective_summary"/></small>
                        </div>
                        <nav class="sedar_preset_switcher" aria-label="Executive dashboard views">
                            <span class="sedar_preset_active" invisible="dashboard_perspective != 'owner'">Owner Overview</span>
                            <button name="action_set_dashboard_perspective" type="object" class="sedar_preset_button" context="{'dashboard_perspective': 'owner'}" invisible="dashboard_perspective == 'owner'">Owner Overview</button>
                            <span class="sedar_preset_active" invisible="dashboard_perspective != 'operations'">Operations</span>
                            <button name="action_set_dashboard_perspective" type="object" class="sedar_preset_button" context="{'dashboard_perspective': 'operations'}" invisible="dashboard_perspective == 'operations'">Operations</button>
                            <span class="sedar_preset_active" invisible="dashboard_perspective != 'finance'">Finance</span>
                            <button name="action_set_dashboard_perspective" type="object" class="sedar_preset_button" context="{'dashboard_perspective': 'finance'}" invisible="dashboard_perspective == 'finance'">Finance</button>
                            <span class="sedar_preset_active" invisible="dashboard_perspective != 'people'">Crewing &amp; Safety</span>
                            <button name="action_set_dashboard_perspective" type="object" class="sedar_preset_button" context="{'dashboard_perspective': 'people'}" invisible="dashboard_perspective == 'people'">Crewing &amp; Safety</button>
                        </nav>
                    </div>
                    <div class="sedar_attention_banner">
                        <div>
                            <span class="sedar_attention_count"><field name="visible_attention_count"/></span>
                            <div>
                                <strong>Items require management attention</strong>
                                <span>Open a queue below to see the source record, owner, and next action.</span>
                            </div>
                        </div>
                        <button name="action_open_flagship_service" type="object" class="btn btn-primary" invisible="dashboard_perspective not in ['owner', 'finance']">
                            Open completed service-to-payment walkthrough
                        </button>
                    </div>
                    <h2>Attention required today</h2>
                    <div class="sedar_action_grid">
                        <button name="action_open_overdue_receivables" type="object" class="sedar_action_card sedar_tone_danger" invisible="dashboard_perspective not in ['owner', 'finance']">
                            <span>Overdue receivables</span>
                            <strong><field name="overdue_receivable_count"/></strong>
                            <small><field name="overdue_receivable_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></small>
                        </button>
                        <button name="action_open_billing_reviews" type="object" class="sedar_action_card sedar_tone_warning" invisible="dashboard_perspective not in ['owner', 'finance']">
                            <span>Billing decisions</span>
                            <strong><field name="billing_review_count"/></strong>
                            <small>Reviews and pricing exceptions</small>
                        </button>
                        <button name="action_open_blocked_service_orders" type="object" class="sedar_action_card sedar_tone_danger" invisible="dashboard_perspective not in ['owner', 'operations']">
                            <span>Blocked Service Orders</span>
                            <strong><field name="blocked_service_order_count"/></strong>
                            <small>Operations cannot proceed</small>
                        </button>
                        <button name="action_open_maintenance_blockers" type="object" class="sedar_action_card sedar_tone_danger" invisible="dashboard_perspective not in ['owner', 'operations']">
                            <span>Maintenance holds</span>
                            <strong><field name="maintenance_blocker_count"/></strong>
                            <small>Tug readiness affected</small>
                        </button>
                        <button name="action_open_credential_expiries" type="object" class="sedar_action_card sedar_tone_warning" invisible="dashboard_perspective not in ['owner', 'people']">
                            <span>Crew credential risks</span>
                            <strong><field name="credential_expiry_count"/></strong>
                            <small>Expired or due in 30 days</small>
                        </button>
                        <button name="action_open_inventory" type="object" class="sedar_action_card sedar_tone_warning" invisible="dashboard_perspective not in ['owner', 'operations']">
                            <span>Inventory shortages</span>
                            <strong><field name="inventory_shortage_count"/></strong>
                            <small>Readiness requirements not met</small>
                        </button>
                        <button name="action_open_overdue_hsse_actions" type="object" class="sedar_action_card sedar_tone_danger" invisible="dashboard_perspective not in ['owner', 'people']">
                            <span>Overdue HSSE actions</span>
                            <strong><field name="hsse_overdue_action_count"/></strong>
                            <small>Corrective action is late</small>
                        </button>
                        <button name="action_open_expiring_documents" type="object" class="sedar_action_card sedar_tone_warning" invisible="dashboard_perspective not in ['owner', 'operations']">
                            <span>Document renewals</span>
                            <strong><field name="document_expiry_count"/></strong>
                            <small>Expired or due in 30 days</small>
                        </button>
                    </div>
                    <div class="sedar_pillar_grid">
                        <section class="sedar_pillar" invisible="dashboard_perspective not in ['owner', 'operations']">
                            <header><span>01</span><div><h2>Vessels</h2><p>Can the fleet safely perform today's work?</p></div></header>
                            <div class="sedar_metric_row">
                                <button name="action_open_tugs" type="object"><strong><field name="available_tug_count"/></strong><span>Available</span></button>
                                <button name="action_open_tugs" type="object"><strong><field name="fleet_count"/></strong><span>Total fleet</span></button>
                                <button name="action_open_maintenance" type="object"><strong><field name="maintenance_open_count"/></strong><span>Open work orders</span></button>
                                <button name="action_open_governance" type="object"><strong><field name="governance_exception_count"/></strong><span>Governance risks</span></button>
                            </div>
                            <div class="sedar_policy_note"><field name="utilization_note"/></div>
                        </section>
                        <section class="sedar_pillar" invisible="dashboard_perspective not in ['owner', 'people']">
                            <header><span>02</span><div><h2>People</h2><p>Do we have qualified crew where they are needed?</p></div></header>
                            <div class="sedar_metric_row">
                                <button name="action_open_crew" type="object"><strong><field name="available_crew_count"/></strong><span>Available crew</span></button>
                                <button name="action_open_crew" type="object"><strong><field name="crew_count"/></strong><span>Crew profiles</span></button>
                                <button name="action_open_crew" type="object"><strong><field name="open_shortage_count"/></strong><span>Open shortages</span></button>
                                <button name="action_open_crew" type="object"><strong><field name="vacancy_count"/></strong><span>Vacancies</span></button>
                            </div>
                        </section>
                        <section class="sedar_pillar" invisible="dashboard_perspective not in ['owner', 'finance']">
                            <header><span>03</span><div><h2>Cash</h2><p>What has been earned, collected, and is falling due?</p></div></header>
                            <div class="sedar_metric_row">
                                <button name="action_open_invoices" type="object"><strong><field name="current_month_revenue" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong><span>Revenue this month</span></button>
                                <button name="action_open_invoices" type="object"><strong><field name="cash_collected_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong><span>Collected, all demo data</span></button>
                                <button name="action_open_overdue_receivables" type="object"><strong><field name="overdue_receivable_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong><span>Overdue receivables</span></button>
                                <button name="action_open_upcoming_payables" type="object"><strong><field name="payable_30_day_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong><span>Payables due in 30 days</span></button>
                            </div>
                            <div class="sedar_policy_note"><field name="profitability_note"/></div>
                        </section>
                        <section class="sedar_pillar" invisible="dashboard_perspective not in ['owner', 'operations', 'finance']">
                            <header><span>04</span><div><h2>Customers and Service</h2><p>Are commitments being completed and billed?</p></div></header>
                            <div class="sedar_metric_row">
                                <button name="action_open_service_orders" type="object"><strong><field name="active_service_order_count"/></strong><span>Active Service Orders</span></button>
                                <button name="action_open_service_orders" type="object"><strong><field name="completed_service_order_count"/></strong><span>Completed</span></button>
                                <button name="action_open_blocked_service_orders" type="object"><strong><field name="blocked_service_order_count"/></strong><span>Blocked</span></button>
                                <button name="action_open_service_orders" type="object"><strong><field name="cancelled_service_order_count"/></strong><span>Cancelled</span></button>
                            </div>
                        </section>
                    </div>
                    <div class="sedar_secondary_links">
                        <button name="action_open_procurement" type="object" class="btn btn-secondary" invisible="dashboard_perspective not in ['owner', 'operations']">Procurement queue</button>
                        <button name="action_open_hsse" type="object" class="btn btn-secondary" invisible="dashboard_perspective not in ['owner', 'people']">Open HSSE records</button>
                        <button name="action_open_documents" type="object" class="btn btn-secondary" invisible="dashboard_perspective not in ['owner', 'operations']">Controlled documents</button>
                        <button name="action_open_service_orders" type="object" class="btn btn-secondary" invisible="dashboard_perspective not in ['owner', 'operations', 'finance']">All Service Orders</button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sedar_corporate_records" model="ir.actions.act_window"><field name="name">Corporate Governance Register</field><field name="res_model">sedar.corporate.record</field><field name="view_mode">list,form</field></record>
    <record id="action_sedar_executive_dashboard" model="ir.actions.act_window"><field name="name">Executive Company Dashboard</field><field name="res_model">sedar.executive.dashboard</field><field name="view_mode">form</field><field name="res_id" ref="sedar_executive_dashboard.executive_dashboard_demo"/></record>
    <menuitem id="menu_sedar_executive_root" name="Executive Management" sequence="90" groups="sedar_executive_dashboard.group_sedar_executive"/>
    <menuitem id="menu_sedar_executive_dashboard" name="Company Dashboard" parent="menu_sedar_executive_root" action="action_sedar_executive_dashboard" sequence="10"/>
    <menuitem id="menu_sedar_corporate_records" name="Corporate Governance Register" parent="menu_sedar_executive_root" action="action_sedar_corporate_records" sequence="20"/>
</odoo>
