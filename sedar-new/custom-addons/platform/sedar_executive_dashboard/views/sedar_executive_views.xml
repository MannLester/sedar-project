<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sedar_corporate_record_list" model="ir.ui.view">
        <field name="name">sedar.corporate.record.list</field><field name="model">sedar.corporate.record</field>
        <field name="arch" type="xml"><list string="Corporate Governance Register"><field name="reference"/><field name="name"/><field name="record_type"/><field name="owner_id"/><field name="valid_until"/><field name="compliance_status"/><field name="approval_state"/><field name="confidential"/></list></field>
    </record>
    <record id="view_sedar_corporate_record_form" model="ir.ui.view">
        <field name="name">sedar.corporate.record.form</field><field name="model">sedar.corporate.record</field>
        <field name="arch" type="xml"><form string="Corporate Governance Record"><sheet><group><group><field name="reference"/><field name="name"/><field name="record_type"/><field name="document_id"/></group><group><field name="owner_id"/><field name="state"/><field name="approval_state"/><field name="confidential"/></group></group><group><group><field name="partner_id"/><field name="tugboat_id"/></group><group><field name="valid_from"/><field name="valid_until"/><field name="renewal_date"/><field name="compliance_status"/><field name="days_to_expiry"/></group></group><notebook><page string="Description"><field name="description"/><field name="next_action"/></page></notebook></sheet></form></field>
    </record>
    <record id="view_sedar_document_form_executive" model="ir.ui.view">
        <field name="name">sedar.document.form.executive.metadata</field><field name="model">sedar.document</field>
        <field name="inherit_id" ref="sedar_document_control.view_sedar_document_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet/group" position="after"><group string="Governance Metadata"><field name="document_category"/><field name="owner_id"/><field name="approval_state"/><field name="confidential"/><field name="valid_from"/><field name="valid_until"/><field name="renewal_date"/><field name="governance_status"/><field name="partner_id"/><field name="tugboat_id"/></group></xpath></field>
    </record>
    <record id="view_sedar_executive_dashboard_form" model="ir.ui.view">
        <field name="name">sedar.executive.dashboard.form</field><field name="model">sedar.executive.dashboard</field>
        <field name="arch" type="xml"><form string="Executive Management Dashboard" create="0" edit="0"><sheet><div class="oe_title"><h1><field name="name"/></h1><p>Source-backed demonstration dashboard. Values refresh from governed Odoo records when opened.</p></div><group><field name="last_refreshed"/><field name="company_id"/><field name="currency_id"/></group><separator string="Finance"/><div class="oe_button_box"><button name="action_open_invoices" type="object" class="oe_stat_button"><field name="revenue_total" widget="statinfo" string="Revenue"/></button><button name="action_open_invoices" type="object" class="oe_stat_button"><field name="unpaid_total" widget="statinfo" string="Unpaid"/></button><button name="action_open_invoices" type="object" class="oe_stat_button"><field name="cash_collected_total" widget="statinfo" string="Collected"/></button><button name="action_open_invoices" type="object" class="oe_stat_button"><field name="known_cost_total" widget="statinfo" string="Known Cost"/></button></div><group><field name="revenue_total"/><field name="invoiced_total"/><field name="unpaid_total"/><field name="cash_collected_total"/><field name="known_cost_total"/></group><separator string="Marine Operations"/><div class="oe_button_box"><button name="action_open_service_orders" type="object" class="oe_stat_button"><field name="service_order_count" widget="statinfo" string="Service Orders"/></button><button name="action_open_service_orders" type="object" class="oe_stat_button"><field name="active_service_order_count" widget="statinfo" string="Active Orders"/></button><button name="action_open_service_orders" type="object" class="oe_stat_button"><field name="completed_service_order_count" widget="statinfo" string="Completed"/></button><button name="action_open_tugs" type="object" class="oe_stat_button"><field name="fleet_count" widget="statinfo" string="Fleet"/></button><button name="action_open_tugs" type="object" class="oe_stat_button"><field name="utilization_percent" widget="statinfo" string="Utilization %"/></button></div><group><field name="service_order_count"/><field name="active_service_order_count"/><field name="completed_service_order_count"/><field name="marine_operation_count"/><field name="fleet_count"/><field name="available_tug_count"/><field name="tug_blocker_count"/><field name="utilization_percent"/></group><separator string="People and Fleet Readiness"/><div class="oe_button_box"><button name="action_open_crew" type="object" class="oe_stat_button"><field name="crew_count" widget="statinfo" string="Crew"/></button><button name="action_open_crew" type="object" class="oe_stat_button"><field name="credential_expiry_count" widget="statinfo" string="Credential Expiry"/></button><button name="action_open_maintenance" type="object" class="oe_stat_button"><field name="maintenance_blocker_count" widget="statinfo" string="Maintenance Holds"/></button></div><group><field name="crew_count"/><field name="available_crew_count"/><field name="vacancy_count"/><field name="applicant_count"/><field name="open_shortage_count"/><field name="credential_expiry_count"/><field name="maintenance_open_count"/><field name="maintenance_blocker_count"/><field name="drydock_active_count"/></group><separator string="Supply, HSSE, and Governance"/><div class="oe_button_box"><button name="action_open_inventory" type="object" class="oe_stat_button"><field name="inventory_shortage_count" widget="statinfo" string="Stock Shortages"/></button><button name="action_open_procurement" type="object" class="oe_stat_button"><field name="purchase_overdue_count" widget="statinfo" string="Overdue Purchases"/></button><button name="action_open_hsse" type="object" class="oe_stat_button"><field name="hsse_incident_count" widget="statinfo" string="Open Incidents"/></button><button name="action_open_documents" type="object" class="oe_stat_button"><field name="document_expiry_count" widget="statinfo" string="Document Expiry"/></button><button name="action_open_governance" type="object" class="oe_stat_button"><field name="governance_exception_count" widget="statinfo" string="Governance Exceptions"/></button></div><group><field name="inventory_shortage_count"/><field name="fuel_consumed_qty"/><field name="purchase_open_count"/><field name="purchase_overdue_count"/><field name="hsse_incident_count"/><field name="hsse_high_risk_count"/><field name="hsse_permit_exception_count"/><field name="hsse_overdue_action_count"/><field name="document_expiry_count"/><field name="governance_exception_count"/></group></sheet></form></field>
    </record>
    <record id="action_sedar_corporate_records" model="ir.actions.act_window"><field name="name">Corporate Governance Register</field><field name="res_model">sedar.corporate.record</field><field name="view_mode">list,form</field></record>
    <record id="action_sedar_executive_dashboard" model="ir.actions.act_window"><field name="name">Executive Management Dashboard</field><field name="res_model">sedar.executive.dashboard</field><field name="view_mode">form</field><field name="res_id" ref="sedar_executive_dashboard.executive_dashboard_demo"/></record>
    <menuitem id="menu_sedar_executive_root" name="Executive Management" sequence="90" groups="sedar_executive_dashboard.group_sedar_executive"/>
    <menuitem id="menu_sedar_executive_dashboard" name="Executive Dashboard" parent="menu_sedar_executive_root" action="action_sedar_executive_dashboard" sequence="10"/>
    <menuitem id="menu_sedar_corporate_records" name="Corporate Governance Register" parent="menu_sedar_executive_root" action="action_sedar_corporate_records" sequence="20"/>
</odoo>

