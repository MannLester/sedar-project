<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sedar_finance" model="ir.module.category">
        <field name="name">SEDAR Marine Finance</field>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_sedar_marine_finance" model="res.groups.privilege">
        <field name="name">Marine Finance</field>
        <field name="category_id" ref="module_category_sedar_finance"/>
        <field name="sequence">30</field>
    </record>
    <record id="group_billing_officer" model="res.groups">
        <field name="name">Billing Officer</field>
        <field name="privilege_id" ref="privilege_sedar_marine_finance"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('account.group_account_invoice')), Command.link(ref('sedar_marine_operations.group_completion_reviewer'))]"/>
    </record>
    <record id="group_accounting_manager" model="res.groups">
        <field name="name">Accounting Manager</field>
        <field name="privilege_id" ref="privilege_sedar_marine_finance"/>
        <field name="implied_ids" eval="[Command.link(ref('group_billing_officer')), Command.link(ref('account.group_account_manager'))]"/>
    </record>
</odoo>
