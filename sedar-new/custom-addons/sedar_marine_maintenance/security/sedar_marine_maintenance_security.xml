<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_marine_maintenance_user" model="res.groups">
        <field name="name">Marine Maintenance User</field>
        <field name="privilege_id" ref="sedar_marine_operations.privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_marine_maintenance_manager" model="res.groups">
        <field name="name">Marine Maintenance Manager</field>
        <field name="privilege_id" ref="sedar_marine_operations.privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('group_marine_maintenance_user')), Command.link(ref('maintenance.group_equipment_manager'))]"/>
    </record>

    <record id="rule_marine_maintenance_user_requests" model="ir.rule">
        <field name="name">Marine Maintenance users access marine work orders</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="domain_force">[('sedar_tugboat_id', '!=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_marine_maintenance_user'))]"/>
    </record>

    <record id="rule_marine_maintenance_user_equipment" model="ir.rule">
        <field name="name">Marine Maintenance users access marine equipment</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[('sedar_tugboat_id', '!=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_marine_maintenance_user'))]"/>
    </record>

    <record id="rule_running_hour_reading_company" model="ir.rule">
        <field name="name">Running hour readings follow allowed companies</field>
        <field name="model_id" ref="model_sedar_equipment_running_hour_reading"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_marine_maintenance_user'))]"/>
    </record>
</odoo>
