<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crew_assignment_search_scheduling" model="ir.ui.view">
        <field name="name">sedar.crew.assignment.search.scheduling</field>
        <field name="model">sedar.crew.assignment</field>
        <field name="arch" type="xml">
            <search string="Crew Schedule">
                <field name="order_id"/>
                <field name="crew_profile_id"/>
                <field name="rank_id"/>
                <field name="planned_start"/>
                <filter name="blocked" string="Blocked" domain="[('scheduling_status', '=', 'blocked')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <separator/>
                <filter name="group_crew" string="Group by Crew" context="{'group_by': 'crew_profile_id'}"/>
                <filter name="group_rank" string="Group by Rank" context="{'group_by': 'rank_id'}"/>
                <filter name="group_status" string="Group by Scheduling Status" context="{'group_by': 'scheduling_status'}"/>
            </search>
        </field>
    </record>

    <record id="view_crew_assignment_list_scheduling" model="ir.ui.view">
        <field name="name">sedar.crew.assignment.list.scheduling</field>
        <field name="model">sedar.crew.assignment</field>
        <field name="arch" type="xml">
            <list string="Crew Schedule" decoration-danger="scheduling_status == 'blocked'" decoration-muted="state == 'rejected'">
                <field name="order_id"/>
                <field name="crew_profile_id"/>
                <field name="employee_id"/>
                <field name="rank_id"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
                <field name="state"/>
                <field name="scheduling_status"/>
                <field name="eligibility_reason"/>
            </list>
        </field>
    </record>

    <record id="view_crew_assignment_calendar_scheduling" model="ir.ui.view">
        <field name="name">sedar.crew.assignment.calendar.scheduling</field>
        <field name="model">sedar.crew.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Crew Schedule" date_start="planned_start" date_stop="planned_end" color="crew_profile_id" mode="week">
                <field name="order_id"/>
                <field name="crew_profile_id"/>
                <field name="rank_id"/>
                <field name="scheduling_status"/>
            </calendar>
        </field>
    </record>

    <record id="view_crew_assignment_form_scheduling" model="ir.ui.view">
        <field name="name">sedar.crew.assignment.form.scheduling</field>
        <field name="model">sedar.crew.assignment</field>
        <field name="arch" type="xml">
            <form string="Crew Assignment">
                <header>
                    <button name="action_confirm_assignment" type="object" string="Confirm Assignment" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_reject_assignment" type="object" string="Reject Assignment" invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="requirement_id"/>
                            <field name="order_id" readonly="1"/>
                            <field name="crew_profile_id"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="rank_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="planned_start" readonly="1"/>
                            <field name="planned_end" readonly="1"/>
                            <field name="is_eligible" readonly="1"/>
                            <field name="scheduling_status" readonly="1"/>
                            <field name="eligibility_reason" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Suggested Replacements">
                            <field name="replacement_candidate_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_manning_requirement_form_scheduling" model="ir.ui.view">
        <field name="name">sedar.manning.requirement.form.scheduling</field>
        <field name="model">sedar.manning.requirement</field>
        <field name="inherit_id" ref="sedar_marine_operations.view_manning_requirement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='crew_assignment_ids']/list/field[@name='eligibility_reason']" position="after">
                <field name="scheduling_status"/>
            </xpath>
        </field>
    </record>

    <record id="view_crew_rotation_search" model="ir.ui.view">
        <field name="name">sedar.crew.rotation.search</field>
        <field name="model">sedar.crew.rotation</field>
        <field name="arch" type="xml">
            <search string="Crew Rotations">
                <field name="crew_profile_id"/>
                <field name="tugboat_id"/>
                <field name="date_start"/>
                <filter name="planned_active" string="Planned / Active" domain="[('state', 'in', ['planned', 'active'])]"/>
                <separator/>
                <filter name="group_tugboat" string="Group by Tugboat" context="{'group_by': 'tugboat_id'}"/>
                <filter name="group_crew" string="Group by Crew" context="{'group_by': 'crew_profile_id'}"/>
                <filter name="group_state" string="Group by State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_crew_rotation_list" model="ir.ui.view">
        <field name="name">sedar.crew.rotation.list</field>
        <field name="model">sedar.crew.rotation</field>
        <field name="arch" type="xml">
            <list string="Crew Rotations" decoration-success="state == 'active'" decoration-muted="state in ['completed', 'cancelled']">
                <field name="crew_profile_id"/>
                <field name="employee_id"/>
                <field name="rank_id"/>
                <field name="tugboat_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="watch"/>
                <field name="relief_crew_profile_id"/>
                <field name="handover_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_crew_rotation_calendar" model="ir.ui.view">
        <field name="name">sedar.crew.rotation.calendar</field>
        <field name="model">sedar.crew.rotation</field>
        <field name="arch" type="xml">
            <calendar string="Crew Rotations" date_start="date_start" date_stop="date_end" color="tugboat_id" mode="month">
                <field name="crew_profile_id"/>
                <field name="tugboat_id"/>
                <field name="watch"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_crew_rotation_form" model="ir.ui.view">
        <field name="name">sedar.crew.rotation.form</field>
        <field name="model">sedar.crew.rotation</field>
        <field name="arch" type="xml">
            <form string="Crew Rotation">
                <header>
                    <button name="action_plan" type="object" string="Plan" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="crew_profile_id"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="rank_id" readonly="1"/>
                            <field name="tugboat_id"/>
                            <field name="watch"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="relief_crew_profile_id"/>
                            <field name="handover_date"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crew_schedule" model="ir.actions.act_window">
        <field name="name">Crew Schedule</field>
        <field name="res_model">sedar.crew.assignment</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_crew_assignment_search_scheduling"/>
    </record>

    <record id="action_crew_rotations" model="ir.actions.act_window">
        <field name="name">Crew Rotations</field>
        <field name="res_model">sedar.crew.rotation</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_crew_rotation_search"/>
    </record>

    <menuitem id="menu_crew_schedule" name="Crew Schedule" parent="sedar_marine_operations.menu_marine_operations" action="action_crew_schedule" sequence="62"/>
    <menuitem id="menu_crew_rotations" name="Crew Rotations" parent="sedar_marine_operations.menu_marine_operations" action="action_crew_rotations" sequence="64"/>
</odoo>
