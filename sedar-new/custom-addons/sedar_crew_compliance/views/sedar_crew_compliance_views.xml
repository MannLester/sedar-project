<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crew_certificate_search_compliance" model="ir.ui.view">
        <field name="name">sedar.crew.certificate.search.compliance</field>
        <field name="model">sedar.crew.certificate</field>
        <field name="arch" type="xml">
            <search string="Crew Credentials">
                <field name="crew_profile_id"/>
                <field name="certificate_type_id"/>
                <field name="certificate_number"/>
                <filter name="medical" string="Medical" domain="[('sedar_is_medical', '=', True)]"/>
                <filter name="renewal_due" string="Renewal Due" domain="[('sedar_expiry_state', '=', 'renewal_due')]"/>
                <filter name="expired" string="Expired" domain="[('sedar_expiry_state', '=', 'expired')]"/>
                <filter name="not_verified" string="Not Verified" domain="[('sedar_verification_state', '!=', 'verified')]"/>
                <separator/>
                <filter name="group_crew" string="Group by Crew" context="{'group_by': 'crew_profile_id'}"/>
                <filter name="group_type" string="Group by Type" context="{'group_by': 'certificate_type_id'}"/>
                <filter name="group_status" string="Group by Evidence Status" context="{'group_by': 'sedar_verification_state'}"/>
            </search>
        </field>
    </record>

    <record id="view_crew_certificate_list_compliance" model="ir.ui.view">
        <field name="name">sedar.crew.certificate.list.compliance</field>
        <field name="model">sedar.crew.certificate</field>
        <field name="arch" type="xml">
            <list string="Crew Credentials" decoration-danger="sedar_expiry_state == 'expired' or sedar_verification_state == 'rejected'" decoration-warning="sedar_expiry_state == 'renewal_due' or sedar_verification_state in ['requested', 'submitted']">
                <field name="crew_profile_id"/>
                <field name="certificate_type_id"/>
                <field name="certificate_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="sedar_expiry_state"/>
                <field name="sedar_verification_state"/>
                <field name="sedar_document_request_id"/>
            </list>
        </field>
    </record>

    <record id="view_crew_certificate_form_compliance" model="ir.ui.view">
        <field name="name">sedar.crew.certificate.form.compliance</field>
        <field name="model">sedar.crew.certificate</field>
        <field name="arch" type="xml">
            <form string="Crew Credential">
                <header>
                    <button name="action_sedar_request_renewal" type="object" string="Request Renewal" class="btn-primary" groups="sedar_crew_compliance.group_crew_compliance_manager" invisible="sedar_verification_state in ['requested', 'submitted']"/>
                    <button name="action_sedar_sync_from_document" type="object" string="Sync Evidence" groups="sedar_crew_compliance.group_crew_compliance_manager" invisible="not sedar_document_request_id"/>
                    <button name="action_sedar_verify" type="object" string="Verify" class="btn-primary" groups="sedar_crew_compliance.group_crew_compliance_manager" invisible="not sedar_document_request_id or sedar_verification_state == 'verified'"/>
                    <button name="action_sedar_reject" type="object" string="Reject Evidence" groups="sedar_crew_compliance.group_crew_compliance_manager" invisible="sedar_verification_state == 'rejected'"/>
                    <field name="sedar_verification_state" widget="statusbar" statusbar_visible="verified,requested,submitted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="crew_profile_id"/>
                            <field name="certificate_type_id"/>
                            <field name="certificate_number"/>
                            <field name="sedar_is_medical" readonly="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="status"/>
                            <field name="sedar_expiry_state"/>
                            <field name="sedar_renewal_due_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evidence">
                            <group>
                                <group>
                                    <field name="sedar_document_request_id" readonly="1"/>
                                    <button name="action_sedar_open_document_request" type="object" string="Open Evidence Request" invisible="not sedar_document_request_id"/>
                                </group>
                                <group>
                                    <field name="sedar_verified_by_id" readonly="1"/>
                                    <field name="sedar_verified_at" readonly="1"/>
                                    <field name="sedar_renewal_requested_by_id" readonly="1"/>
                                    <field name="sedar_renewal_requested_at" readonly="1"/>
                                </group>
                            </group>
                            <field name="sedar_reviewer_note"/>
                        </page>
                        <page string="Legacy Attachment">
                            <group>
                                <field name="attachment_filename" invisible="1"/>
                                <field name="attachment" filename="attachment_filename"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crew_profile_form_compliance" model="ir.ui.view">
        <field name="name">sedar.crew.profile.form.compliance</field>
        <field name="model">sedar.crew.profile</field>
        <field name="inherit_id" ref="sedar_marine_operations.view_crew_profile_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='certificate_ids']/list/field[@name='status']" position="after">
                <field name="sedar_expiry_state"/>
                <field name="sedar_verification_state"/>
                <field name="sedar_document_request_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_crew_credentials" model="ir.actions.act_window">
        <field name="name">Crew Credentials and Medicals</field>
        <field name="res_model">sedar.crew.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crew_certificate_search_compliance"/>
    </record>

    <menuitem id="menu_crew_credentials" name="Crew Credentials and Medicals" parent="sedar_marine_operations.menu_marine_operations" action="action_crew_credentials" sequence="55"/>
</odoo>
