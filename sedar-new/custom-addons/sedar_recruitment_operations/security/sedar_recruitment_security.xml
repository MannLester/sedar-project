<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sedar_interview_assigned_recruitment_user" model="ir.rule">
        <field name="name">SEDAR interviews: assigned recruitment users</field>
        <field name="model_id" ref="model_sedar_applicant_interview"/>
        <field name="groups" eval="[Command.link(ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        <field name="domain_force">['|', '|', ('coordinator_id', '=', user.id), ('interviewer_ids', 'in', [user.id]), ('applicant_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_sedar_interview_recruitment_manager_all" model="ir.rule">
        <field name="name">SEDAR interviews: recruitment managers all</field>
        <field name="model_id" ref="model_sedar_applicant_interview"/>
        <field name="groups" eval="[Command.link(ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_sedar_offer_assigned_recruitment_user" model="ir.rule">
        <field name="name">SEDAR offers: assigned recruitment users</field>
        <field name="model_id" ref="model_sedar_applicant_offer"/>
        <field name="groups" eval="[Command.link(ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        <field name="domain_force">[('applicant_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_sedar_offer_recruitment_manager_all" model="ir.rule">
        <field name="name">SEDAR offers: recruitment managers all</field>
        <field name="model_id" ref="model_sedar_applicant_offer"/>
        <field name="groups" eval="[Command.link(ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_sedar_recruitment_document_request_assigned" model="ir.rule">
        <field name="name">SEDAR recruitment document requests: assigned users only</field>
        <field name="model_id" ref="sedar_document_control.model_sedar_document_request"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('sedar_request_purpose', '=', False), '|', '|', ('assigned_user_id', '=', user.id), ('applicant_id.user_id', '=', user.id), ('interview_id.interviewer_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_sedar_recruitment_document_request_manager" model="ir.rule">
        <field name="name">SEDAR recruitment document requests: recruitment managers all</field>
        <field name="model_id" ref="sedar_document_control.model_sedar_document_request"/>
        <field name="groups" eval="[Command.link(ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_sedar_recruitment_document_value_assigned" model="ir.rule">
        <field name="name">SEDAR recruitment document values: assigned users only</field>
        <field name="model_id" ref="sedar_document_control.model_sedar_document_value"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('request_id.sedar_request_purpose', '=', False), '|', '|', ('request_id.assigned_user_id', '=', user.id), ('request_id.applicant_id.user_id', '=', user.id), ('request_id.interview_id.interviewer_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_sedar_recruitment_document_value_manager" model="ir.rule">
        <field name="name">SEDAR recruitment document values: recruitment managers all</field>
        <field name="model_id" ref="sedar_document_control.model_sedar_document_value"/>
        <field name="groups" eval="[Command.link(ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
