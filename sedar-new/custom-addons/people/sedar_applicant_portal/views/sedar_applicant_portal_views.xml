<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_applicant_sedar_portal_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.sedar.portal.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="sedar_applicant_intake.view_hr_applicant_sedar_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sedar_adm3']" position="after">
                <page string="Applicant Portal" name="sedar_portal">
                    <group string="Account Access">
                        <field name="sedar_portal_partner_id"/>
                        <field name="sedar_portal_claimed_at"/>
                        <field name="sedar_claim_expires_at"/>
                        <field name="sedar_claim_url" readonly="1" widget="url"/>
                    </group>
                    <group string="Applicant-Facing Status">
                        <field name="sedar_public_status"/>
                        <field name="sedar_public_message"/>
                        <field name="sedar_action_required"/>
                        <field name="sedar_action_instructions" invisible="not sedar_action_required"/>
                        <field name="sedar_status_updated_at" readonly="1"/>
                    </group>
                    <field name="sedar_portal_event_ids">
                        <list><field name="occurred_at"/><field name="title"/><field name="message"/><field name="visible"/></list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_regenerate_claim_token" type="object" string="Regenerate Portal Link" groups="hr_recruitment.group_hr_recruitment_user"/>
                <button name="action_revoke_portal_access" type="object" string="Revoke Portal Access" groups="hr_recruitment.group_hr_recruitment_user" invisible="not sedar_portal_partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
