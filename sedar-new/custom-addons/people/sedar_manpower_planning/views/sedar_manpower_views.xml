<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shortage_search" model="ir.ui.view">
        <field name="name">sedar.crew.shortage.search</field><field name="model">sedar.crew.shortage</field>
        <field name="arch" type="xml"><search string="Crew Shortages">
            <field name="order_id"/><field name="rank_id"/><field name="tugboat_id"/><field name="root_cause"/>
            <filter name="unreviewed" string="Unreviewed" domain="[('review_state','=','unreviewed')]"/>
            <filter name="action_required" string="Action Required" domain="[('review_state','=','action_required')]"/>
            <filter name="escalated" string="Escalated" domain="[('review_state','=','escalated')]"/>
            <filter name="open" string="Open" domain="[('status','=','open')]"/>
            <separator/><filter name="group_rank" string="Group by Rank" context="{'group_by':'rank_id'}"/>
            <filter name="group_cause" string="Group by Root Cause" context="{'group_by':'root_cause'}"/>
            <filter name="group_state" string="Group by Review State" context="{'group_by':'review_state'}"/>
        </search></field>
    </record>
    <record id="view_shortage_list" model="ir.ui.view">
        <field name="name">sedar.crew.shortage.list</field><field name="model">sedar.crew.shortage</field>
        <field name="arch" type="xml"><list decoration-danger="review_state == 'escalated'" decoration-warning="review_state == 'unreviewed'">
            <field name="order_id"/><field name="tugboat_id"/><field name="rank_id"/><field name="missing_count"/>
            <field name="reason"/><field name="root_cause"/><field name="resolution_action"/><field name="review_state"/><field name="status"/>
        </list></field>
    </record>
    <record id="view_shortage_form" model="ir.ui.view">
        <field name="name">sedar.crew.shortage.form</field><field name="model">sedar.crew.shortage</field>
        <field name="arch" type="xml"><form string="Crew Shortage">
            <header>
                <button name="action_start_review" type="object" string="Start Review" class="btn-primary" invisible="review_state != 'unreviewed'" groups="sedar_manpower_planning.group_crewing_officer"/>
                <button name="action_mark_action_required" type="object" string="Record Review" class="btn-primary" invisible="review_state != 'reviewing'" groups="sedar_manpower_planning.group_crewing_officer"/>
                <button name="action_escalate" type="object" string="Escalate to Manpower" class="btn-primary" invisible="review_state != 'action_required'" groups="sedar_manpower_planning.group_crewing_officer"/>
                <button name="action_create_manpower_request" type="object" string="Create Manpower Request" invisible="review_state != 'escalated' or manpower_request_line_id" groups="sedar_manpower_planning.group_crewing_officer"/>
                <button name="action_resolve" type="object" string="Resolve" invisible="review_state == 'resolved'" groups="sedar_manpower_planning.group_crewing_officer"/>
                <field name="review_state" widget="statusbar" statusbar_visible="unreviewed,reviewing,action_required,escalated,resolved"/>
            </header>
            <sheet><div class="oe_title"><h1><field name="rank_id"/></h1></div>
                <group><group string="Operational Context"><field name="order_id"/><field name="operation_id"/><field name="tugboat_id"/><field name="requirement_id"/><field name="missing_count"/><field name="reason"/></group>
                    <group string="Review"><field name="detected_at"/><field name="reviewer_id"/><field name="reviewed_at"/><field name="root_cause"/><field name="resolution_action"/><field name="status"/></group></group>
                <notebook><page string="Resolution"><field name="resolution_notes"/><field name="resolved_at"/><field name="manpower_request_line_id"/><field name="action_ids"><list editable="bottom"><field name="action_type"/><field name="responsible_user_id"/><field name="planned_date"/><field name="completed_date"/><field name="state"/><field name="outcome"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="action_shortage_review" model="ir.actions.act_window"><field name="name">Shortage Review Queue</field><field name="res_model">sedar.crew.shortage</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_shortage_search"/></record>

    <record id="view_shortage_action_list" model="ir.ui.view"><field name="name">sedar.crew.shortage.action.list</field><field name="model">sedar.crew.shortage.action</field><field name="arch" type="xml"><list><field name="shortage_id"/><field name="action_type"/><field name="responsible_user_id"/><field name="planned_date"/><field name="completed_date"/><field name="state"/></list></field></record>
    <record id="view_shortage_action_form" model="ir.ui.view"><field name="name">sedar.crew.shortage.action.form</field><field name="model">sedar.crew.shortage.action</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start" invisible="state != 'planned'"/><button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state not in ['planned','in_progress']"/><button name="action_fail" type="object" string="Mark Failed" invisible="state in ['completed','failed','cancelled']"/><field name="state" widget="statusbar"/></header><sheet><group><field name="shortage_id"/><field name="action_type"/><field name="assigned_employee_id"/><field name="responsible_user_id"/><field name="planned_date"/><field name="completed_date"/></group><field name="outcome"/><field name="attachment_ids" widget="many2many_binary"/></sheet></form></field></record>
    <record id="action_shortage_actions" model="ir.actions.act_window"><field name="name">Resolution Actions</field><field name="res_model">sedar.crew.shortage.action</field><field name="view_mode">list,form</field></record>

    <record id="view_manpower_request_search" model="ir.ui.view"><field name="name">sedar.manpower.request.search</field><field name="model">sedar.manpower.request</field><field name="arch" type="xml"><search string="Manpower Requests"><field name="name"/><field name="department_id"/><field name="requested_by"/><field name="state"/><filter name="pending" string="Pending Approval" domain="[('state','in',['submitted','hr_review','manager_approval'])]"/><filter name="approved" string="Approved" domain="[('state','in',['approved','position_open'])]"/><separator/><filter name="group_state" string="Group by State" context="{'group_by':'state'}"/><filter name="group_department" string="Group by Department" context="{'group_by':'department_id'}"/></search></field></record>
    <record id="view_manpower_request_list" model="ir.ui.view"><field name="name">sedar.manpower.request.list</field><field name="model">sedar.manpower.request</field><field name="arch" type="xml"><list><field name="name"/><field name="department_id"/><field name="requested_by"/><field name="request_date"/><field name="priority"/><field name="shortage_count"/><field name="vacancy_count"/><field name="state"/></list></field></record>
    <record id="view_manpower_request_form" model="ir.ui.view"><field name="name">sedar.manpower.request.form</field><field name="model">sedar.manpower.request</field><field name="arch" type="xml"><form string="Manpower Request"><header><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'" groups="sedar_manpower_planning.group_crewing_officer"/><button name="action_start_hr_review" type="object" string="Start HR Review" class="btn-primary" invisible="state != 'submitted'" groups="sedar_manpower_planning.group_hr_reviewer"/><button name="action_submit_for_approval" type="object" string="Submit for Approval" class="btn-primary" invisible="state != 'hr_review'" groups="sedar_manpower_planning.group_hr_reviewer"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'manager_approval'" groups="sedar_manpower_planning.group_manpower_approver"/><button name="action_open_vacancies" type="object" string="Open Positions" class="btn-primary" invisible="state != 'approved'" groups="sedar_manpower_planning.group_hr_manager"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['submitted','hr_review','manager_approval']" groups="sedar_manpower_planning.group_hr_reviewer"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ['position_open','closed','cancelled']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,hr_review,manager_approval,approved,position_open"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="department_id"/><field name="requested_by"/><field name="request_date"/><field name="priority"/></group><group><field name="hr_reviewer_id"/><field name="operations_approver_id"/><field name="shortage_count"/><field name="vacancy_count"/></group></group><field name="business_justification"/><field name="operational_impact"/><field name="rejection_reason" invisible="state != 'rejected'"/><notebook><page string="Requested Positions"><field name="line_ids"><list editable="bottom"><field name="crew_rank_id"/><field name="job_id"/><field name="request_type"/><field name="quantity"/><field name="approved_quantity"/><field name="required_date"/><field name="vacancy_id"/></list><form><group><field name="crew_rank_id"/><field name="job_id"/><field name="request_type"/><field name="quantity"/><field name="approved_quantity"/><field name="required_date"/></group><field name="shortage_ids" widget="many2many_tags"/><field name="required_certificate_type_ids" widget="many2many_tags"/><field name="minimum_experience_years"/><field name="required_qualifications"/><field name="vacancy_id"/></form></field></page><page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_manpower_requests" model="ir.actions.act_window"><field name="name">Manpower Requests</field><field name="res_model">sedar.manpower.request</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_manpower_request_search"/></record>

    <record id="view_job_vacancy_search" model="ir.ui.view"><field name="name">sedar.job.vacancy.search</field><field name="model">sedar.job.vacancy</field><field name="arch" type="xml"><search string="Job Vacancies"><field name="name"/><field name="job_id"/><field name="crew_rank_id"/><field name="department_id"/><filter name="open" string="Open" domain="[('state','=','open')]"/><filter name="internal" string="Internal Only" domain="[('publication_state','=','internal')]"/><filter name="publication_ready" string="Approved for Publication" domain="[('publication_state','=','approved')]"/><separator/><filter name="group_state" string="Group by State" context="{'group_by':'state'}"/><filter name="group_rank" string="Group by Rank" context="{'group_by':'crew_rank_id'}"/></search></field></record>
    <record id="view_job_vacancy_list" model="ir.ui.view"><field name="name">sedar.job.vacancy.list</field><field name="model">sedar.job.vacancy</field><field name="arch" type="xml"><list><field name="name"/><field name="job_id"/><field name="crew_rank_id"/><field name="employment_type"/><field name="approved_openings"/><field name="filled_openings"/><field name="remaining_openings"/><field name="publication_state"/><field name="state"/></list></field></record>
    <record id="view_job_vacancy_form" model="ir.ui.view"><field name="name">sedar.job.vacancy.form</field><field name="model">sedar.job.vacancy</field><field name="arch" type="xml"><form string="Job Vacancy"><header><button name="action_open" type="object" string="Open Position" class="btn-primary" invisible="state != 'draft'" groups="sedar_manpower_planning.group_hr_manager"/><button name="action_approve_publication" type="object" string="Approve Publication" class="btn-primary" invisible="publication_state != 'internal'" groups="sedar_manpower_planning.group_hr_manager"/><button name="action_close" type="object" string="Close" invisible="state in ['closed','cancelled']" groups="sedar_manpower_planning.group_hr_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,open,on_hold,filled,closed"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="job_id"/><field name="crew_rank_id"/><field name="department_id"/><field name="request_line_id"/></group><group><field name="employment_type"/><field name="approved_openings"/><field name="filled_openings"/><field name="remaining_openings"/><field name="opening_date"/><field name="application_deadline"/></group></group><group string="Publication Gate"><field name="publication_state"/><field name="website_title"/><field name="website_summary"/></group><field name="responsibilities"/><field name="requirements"/><chatter/></sheet></form></field></record>
    <record id="action_job_vacancies" model="ir.actions.act_window"><field name="name">Approved Vacancies</field><field name="res_model">sedar.job.vacancy</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_job_vacancy_search"/></record>

    <record id="view_service_order_manpower_inherit" model="ir.ui.view"><field name="name">sedar.marine.service.order.manpower.inherit</field><field name="model">sedar.marine.service.order</field><field name="inherit_id" ref="sedar_marine_operations.view_service_order_form"/><field name="arch" type="xml"><xpath expr="//header/button[@name='action_plan']" position="after"><button name="action_open_shortages" type="object" string="Crew Shortages" invisible="not shortage_count" groups="sedar_manpower_planning.group_crewing_officer"/><button name="action_open_manpower_requests" type="object" string="Manpower Requests" invisible="not manpower_request_count" groups="sedar_manpower_planning.group_crewing_officer"/></xpath><xpath expr="//field[@name='tug_assignment_count']" position="after"><field name="shortage_count" groups="sedar_manpower_planning.group_crewing_officer"/><field name="manpower_request_count" groups="sedar_manpower_planning.group_crewing_officer"/></xpath></field></record>

    <menuitem id="menu_manpower_planning" name="Manpower Planning" parent="sedar_marine_operations.menu_marine_operations" sequence="80"/>
    <menuitem id="menu_shortage_review" name="Shortage Review Queue" parent="menu_manpower_planning" action="action_shortage_review" sequence="10"/>
    <menuitem id="menu_shortage_actions" name="Resolution Actions" parent="menu_manpower_planning" action="action_shortage_actions" sequence="20"/>
    <menuitem id="menu_manpower_requests" name="Manpower Requests" parent="menu_manpower_planning" action="action_manpower_requests" sequence="30"/>
    <menuitem id="menu_job_vacancies" name="Approved Vacancies" parent="menu_manpower_planning" action="action_job_vacancies" sequence="40"/>
</odoo>
