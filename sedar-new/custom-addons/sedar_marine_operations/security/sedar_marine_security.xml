<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TODO(post-demo access hardening): Replace the broad base.group_user operational
         access in ir.model.access.csv with explicit role-based permissions before this
         system is used beyond the demonstration. Internal-user editing is intentionally
         accepted for the current demo only. -->
    <record id="module_category_sedar_marine" model="ir.module.category">
        <field name="name">SEDAR Marine Operations</field>
        <field name="sequence">20</field>
    </record>
    <record id="privilege_sedar_marine_operations" model="res.groups.privilege">
        <field name="name">Marine Operations</field>
        <field name="category_id" ref="module_category_sedar_marine"/>
        <field name="sequence">20</field>
    </record>
    <record id="group_customer_relations" model="res.groups">
        <field name="name">Customer Relations Officer</field>
        <field name="privilege_id" ref="privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_commercial_manager" model="res.groups">
        <field name="name">Commercial Manager</field>
        <field name="privilege_id" ref="privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('group_customer_relations'))]"/>
    </record>
    <record id="group_tug_master" model="res.groups">
        <field name="name">Tug Master</field>
        <field name="privilege_id" ref="privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_completion_reviewer" model="res.groups">
        <field name="name">Service Completion Reviewer</field>
        <field name="privilege_id" ref="privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_operations_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="privilege_id" ref="privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('group_completion_reviewer'))]"/>
    </record>
    <record id="rule_service_order_company" model="ir.rule">
        <field name="name">Service Orders are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_marine_service_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tugboat_company" model="ir.rule">
        <field name="name">Tugboats are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_tugboat"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tug_assignment_company" model="ir.rule">
        <field name="name">Tug assignments are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_tug_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_manning_requirement_company" model="ir.rule">
        <field name="name">Manning requirements are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_manning_requirement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_crew_assignment_company" model="ir.rule">
        <field name="name">Crew assignments are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_crew_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_crew_shortage_company" model="ir.rule">
        <field name="name">Crew shortages are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_crew_shortage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_portal_service_order" model="ir.rule">
        <field name="name">Portal clients see their own service orders</field>
        <field name="model_id" ref="model_sedar_marine_service_order"/>
        <field name="domain_force">[('client_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
    <record id="rule_portal_client_vessel" model="ir.rule">
        <field name="name">Portal clients see their own vessels</field>
        <field name="model_id" ref="model_sedar_client_vessel"/>
        <field name="domain_force">[('owner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
</odoo>
