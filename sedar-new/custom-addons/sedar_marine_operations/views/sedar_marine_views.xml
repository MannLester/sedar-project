<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_order_search" model="ir.ui.view">
        <field name="name">sedar.marine.service.order.search</field>
        <field name="model">sedar.marine.service.order</field>
        <field name="arch" type="xml">
            <search string="Service Orders">
                <field name="name"/><field name="client_id"/><field name="assisted_vessel_name"/>
                <field name="service_type_id"/><field name="requested_start"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="needs_info" string="Needs Information" domain="[('state','=','needs_info')]"/>
                <filter name="pricing_review" string="Pricing Review" domain="[('pricing_status','=','review')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="urgent" string="Urgent / Emergency" domain="[('priority','in',['urgent','emergency'])]"/>
                <filter name="ready" string="Ready" domain="[('readiness_status','=','ready')]"/>
                <filter name="blocked_tug" string="Blocked by Tug" domain="[('readiness_status','=','blocked_tug')]"/>
                <filter name="blocked_crew" string="Blocked by Crew" domain="[('readiness_status','=','blocked_crew')]"/>
                <separator/>
                <filter string="Group by Status" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Group by Client" name="group_client" context="{'group_by':'client_id'}"/>
                <filter string="Group by Service Type" name="group_service" context="{'group_by':'service_type_id'}"/>
                <filter string="Group by Requested Date" name="group_date" context="{'group_by':'requested_start:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_service_order_list" model="ir.ui.view">
        <field name="name">sedar.marine.service.order.list</field>
        <field name="model">sedar.marine.service.order</field>
        <field name="arch" type="xml">
            <list string="Service Orders" decoration-danger="priority == 'emergency'" decoration-warning="priority == 'urgent'">
                <field name="name"/><field name="client_id"/><field name="assisted_vessel_name"/>
                <field name="service_type_id"/><field name="port_id"/><field name="requested_start"/>
                <field name="number_of_tugs"/><field name="estimated_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/><field name="pricing_status"/><field name="readiness_status"/><field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_service_order_kanban" model="ir.ui.view">
        <field name="name">sedar.marine.service.order.kanban</field>
        <field name="model">sedar.marine.service.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/><field name="client_id"/><field name="assisted_vessel_name"/>
                <field name="service_type_id"/><field name="requested_start"/><field name="priority"/>
                <field name="pricing_status"/><field name="readiness_status"/><field name="estimated_amount"/><field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong><field name="name"/></strong>
                            <span t-if="record.priority.raw_value != 'normal'" class="badge text-bg-warning"><field name="priority"/></span>
                        </div>
                        <div class="mt-2"><field name="client_id"/></div>
                        <div><field name="assisted_vessel_name"/> · <field name="service_type_id"/></div>
                        <div class="text-muted mt-2"><field name="requested_start"/></div>
                        <div class="mt-2"><field name="pricing_status"/></div>
                        <div class="mt-1"><field name="readiness_status"/></div>
                        <div t-if="record.estimated_amount.raw_value" class="mt-1 fw-semibold"><field name="estimated_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_service_order_form" model="ir.ui.view">
        <field name="name">sedar.marine.service.order.form</field>
        <field name="model">sedar.marine.service.order</field>
        <field name="arch" type="xml">
            <form string="Marine Service Order">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Start Review" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_request_info" type="object" string="Request Information" invisible="state not in ['submitted','review']"/>
                    <button name="action_quote" type="object" string="Mark Quoted" class="btn-primary" invisible="state not in ['review','pricing']"/>
                    <button name="action_confirm" type="object" string="Client Confirmed" class="btn-primary" invisible="state != 'quoted'"/>
                    <button name="action_plan" type="object" string="Send to Operations Planning" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ['closed','cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,review,needs_info,pricing,quoted,confirmed,planning"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Client Request">
                            <field name="client_id"/><field name="contact_id" domain="[('commercial_partner_id','=',client_id)]"/>
                            <field name="request_channel"/><field name="client_reference"/><field name="priority"/>
                        </group>
                        <group string="Schedule">
                            <field name="requested_start"/><field name="estimated_duration_hours"/>
                            <field name="requested_completion" readonly="1"/><field name="port_id"/>
                            <field name="origin_berth_id" domain="[('port_id','=',port_id)]"/>
                            <field name="destination_berth_id" domain="[('port_id','=',port_id)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service Details">
                            <group>
                                <group>
                                    <field name="assisted_vessel_id" domain="[('owner_id','=',client_id)]"/>
                                    <field name="assisted_vessel_name"/>
                                    <field name="service_type_id"/><field name="service_subtype"/>
                                    <field name="number_of_tugs"/><field name="tug_class_id"/>
                                    <field name="required_bollard_pull"/>
                                </group>
                                <group>
                                    <field name="scope_of_work"/><field name="special_instructions"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tug and Crew Readiness">
                            <group><field name="readiness_status"/><field name="readiness_reason"/><field name="tug_assignment_count"/></group>
                            <field name="tug_assignment_ids">
                                <list>
                                    <field name="tugboat_id"/><field name="planned_start"/><field name="planned_end"/>
                                    <field name="tug_available"/><field name="availability_reason"/><field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Safety and Documents">
                            <group>
                                <group><field name="hazardous_cargo"/><field name="cargo_description" invisible="not hazardous_cargo"/><field name="permit_required"/></group>
                                <group><field name="safety_requirements"/><field name="supporting_document_filename" invisible="1"/><field name="supporting_document" filename="supporting_document_filename"/></group>
                            </group>
                        </page>
                        <page string="Pricing">
                            <group>
                                <group><field name="pricing_status"/><field name="price_source"/><field name="tariff_id"/><field name="pricing_basis"/></group>
                                <group><field name="pricing_quantity"/><field name="unit_rate"/><field name="minimum_charge"/><field name="estimated_amount"/><field name="currency_id" invisible="1"/></group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_service_order_dashboard" model="ir.actions.act_window">
        <field name="name">Service Order Dashboard</field><field name="res_model">sedar.marine.service.order</field>
        <field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_service_order_search"/>
    </record>

    <record id="view_client_tariff_list" model="ir.ui.view"><field name="name">sedar.client.tariff.list</field><field name="model">sedar.client.tariff</field><field name="arch" type="xml"><list><field name="partner_id"/><field name="service_type_id"/><field name="port_id"/><field name="tug_class_id"/><field name="pricing_basis"/><field name="rate"/><field name="currency_id"/><field name="valid_from"/><field name="valid_until"/><field name="approved"/></list></field></record>
    <record id="view_client_tariff_form" model="ir.ui.view"><field name="name">sedar.client.tariff.form</field><field name="model">sedar.client.tariff</field><field name="arch" type="xml"><form><sheet><group><group><field name="partner_id"/><field name="service_type_id"/><field name="port_id"/><field name="tug_class_id"/></group><group><field name="pricing_basis"/><field name="rate"/><field name="minimum_charge"/><field name="currency_id"/><field name="valid_from"/><field name="valid_until"/><field name="approved"/><field name="active"/></group></group></sheet></form></field></record>
    <record id="action_client_tariffs" model="ir.actions.act_window"><field name="name">Client Tariffs</field><field name="res_model">sedar.client.tariff</field><field name="view_mode">list,form</field></record>

    <record id="view_service_type_list" model="ir.ui.view"><field name="name">sedar.marine.service.type.list</field><field name="model">sedar.marine.service.type</field><field name="arch" type="xml"><list><field name="sequence"/><field name="code"/><field name="name"/><field name="pricing_basis"/><field name="standard_rate"/><field name="currency_id"/><field name="active"/></list></field></record>
    <record id="view_service_type_form" model="ir.ui.view"><field name="name">sedar.marine.service.type.form</field><field name="model">sedar.marine.service.type</field><field name="arch" type="xml"><form><sheet><group><field name="sequence"/><field name="code"/><field name="name"/><field name="pricing_basis"/><field name="standard_rate"/><field name="currency_id"/><field name="requires_destination"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_service_types" model="ir.actions.act_window"><field name="name">Service Types</field><field name="res_model">sedar.marine.service.type</field><field name="view_mode">list,form</field></record>

    <record id="view_port_list" model="ir.ui.view"><field name="name">sedar.marine.port.list</field><field name="model">sedar.marine.port</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="timezone"/><field name="active"/></list></field></record>
    <record id="view_port_form" model="ir.ui.view"><field name="name">sedar.marine.port.form</field><field name="model">sedar.marine.port</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="timezone"/><field name="active"/></group><field name="berth_ids"><list editable="bottom"><field name="code"/><field name="name"/><field name="active"/></list></field></sheet></form></field></record>
    <record id="action_ports" model="ir.actions.act_window"><field name="name">Ports and Locations</field><field name="res_model">sedar.marine.port</field><field name="view_mode">list,form</field></record>

    <record id="view_client_vessel_list" model="ir.ui.view"><field name="name">sedar.client.vessel.list</field><field name="model">sedar.client.vessel</field><field name="arch" type="xml"><list><field name="name"/><field name="owner_id"/><field name="imo_number"/><field name="call_sign"/><field name="vessel_type"/><field name="gross_tonnage"/><field name="active"/></list></field></record>
    <record id="view_client_vessel_form" model="ir.ui.view"><field name="name">sedar.client.vessel.form</field><field name="model">sedar.client.vessel</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="owner_id"/><field name="imo_number"/><field name="call_sign"/><field name="vessel_type"/></group><group><field name="gross_tonnage"/><field name="length_overall"/><field name="draft"/><field name="active"/></group></group></sheet></form></field></record>
    <record id="action_client_vessels" model="ir.actions.act_window"><field name="name">Client Vessels</field><field name="res_model">sedar.client.vessel</field><field name="view_mode">list,form</field></record>

    <record id="view_tugboat_list" model="ir.ui.view"><field name="name">sedar.tugboat.list</field><field name="model">sedar.tugboat</field><field name="arch" type="xml"><list><field name="name"/><field name="registration_number"/><field name="call_sign"/><field name="tug_class_id"/><field name="bollard_pull"/><field name="home_port_id"/><field name="availability_status"/></list></field></record>
    <record id="view_tugboat_form" model="ir.ui.view"><field name="name">sedar.tugboat.form</field><field name="model">sedar.tugboat</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="registration_number"/><field name="call_sign"/><field name="mmsi"/><field name="tug_class_id"/></group><group><field name="bollard_pull"/><field name="fuel_capacity"/><field name="home_port_id"/><field name="availability_status"/><field name="active"/></group></group><field name="home_crew_ids"><list><field name="employee_number"/><field name="employee_id"/><field name="rank_id"/><field name="availability_status"/></list></field></sheet></form></field></record>
    <record id="action_tugboats" model="ir.actions.act_window"><field name="name">Tugboats</field><field name="res_model">sedar.tugboat</field><field name="view_mode">list,form</field></record>

    <record id="view_crew_profile_list" model="ir.ui.view"><field name="name">sedar.crew.profile.list</field><field name="model">sedar.crew.profile</field><field name="arch" type="xml"><list><field name="employee_number"/><field name="employee_id"/><field name="rank_id"/><field name="home_tugboat_id"/><field name="availability_status"/><field name="seafarer_number"/></list></field></record>
    <record id="view_crew_profile_form" model="ir.ui.view"><field name="name">sedar.crew.profile.form</field><field name="model">sedar.crew.profile</field><field name="arch" type="xml"><form><sheet><group><group><field name="employee_number"/><field name="employee_id"/><field name="rank_id"/></group><group><field name="home_tugboat_id"/><field name="availability_status"/><field name="seafarer_number"/><field name="active"/></group></group><field name="certificate_ids"><list editable="bottom"><field name="certificate_type_id"/><field name="certificate_number"/><field name="issue_date"/><field name="expiry_date"/><field name="status"/></list></field></sheet></form></field></record>
    <record id="action_crew_profiles" model="ir.actions.act_window"><field name="name">Crew Profiles</field><field name="res_model">sedar.crew.profile</field><field name="view_mode">list,form</field></record>

    <record id="view_manning_template_list" model="ir.ui.view"><field name="name">sedar.manning.template.list</field><field name="model">sedar.manning.template</field><field name="arch" type="xml"><list><field name="name"/><field name="service_type_id"/><field name="tug_class_id"/><field name="active"/></list></field></record>
    <record id="view_manning_template_form" model="ir.ui.view"><field name="name">sedar.manning.template.form</field><field name="model">sedar.manning.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="service_type_id"/><field name="tug_class_id"/><field name="active"/></group><field name="line_ids"><list editable="bottom"><field name="sequence"/><field name="rank_id"/><field name="required_count"/><field name="required_certificate_type_ids" widget="many2many_tags"/></list></field></sheet></form></field></record>
    <record id="action_manning_templates" model="ir.actions.act_window"><field name="name">Manning Templates</field><field name="res_model">sedar.manning.template</field><field name="view_mode">list,form</field></record>

    <record id="view_tug_assignment_form" model="ir.ui.view"><field name="name">sedar.tug.assignment.form</field><field name="model">sedar.tug.assignment</field><field name="arch" type="xml"><form><header><button name="action_generate_requirements" type="object" string="Generate Manning Requirements" class="btn-primary" invisible="requirement_ids"/><field name="state" widget="statusbar"/></header><sheet><group><field name="order_id"/><field name="tugboat_id"/><field name="planned_start"/><field name="planned_end"/><field name="tug_available"/><field name="availability_reason"/></group><field name="requirement_ids"><list><field name="rank_id"/><field name="required_count"/><field name="assigned_count"/><field name="gap_count"/><field name="compliance_issue_count"/><field name="status"/></list></field></sheet></form></field></record>
    <record id="view_tug_assignment_list" model="ir.ui.view"><field name="name">sedar.tug.assignment.list</field><field name="model">sedar.tug.assignment</field><field name="arch" type="xml"><list><field name="order_id"/><field name="tugboat_id"/><field name="planned_start"/><field name="planned_end"/><field name="tug_available"/><field name="state"/></list></field></record>
    <record id="action_tug_assignments" model="ir.actions.act_window"><field name="name">Tug and Crew Plans</field><field name="res_model">sedar.tug.assignment</field><field name="view_mode">list,form</field></record>

    <record id="view_manning_requirement_form" model="ir.ui.view">
        <field name="name">sedar.manning.requirement.form</field>
        <field name="model">sedar.manning.requirement</field>
        <field name="arch" type="xml">
            <form string="Manning Requirement">
                <sheet>
                    <group>
                        <group><field name="tug_assignment_id"/><field name="rank_id"/><field name="required_count"/></group>
                        <group><field name="status"/><field name="assigned_count"/><field name="gap_count"/><field name="compliance_issue_count"/></group>
                    </group>
                    <field name="required_certificate_type_ids" widget="many2many_tags"/>
                    <field name="crew_assignment_ids">
                        <list editable="bottom">
                            <field name="crew_profile_id" domain="[('rank_id', '=', parent.rank_id)]"/>
                            <field name="employee_id"/><field name="rank_id"/>
                            <field name="state"/><field name="is_eligible"/><field name="eligibility_reason"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crew_rank_list" model="ir.ui.view"><field name="name">sedar.crew.rank.list</field><field name="model">sedar.crew.rank</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence"/><field name="code"/><field name="name"/><field name="active"/></list></field></record>
    <record id="action_crew_ranks" model="ir.actions.act_window"><field name="name">Crew Ranks</field><field name="res_model">sedar.crew.rank</field><field name="view_mode">list</field></record>
    <record id="view_certificate_type_list" model="ir.ui.view"><field name="name">sedar.crew.certificate.type.list</field><field name="model">sedar.crew.certificate.type</field><field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="active"/></list></field></record>
    <record id="action_certificate_types" model="ir.actions.act_window"><field name="name">Certificate Types</field><field name="res_model">sedar.crew.certificate.type</field><field name="view_mode">list</field></record>

