    <menuitem id="menu_tug_assignments" name="Tug and Crew Plans" parent="menu_marine_operations" action="action_tug_assignments" sequence="60"/>
    <menuitem id="menu_marine_configuration" name="Configuration" parent="menu_marine_operations" sequence="90"/>
    <menuitem id="menu_service_types" name="Service Types" parent="menu_marine_configuration" action="action_service_types" sequence="10"/>
    <menuitem id="menu_ports" name="Ports and Locations" parent="menu_marine_configuration" action="action_ports" sequence="20"/>
    <menuitem id="menu_manning_templates" name="Manning Templates" parent="menu_marine_configuration" action="action_manning_templates" sequence="30"/>
    <menuitem id="menu_crew_ranks" name="Crew Ranks" parent="menu_marine_configuration" action="action_crew_ranks" sequence="40"/>
    <menuitem id="menu_certificate_types" name="Certificate Types" parent="menu_marine_configuration" action="action_certificate_types" sequence="50"/>
</odoo>
