<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="application_form" name="SEDAR Applicant Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure bg-light">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <div class="mb-4">
                                <p class="text-uppercase text-muted small mb-2">SEDAR Careers</p>
                                <h1>Application for <t t-esc="vacancy.website_title"/></h1>
                                <p class="text-muted"><t t-esc="vacancy.department_id.name"/> · <t t-esc="vacancy.website_location_id.name"/></p>
                            </div>
                            <t t-if="errors">
                                <div class="alert alert-danger"><ul class="mb-0"><li t-foreach="errors" t-as="error"><t t-esc="error"/></li></ul></div>
                            </t>
                            <form action="" method="post" enctype="multipart/form-data" class="bg-white p-4 p-lg-5 shadow-sm rounded">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <h3 class="mb-3">1. Personal Information</h3>
                                <div class="row g-3">
                                    <div class="col-md-4"><label class="form-label">Family Name *</label><input class="form-control" name="family_name" required="required" t-att-value="form.get('family_name', '')"/></div>
                                    <div class="col-md-4"><label class="form-label">Given Name *</label><input class="form-control" name="given_name" required="required" t-att-value="form.get('given_name', '')"/></div>
                                    <div class="col-md-4"><label class="form-label">Middle Name</label><input class="form-control" name="middle_name" t-att-value="form.get('middle_name', '')"/></div>
                                    <div class="col-md-6"><label class="form-label">Father's Name</label><input class="form-control" name="fathers_name" t-att-value="form.get('fathers_name', '')"/></div>
                                    <div class="col-md-3"><label class="form-label">Date of Birth</label><input type="date" class="form-control" name="date_of_birth" t-att-value="form.get('date_of_birth', '')"/></div>
                                    <div class="col-md-3"><label class="form-label">Age</label><input type="number" min="0" class="form-control" name="age" t-att-value="form.get('age', '')"/></div>
                                    <div class="col-md-6"><label class="form-label">Place of Birth</label><input class="form-control" name="place_of_birth" t-att-value="form.get('place_of_birth', '')"/></div>
                                    <div class="col-md-3"><label class="form-label">Height</label><input type="number" step="0.01" min="0" class="form-control" name="height" t-att-value="form.get('height', '')"/></div>
                                    <div class="col-md-3"><label class="form-label">Weight</label><input type="number" step="0.01" min="0" class="form-control" name="weight" t-att-value="form.get('weight', '')"/></div>
                                    <div class="col-md-4"><label class="form-label">Civil Status</label><select class="form-select" name="civil_status"><option value="">Select</option><option value="single">Single</option><option value="married">Married</option><option value="widowed">Widowed</option><option value="separated">Legally Separated</option></select></div>
                                    <div class="col-md-4"><label class="form-label">Email *</label><input type="email" class="form-control" name="email" required="required" t-att-value="form.get('email', '')"/></div>
                                    <div class="col-md-4"><label class="form-label">Mobile Number *</label><input type="tel" class="form-control" name="mobile" required="required" t-att-value="form.get('mobile', '')"/></div>
                                    <div class="col-12"><label class="form-label">Contact Information</label><textarea class="form-control" name="contact_information"><t t-esc="form.get('contact_information', '')"/></textarea></div>
                                </div>
                                <hr class="my-4"/>
                                <h3 class="mb-3">2. Education and Skills</h3>
                                <p class="text-muted small">From and To are the dates attended at the school or course.</p>
                                <t t-foreach="[1, 2, 3]" t-as="index">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-4"><input class="form-control" t-att-name="'education_school_%s' % index" placeholder="School / College"/></div>
                                        <div class="col-md-3"><input class="form-control" t-att-name="'education_course_%s' % index" placeholder="Course"/></div>
                                        <div class="col-md-2"><input type="date" class="form-control" t-att-name="'education_from_%s' % index" title="From"/></div>
                                        <div class="col-md-2"><input type="date" class="form-control" t-att-name="'education_to_%s' % index" title="To"/></div>
                                        <div class="col-md-1"><input class="form-control" t-att-name="'education_english_%s' % index" placeholder="English"/></div>
                                    </div>
                                </t>
                                <div class="mb-3"><label class="form-label">Skills</label><textarea class="form-control" name="skills"><t t-esc="form.get('skills', '')"/></textarea></div>
                                <div class="mb-3"><label class="form-label">Trainings and Seminars</label><textarea class="form-control" name="training_entries"><t t-esc="form.get('training_entries', '')"/></textarea></div>
                                <hr class="my-4"/>
                                <h3 class="mb-3">3. Employment History</h3>
                                <t t-foreach="[1, 2, 3]" t-as="index">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-3"><input type="date" class="form-control" t-att-name="'employment_from_%s' % index" title="From"/></div>
                                        <div class="col-md-3"><input type="date" class="form-control" t-att-name="'employment_to_%s' % index" title="To"/></div>
                                        <div class="col-md-3"><input class="form-control" t-att-name="'employment_company_%s' % index" placeholder="Company / Address"/></div>
                                        <div class="col-md-3"><input class="form-control" t-att-name="'employment_position_%s' % index" placeholder="Position"/></div>
                                        <div class="col-12"><input class="form-control" t-att-name="'employment_reason_%s' % index" placeholder="Reason for leaving"/></div>
                                    </div>
                                </t>
                                <hr class="my-4"/>
                                <h3 class="mb-3">4. Supporting Information</h3>
                                <div class="row g-3">
                                    <div class="col-md-6"><label class="form-label">SIRB / Driver's License Details</label><textarea class="form-control" name="identity_documents"><t t-esc="form.get('identity_documents', '')"/></textarea></div>
                                    <div class="col-md-6"><label class="form-label">Emergency Contact and Beneficiary</label><textarea class="form-control" name="emergency_contact"><t t-esc="form.get('emergency_contact', '')"/></textarea></div>
                                    <div class="col-md-6"><label class="form-label">Resume / CV *</label><input type="file" class="form-control" name="resume" accept=".pdf,.doc,.docx" required="required"/></div>
                                    <div class="col-md-6"><label class="form-label">Applicant Photo</label><input type="file" class="form-control" name="photo" accept=".jpg,.jpeg,.png"/></div>
                                    <div class="col-md-6"><label class="form-label">Cover Letter</label><input type="file" class="form-control" name="cover_letter" accept=".pdf,.doc,.docx"/></div>
                                    <div class="col-md-6"><label class="form-label">Certificate / License</label><input type="file" class="form-control" name="certificate" accept=".pdf,.jpg,.jpeg,.png"/></div>
                                    <div class="col-12"><label class="form-label">Electronic Signature *</label><input class="form-control" name="electronic_signature" required="required" placeholder="Type your full name as your electronic signature"/></div>
                                </div>
                                <div class="form-check mt-4"><input class="form-check-input" type="checkbox" name="consent" value="1" id="consent" required="required"/><label class="form-check-label" for="consent">I certify that the information provided is true and consent to SEDAR processing this application for recruitment purposes. *</label></div>
                                <button type="submit" class="btn btn-primary btn-lg mt-4">Submit Application</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="application_submitted" name="SEDAR Application Submitted">
        <t t-call="website.layout"><div id="wrap" class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="alert alert-success"><h1>Application Submitted</h1><p>Your application reference is <strong><t t-esc="reference"/></strong>.</p><p>Keep this reference for your records. You can view your submission status using the secure link below.</p><a class="btn btn-primary" t-att-href="status_url">View Application Status</a></div></div></div></div></t>
    </template>
    <template id="application_status" name="SEDAR Application Status">
        <t t-call="website.layout"><div id="wrap" class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><h1>Application Status</h1><p>Reference: <strong><t t-esc="reference"/></strong></p><p>Position: <t t-esc="vacancy.website_title"/></p><p>Status: <strong><t t-esc="status"/></strong></p></div></div></div></t>
    </template>
</odoo>
