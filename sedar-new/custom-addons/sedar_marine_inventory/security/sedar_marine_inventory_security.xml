<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_marine_inventory_user" model="res.groups">
        <field name="name">Inventory Check User</field>
        <field name="privilege_id" ref="sedar_marine_operations.privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_marine_inventory_manager" model="res.groups">
        <field name="name">Procurement and Inventory Officer</field>
        <field name="privilege_id" ref="sedar_marine_operations.privilege_sedar_marine_operations"/>
        <field name="implied_ids" eval="[Command.link(ref('group_marine_inventory_user')), Command.link(ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="rule_inventory_requirement_user" model="ir.rule">
        <field name="name">Inventory Requirements: same company</field>
        <field name="model_id" ref="model_sedar_inventory_requirement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.clear()]"/>
    </record>

    <record id="rule_inventory_template_company" model="ir.rule">
        <field name="name">Inventory Templates: same company</field>
        <field name="model_id" ref="model_sedar_inventory_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_inventory_template_line_company" model="ir.rule">
        <field name="name">Inventory Template Lines: same company</field>
        <field name="model_id" ref="model_sedar_inventory_template_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_maintenance_part_line_user" model="ir.rule">
        <field name="name">Maintenance Part Lines: same company</field>
        <field name="model_id" ref="model_sedar_maintenance_part_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.clear()]"/>
    </record>

    <record id="rule_operation_fuel_log_user" model="ir.rule">
        <field name="name">Operation Fuel Logs: same company</field>
        <field name="model_id" ref="model_sedar_operation_fuel_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.clear()]"/>
    </record>

    <record id="rule_inventory_issue_company" model="ir.rule">
        <field name="name">Inventory Issues: same company</field>
        <field name="model_id" ref="model_sedar_inventory_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.clear()]"/>
    </record>

    <record id="rule_inventory_lifecycle_company" model="ir.rule">
        <field name="name">Inventory Lifecycles: same company</field>
        <field name="model_id" ref="model_sedar_inventory_lifecycle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.clear()]"/>
    </record>

    <record id="rule_inventory_lifecycle_event_company" model="ir.rule">
        <field name="name">Inventory Lifecycle Events: same company</field>
        <field name="model_id" ref="model_sedar_inventory_lifecycle_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.clear()]"/>
    </record>
</odoo>
