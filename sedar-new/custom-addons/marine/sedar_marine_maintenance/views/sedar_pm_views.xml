<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_task_search" model="ir.ui.view">
        <field name="name">sedar.pm.task.search</field>
        <field name="model">sedar.pm.task</field>
        <field name="arch" type="xml">
            <search string="Planned Maintenance">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="tugboat_id"/>
                <filter name="overdue" string="Overdue" domain="[('state', '=', 'overdue')]"/>
                <filter name="due" string="Due or Overdue" domain="[('state', 'in', ['due', 'overdue'])]"/>
                <filter name="approaching" string="Approaching" domain="[('state', '=', 'approaching')]"/>
                <filter name="needs_assignee" string="Alert Needs Assignee" domain="[('alert_assignment_state', '=', 'unassigned')]"/>
                <separator/>
                <filter name="group_tugboat" string="Group by Tugboat" context="{'group_by': 'tugboat_id'}"/>
                <filter name="group_equipment" string="Group by Equipment" context="{'group_by': 'equipment_id'}"/>
                <filter name="group_state" string="Group by Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_pm_task_list" model="ir.ui.view">
        <field name="name">sedar.pm.task.list</field>
        <field name="model">sedar.pm.task</field>
        <field name="arch" type="xml">
            <list string="Planned Maintenance" decoration-danger="state in ('due', 'overdue')" decoration-warning="state == 'approaching'">
                <field name="tugboat_id"/>
                <field name="equipment_id"/>
                <field name="name"/>
                <field name="interval_hours"/>
                <field name="current_hours"/>
                <field name="next_checkpoint_hours"/>
                <field name="remaining_hours"/>
                <field name="state" widget="badge" decoration-danger="state in ('due', 'overdue')" decoration-warning="state == 'approaching'"/>
            </list>
        </field>
    </record>

    <record id="view_pm_task_form" model="ir.ui.view">
        <field name="name">sedar.pm.task.form</field>
        <field name="model">sedar.pm.task</field>
        <field name="arch" type="xml">
            <form string="Planned Maintenance Task">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <field name="tugboat_id"/>
                            <field name="interval_hours"/>
                            <field name="warning_hours"/>
                        </group>
                        <group>
                            <field name="state" widget="badge" decoration-danger="state in ('due', 'overdue')" decoration-warning="state == 'approaching'"/>
                            <field name="current_hours"/>
                            <field name="last_checkpoint_hours"/>
                            <field name="next_checkpoint_hours"/>
                            <field name="remaining_hours"/>
                            <field name="alert_assignment_state" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Completions">
                            <field name="completion_ids" context="{'default_task_id': id}">
                                <list create="1" edit="0" delete="0">
                                    <field name="checkpoint_hours"/>
                                    <field name="running_hours"/>
                                    <field name="done_on"/>
                                    <field name="done_by_id"/>
                                    <field name="remarks"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="done_on"/>
                                        <field name="remarks"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Instructions">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_tasks" model="ir.actions.act_window">
        <field name="name">Planned Maintenance</field>
        <field name="res_model">sedar.pm.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_task_search"/>
        <field name="context">{'search_default_due': 1}</field>
    </record>

    <record id="view_daily_engine_report_search" model="ir.ui.view">
        <field name="name">sedar.daily.engine.report.search</field>
        <field name="model">sedar.daily.engine.report</field>
        <field name="arch" type="xml">
            <search string="Daily Engine Reports">
                <field name="tugboat_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="group_tugboat" string="Group by Tugboat" context="{'group_by': 'tugboat_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_daily_engine_report_list" model="ir.ui.view">
        <field name="name">sedar.daily.engine.report.list</field>
        <field name="model">sedar.daily.engine.report</field>
        <field name="arch" type="xml">
            <list string="Daily Engine Reports" decoration-muted="state == 'posted'" decoration-warning="state == 'submitted'">
                <field name="report_date"/>
                <field name="watch_start" widget="float_time"/>
                <field name="watch_stop" widget="float_time"/>
                <field name="tugboat_id"/>
                <field name="prepared_by_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_daily_engine_report_form" model="ir.ui.view">
        <field name="name">sedar.daily.engine.report.form</field>
        <field name="model">sedar.daily.engine.report</field>
        <field name="arch" type="xml">
            <form string="Daily Engine Monitoring Report">
                <header>
                    <button name="action_submit" type="object" string="Submit to Chief Engineer" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Approve and Post Hours" class="btn-primary" invisible="state == 'posted'"
                            groups="sedar_marine_maintenance.group_marine_maintenance_manager"
                            confirm="Posting adds these hours to each engine's running hours and cannot be undone."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tugboat_id" readonly="state != 'draft'"/>
                            <field name="report_date" readonly="state != 'draft'"/>
                            <field name="watch_start" widget="float_time" readonly="state != 'draft'"/>
                            <field name="watch_stop" widget="float_time" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="prepared_by_id"/>
                            <field name="submitted_by_id"/>
                            <field name="submitted_at"/>
                            <field name="posted_by_id"/>
                            <field name="posted_at"/>
                        </group>
                    </group>
                    <field name="return_reason" invisible="not return_reason"/>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="equipment_id"/>
                            <field name="engine_status"/>
                            <field name="hours_run" widget="float_time"/>
                            <field name="fuel_rob_start"/>
                            <field name="fuel_rob_stop"/>
                            <field name="fuel_consumed"/>
                            <field name="rpm"/>
                            <field name="oil_pressure"/>
                            <field name="water_temp"/>
                            <field name="reading_id" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_daily_engine_reports" model="ir.actions.act_window">
        <field name="name">Daily Engine Reports</field>
        <field name="res_model">sedar.daily.engine.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_daily_engine_report_search"/>
    </record>

    <record id="action_engine_room" model="ir.actions.client">
        <field name="name">Daily Engine Reports</field>
        <field name="tag">sedar_marine_maintenance.engine_room</field>
    </record>

    <menuitem id="menu_daily_engine_reports" name="Daily Engine Reports" parent="menu_marine_maintenance_root" action="action_engine_room" sequence="12"/>
    <menuitem id="menu_daily_engine_report_records" name="Daily Engine Report Records" parent="menu_marine_maintenance_root" action="action_daily_engine_reports" sequence="13" groups="sedar_marine_maintenance.group_marine_maintenance_manager"/>
    <menuitem id="menu_pm_tasks" name="Planned Maintenance" parent="menu_marine_maintenance_root" action="action_pm_tasks" sequence="15"/>
</odoo>
