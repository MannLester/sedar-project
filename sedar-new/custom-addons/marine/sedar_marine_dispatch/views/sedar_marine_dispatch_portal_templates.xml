<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sedar_order_detail_dispatch" name="Marine Service Order Detail with Execution">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
                <div><h2 class="mb-1"><t t-out="order.name"/></h2><p class="text-muted mb-0"><t t-out="order.assisted_vessel_name"/> - <t t-out="order.service_type_id.name"/></p></div>
                <span class="badge text-bg-secondary fs-6" t-field="order.state"/>
            </div>
            <div class="row g-4">
                <div class="col-md-6"><h5>Service</h5><dl class="row"><dt class="col-5">Port</dt><dd class="col-7"><t t-out="order.port_id.name"/></dd><dt class="col-5">Requested Start</dt><dd class="col-7"><span t-field="order.requested_start"/></dd><dt class="col-5">Tugs Requested</dt><dd class="col-7"><t t-out="order.number_of_tugs"/></dd></dl></div>
                <div class="col-md-6"><h5>Pricing</h5><t t-if="order.pricing_status == 'resolved'"><p class="fs-4 mb-1" t-field="order.estimated_amount" t-options="{'widget':'monetary','display_currency':order.currency_id}"/></t><div t-else="" class="alert alert-warning">This request requires commercial pricing review.</div></div>
                <div class="col-12"><h5>Scope of Work</h5><p class="mb-0" t-out="order.scope_of_work"/></div>
            </div>
            <section t-if="operation" class="mt-4 border-top pt-4">
                <h4>Service Execution</h4>
                <div class="row g-3">
                    <div class="col-md-3"><span class="text-muted d-block">Execution Status</span><strong t-field="operation.state"/></div>
                    <div class="col-md-3" t-if="operation.dispatch_time"><span class="text-muted d-block">Dispatched</span><span t-field="operation.dispatch_time"/></div>
                    <div class="col-md-3" t-if="operation.actual_start"><span class="text-muted d-block">Started</span><span t-field="operation.actual_start"/></div>
                    <div class="col-md-3" t-if="operation.actual_end"><span class="text-muted d-block">Completed</span><span t-field="operation.actual_end"/></div>
                </div>
                <div t-if="client_logs" class="mt-3"><h5>Activity Updates</h5><ul class="list-group"><li t-foreach="client_logs" t-as="log" class="list-group-item"><strong t-field="log.event_time"/> - <span t-field="log.event_type"/><div t-field="log.description"/></li></ul></div>
                <div t-if="client_delays" class="mt-3"><h5>Delays</h5><ul class="list-group"><li t-foreach="client_delays" t-as="delay" class="list-group-item"><strong t-field="delay.category"/> - <span t-field="delay.duration_hours"/> hours<div t-field="delay.description"/></li></ul></div>
                <div t-if="operation.state == 'completed' and operation.completion_summary" class="mt-3"><h5>Completion Summary</h5><p t-field="operation.completion_summary"/></div>
            </section>
            <form t-if="order.state == 'quoted'" t-att-action="'/my/sedar/orders/%s/confirm' % order.id" method="post" class="mt-4 border-top pt-4"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="btn btn-primary">Confirm Quotation</button></form>
        </t>
    </template>
</odoo>
