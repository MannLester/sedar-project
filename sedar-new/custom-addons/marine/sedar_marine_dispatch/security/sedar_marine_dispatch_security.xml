<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sedar_dispatch" model="ir.module.category">
        <field name="name">SEDAR Marine Dispatch</field>
        <field name="sequence">25</field>
    </record>
    <record id="privilege_sedar_dispatch" model="res.groups.privilege">
        <field name="name">Marine Dispatch</field>
        <field name="category_id" ref="module_category_sedar_dispatch"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_dispatch_planner" model="res.groups">
        <field name="name">Dispatch Planner</field>
        <field name="privilege_id" ref="privilege_sedar_dispatch"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_dispatcher" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="privilege_id" ref="privilege_sedar_dispatch"/>
        <field name="implied_ids" eval="[Command.link(ref('group_dispatch_planner'))]"/>
    </record>
    <record id="group_dispatch_manager" model="res.groups">
        <field name="name">Dispatch Manager</field>
        <field name="privilege_id" ref="privilege_sedar_dispatch"/>
        <field name="implied_ids" eval="[Command.link(ref('group_dispatcher'))]"/>
    </record>
    <record id="rule_dispatch_operation_company" model="ir.rule">
        <field name="name">Marine operations are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_marine_operation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_operation_tug_company" model="ir.rule">
        <field name="name">Operation tugs are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_marine_operation_tug"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_operation_crew_company" model="ir.rule">
        <field name="name">Operation crew are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_marine_operation_crew"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_operation_log_company" model="ir.rule">
        <field name="name">Operation logs are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_marine_operation_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_operation_delay_company" model="ir.rule">
        <field name="name">Operation delays are limited to allowed companies</field>
        <field name="model_id" ref="model_sedar_marine_operation_delay"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dispatch_portal_operation" model="ir.rule">
        <field name="name">Portal clients see their own operation status</field>
        <field name="model_id" ref="model_sedar_marine_operation"/>
        <field name="domain_force">[('order_id.client_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
    <record id="rule_dispatch_portal_log" model="ir.rule">
        <field name="name">Portal clients see client-visible logs for their operations</field>
        <field name="model_id" ref="model_sedar_marine_operation_log"/>
        <field name="domain_force">[('operation_id.order_id.client_id', '=', user.partner_id.commercial_partner_id.id), ('client_visible', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
    <record id="rule_dispatch_portal_delay" model="ir.rule">
        <field name="name">Portal clients see client-visible delays for their operations</field>
        <field name="model_id" ref="model_sedar_marine_operation_delay"/>
        <field name="domain_force">[('operation_id.order_id.client_id', '=', user.partner_id.commercial_partner_id.id), ('client_visible', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
</odoo>
