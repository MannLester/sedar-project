    <record id="seq_sedar_hsse_training" model="ir.sequence">
        <field name="name">SEDAR HSSE Training</field>
        <field name="code">sedar.hsse.training.record</field>
        <field name="prefix">HSSE/TRN/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
