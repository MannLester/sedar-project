<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_order_form_hsse" model="ir.ui.view">
        <field name="name">sedar.marine.service.order.form.hsse</field>
        <field name="model">sedar.marine.service.order</field>
        <field name="inherit_id" ref="sedar_marine_operations.view_service_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='safety_requirements']" position="after">
                <field name="hsse_exception_count" readonly="1" groups="sedar_hsse.group_sedar_hsse_user"/>
                <field name="hsse_exception_summary" readonly="1" groups="sedar_hsse.group_sedar_hsse_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_tugboat_form_hsse" model="ir.ui.view">
        <field name="name">sedar.tugboat.form.hsse</field>
        <field name="model">sedar.tugboat</field>
        <field name="inherit_id" ref="sedar_marine_operations.view_tugboat_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='availability_status']" position="after">
                <field name="hsse_exception_count" readonly="1" groups="sedar_hsse.group_sedar_hsse_user"/>
                <field name="hsse_exception_summary" readonly="1" groups="sedar_hsse.group_sedar_hsse_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_hsse_incident_search" model="ir.ui.view">
        <field name="name">sedar.hsse.incident.search</field>
        <field name="model">sedar.hsse.incident</field>
        <field name="arch" type="xml">
            <search string="HSSE Incidents">
                <field name="name"/>
                <field name="incident_type"/>
                <field name="severity"/>
                <field name="service_order_id"/>
                <field name="operation_id"/>
                <field name="tugboat_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ['reported', 'investigating', 'action_required'])]"/>
                <filter name="critical" string="High / Critical" domain="[('severity', 'in', ['high', 'critical'])]"/>
                <filter name="group_state" string="Group by Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Group by Type" context="{'group_by': 'incident_type'}"/>
            </search>
        </field>
    </record>

    <record id="view_hsse_incident_list" model="ir.ui.view">
        <field name="name">sedar.hsse.incident.list</field>
        <field name="model">sedar.hsse.incident</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'">
                <field name="name"/>
                <field name="incident_type"/>
                <field name="category"/>
                <field name="severity"/>
                <field name="occurrence_datetime"/>
                <field name="service_order_id"/>
                <field name="tugboat_id"/>
                <field name="open_corrective_action_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hsse_incident_form" model="ir.ui.view">
        <field name="name">sedar.hsse.incident.form</field>
        <field name="model">sedar.hsse.incident</field>
        <field name="arch" type="xml">
            <form string="HSSE Incident">
                <header>
                    <button name="action_start_investigation" type="object" string="Start Investigation" class="btn-primary" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state != 'reported'"/>
                    <button name="action_require_actions" type="object" string="Require Actions" class="btn-primary" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state != 'investigating'"/>
                    <button name="action_verify_close" type="object" string="Verify Close" class="btn-primary" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state not in ['investigating', 'action_required']"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state in ['verified', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="reported,investigating,action_required,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="incident_type"/>
                            <field name="category"/>
                            <field name="severity"/>
                            <field name="occurrence_datetime"/>
                            <field name="reported_by_id"/>
                            <field name="investigator_id"/>
                            <field name="confidential"/>
                        </group>
                        <group>
                            <field name="service_order_id"/>
                            <field name="operation_id"/>
                            <field name="tugboat_id"/>
                            <field name="berth_id"/>
                            <field name="maintenance_request_id"/>
                            <field name="document_request_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report">
                            <field name="summary"/>
                            <field name="immediate_action"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="crew_profile_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Investigation">
                            <field name="investigation_summary"/>
                            <field name="root_cause"/>
                        </page>
                        <page string="Corrective Actions">
                            <field name="open_corrective_action_count" readonly="1"/>
                            <field name="corrective_action_ids">
                                <list editable="bottom" decoration-danger="operational_exception or is_overdue">
                                    <field name="name"/>
                                    <field name="assigned_user_id"/>
                                    <field name="due_date"/>
                                    <field name="severity"/>
                                    <field name="critical_control"/>
                                    <field name="is_overdue"/>
                                    <field name="operational_exception"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hsse_inspection_list" model="ir.ui.view">
        <field name="name">sedar.hsse.inspection.list</field>
        <field name="model">sedar.hsse.inspection</field>
        <field name="arch" type="xml">
            <list decoration-danger="overdue_finding_count &gt; 0">
                <field name="name"/>
                <field name="inspection_type"/>
                <field name="inspection_datetime"/>
                <field name="inspector_id"/>
                <field name="service_order_id"/>
                <field name="tugboat_id"/>
                <field name="finding_count"/>
                <field name="overdue_finding_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hsse_inspection_form" model="ir.ui.view">
        <field name="name">sedar.hsse.inspection.form</field>
        <field name="model">sedar.hsse.inspection</field>
        <field name="arch" type="xml">
            <form string="HSSE Inspection">
                <header>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state != 'draft'"/>
                    <button name="action_verify" type="object" string="Verify" class="btn-primary" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="inspection_type"/>
                            <field name="inspection_datetime"/>
                            <field name="inspector_id"/>
                            <field name="summary"/>
                        </group>
                        <group>
                            <field name="service_order_id"/>
                            <field name="operation_id"/>
                            <field name="tugboat_id"/>
                            <field name="berth_id"/>
                            <field name="maintenance_request_id"/>
                            <field name="document_request_id"/>
                        </group>
                    </group>
                    <field name="finding_ids">
                        <list editable="bottom" decoration-danger="is_overdue">
                            <field name="name"/>
                            <field name="severity"/>
                            <field name="assigned_user_id"/>
                            <field name="due_date"/>
                            <field name="is_overdue"/>
                            <field name="corrective_action_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hsse_risk_assessment_list" model="ir.ui.view">
        <field name="name">sedar.hsse.risk.assessment.list</field>
        <field name="model">sedar.hsse.risk.assessment</field>
        <field name="arch" type="xml">
            <list decoration-danger="residual_risk_level == 'critical'" decoration-warning="residual_risk_level == 'high'">
                <field name="name"/>
                <field name="assessment_date"/>
                <field name="activity"/>
                <field name="hazard"/>
                <field name="owner_id"/>
                <field name="residual_risk_score"/>
                <field name="residual_risk_level"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hsse_risk_assessment_form" model="ir.ui.view">
        <field name="name">sedar.hsse.risk.assessment.form</field>
        <field name="model">sedar.hsse.risk.assessment</field>
        <field name="arch" type="xml">
            <form string="Risk Assessment">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,retired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="assessment_date"/>
                            <field name="activity"/>
                            <field name="hazard"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="likelihood"/>
                            <field name="impact"/>
                            <field name="residual_risk_score" readonly="1"/>
                            <field name="residual_risk_level" readonly="1"/>
                            <field name="service_order_id"/>
                            <field name="tugboat_id"/>
                        </group>
                    </group>
                    <field name="existing_controls"/>
                    <field name="additional_controls"/>
                    <field name="corrective_action_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="assigned_user_id"/>
                            <field name="due_date"/>
                            <field name="severity"/>
                            <field name="critical_control"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hsse_permit_list" model="ir.ui.view">
        <field name="name">sedar.hsse.permit.list</field>
        <field name="model">sedar.hsse.permit</field>
        <field name="arch" type="xml">
            <list decoration-danger="operational_exception">
                <field name="name"/>
                <field name="permit_type"/>
                <field name="permit_number"/>
                <field name="service_order_id"/>
                <field name="tugboat_id"/>
                <field name="valid_until"/>
                <field name="required_for_operations"/>
                <field name="operational_exception"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hsse_permit_form" model="ir.ui.view">
        <field name="name">sedar.hsse.permit.form</field>
        <field name="model">sedar.hsse.permit</field>
        <field name="arch" type="xml">
            <form string="Permit">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="permit_type"/>
                            <field name="permit_number"/>
                            <field name="issuing_authority"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                            <field name="required_for_operations"/>
                        </group>
                        <group>
                            <field name="service_order_id"/>
                            <field name="operation_id"/>
                            <field name="tugboat_id"/>
                            <field name="berth_id"/>
                            <field name="document_request_id"/>
                            <field name="operational_exception" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hsse_corrective_action_list" model="ir.ui.view">
        <field name="name">sedar.hsse.corrective.action.list</field>
        <field name="model">sedar.hsse.corrective.action</field>
        <field name="arch" type="xml">
            <list decoration-danger="operational_exception or is_overdue">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="severity"/>
                <field name="critical_control"/>
                <field name="is_overdue"/>
                <field name="operational_exception"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hsse_corrective_action_form" model="ir.ui.view">
        <field name="name">sedar.hsse.corrective.action.form</field>
        <field name="model">sedar.hsse.corrective.action</field>
        <field name="arch" type="xml">
            <form string="Corrective Action">
                <header>
                    <button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_verify" type="object" string="Verify" class="btn-primary" groups="sedar_hsse.group_sedar_hsse_manager" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,done,verified"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="assigned_user_id"/>
                            <field name="due_date"/>
                            <field name="severity"/>
                            <field name="critical_control"/>
                            <field name="is_overdue" readonly="1"/>
                            <field name="operational_exception" readonly="1"/>
                        </group>
                        <group>
                            <field name="incident_id"/>
                            <field name="inspection_finding_id"/>
                            <field name="risk_assessment_id"/>
                            <field name="meeting_id"/>
                            <field name="completed_by_id" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="verified_by_id" readonly="1"/>
                            <field name="verified_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="completion_note"/>
                    <group>
                        <field name="evidence" filename="evidence_filename"/>
                        <field name="evidence_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hsse_meeting_list" model="ir.ui.view">
        <field name="name">sedar.hsse.meeting.list</field>
        <field name="model">sedar.hsse.meeting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="meeting_type"/>
                <field name="meeting_datetime"/>
                <field name="facilitator_id"/>
                <field name="topic"/>
                <field name="service_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_hsse_meeting_form" model="ir.ui.view">
        <field name="name">sedar.hsse.meeting.form</field>
        <field name="model">sedar.hsse.meeting</field>
        <field name="arch" type="xml">
            <form string="Safety Meeting">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="meeting_type"/>
                            <field name="meeting_datetime"/>
                            <field name="facilitator_id"/>
                            <field name="topic"/>
                        </group>
                        <group>
                            <field name="service_order_id"/>
                            <field name="operation_id"/>
                            <field name="tugboat_id"/>
                            <field name="berth_id"/>
                        </group>
                    </group>
                    <field name="attendee_employee_ids" widget="many2many_tags"/>
                    <field name="minutes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hsse_training_list" model="ir.ui.view">
        <field name="name">sedar.hsse.training.record.list</field>
        <field name="model">sedar.hsse.training.record</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_expired">
                <field name="name"/>
                <field name="course_name"/>
                <field name="training_type"/>
                <field name="employee_id"/>
                <field name="completion_date"/>
                <field name="expiry_date"/>
                <field name="readiness_applicable"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hsse_training_form" model="ir.ui.view">
        <field name="name">sedar.hsse.training.record.form</field>
        <field name="model">sedar.hsse.training.record</field>
        <field name="arch" type="xml">
            <form string="HSSE Training">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_name"/>
                            <field name="training_type"/>
                            <field name="employee_id"/>
                            <field name="crew_profile_id"/>
                        </group>
                        <group>
                            <field name="completion_date"/>
                            <field name="expiry_date"/>
                            <field name="readiness_applicable"/>
                            <field name="document_request_id"/>
                            <field name="is_expired" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hsse_incidents" model="ir.actions.act_window">
        <field name="name">Incidents and Near Misses</field>
        <field name="res_model">sedar.hsse.incident</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hsse_incident_search"/>
    </record>
    <record id="action_hsse_inspections" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">sedar.hsse.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hsse_risk_assessments" model="ir.actions.act_window">
        <field name="name">Risk Assessments</field>
        <field name="res_model">sedar.hsse.risk.assessment</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hsse_permits" model="ir.actions.act_window">
        <field name="name">Permits</field>
        <field name="res_model">sedar.hsse.permit</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hsse_corrective_actions" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">sedar.hsse.corrective.action</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hsse_meetings" model="ir.actions.act_window">
        <field name="name">Safety Meetings</field>
        <field name="res_model">sedar.hsse.meeting</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hsse_training" model="ir.actions.act_window">
        <field name="name">Training Records</field>
        <field name="res_model">sedar.hsse.training.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sedar_hsse_root" name="HSSE" parent="sedar_marine_operations.menu_marine_operations" sequence="85" groups="sedar_hsse.group_sedar_hsse_user"/>
    <menuitem id="menu_hsse_incidents" name="Incidents and Near Misses" parent="menu_sedar_hsse_root" action="action_hsse_incidents" sequence="10"/>
    <menuitem id="menu_hsse_inspections" name="Inspections" parent="menu_sedar_hsse_root" action="action_hsse_inspections" sequence="20"/>
    <menuitem id="menu_hsse_risk_assessments" name="Risk Assessments" parent="menu_sedar_hsse_root" action="action_hsse_risk_assessments" sequence="30"/>
    <menuitem id="menu_hsse_permits" name="Permits" parent="menu_sedar_hsse_root" action="action_hsse_permits" sequence="40"/>
    <menuitem id="menu_hsse_corrective_actions" name="Corrective Actions" parent="menu_sedar_hsse_root" action="action_hsse_corrective_actions" sequence="50"/>
    <menuitem id="menu_hsse_meetings" name="Safety Meetings" parent="menu_sedar_hsse_root" action="action_hsse_meetings" sequence="60"/>
    <menuitem id="menu_hsse_training" name="Training Records" parent="menu_sedar_hsse_root" action="action_hsse_training" sequence="70"/>
</odoo>
