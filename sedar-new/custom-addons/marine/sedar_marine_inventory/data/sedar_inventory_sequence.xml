<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_inventory_issue" model="ir.sequence">
        <field name="name">SEDAR Inventory Issue</field>
        <field name="code">sedar.inventory.issue</field>
        <field name="prefix">SII/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_tug_inventory_movement" model="ir.sequence">
        <field name="name">SEDAR Tug Inventory Movement</field>
        <field name="code">sedar.tug.inventory.movement</field>
        <field name="prefix">TIM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
