<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="service_type_harbor" model="sedar.marine.service.type"><field name="name">Harbor Assistance</field><field name="code">HARBOR</field><field name="pricing_basis">per_tug_hour</field></record>
    <record id="service_type_berthing" model="sedar.marine.service.type"><field name="name">Berthing</field><field name="code">BERTH</field><field name="pricing_basis">per_service</field></record>
    <record id="service_type_unberthing" model="sedar.marine.service.type"><field name="name">Unberthing</field><field name="code">UNBERTH</field><field name="pricing_basis">per_service</field></record>
    <record id="service_type_towage" model="sedar.marine.service.type"><field name="name">Towage</field><field name="code">TOWAGE</field><field name="pricing_basis">per_tug_hour</field><field name="requires_destination">True</field></record>
    <record id="service_type_shifting" model="sedar.marine.service.type"><field name="name">Vessel Shifting</field><field name="code">SHIFT</field><field name="pricing_basis">per_service</field><field name="requires_destination">True</field></record>
    <record id="service_type_escort" model="sedar.marine.service.type"><field name="name">Escort</field><field name="code">ESCORT</field><field name="pricing_basis">per_tug_hour</field></record>
