    <record id="berth_batangas_anchorage" model="sedar.marine.berth"><field name="name">Batangas Anchorage</field><field name="code">BTG-ANC</field><field name="port_id" ref="port_batangas"/></record>
    <record id="berth_batangas_base" model="sedar.marine.berth"><field name="name">SEDAR Base</field><field name="code">BTG-SEDAR</field><field name="port_id" ref="port_batangas"/></record>
    <record id="tug_class_standard" model="sedar.tug.class"><field name="name">Standard Harbor Tug</field><field name="minimum_bollard_pull">30</field></record>
    <record id="tug_class_high_power" model="sedar.tug.class"><field name="name">High-Power Tug</field><field name="minimum_bollard_pull">50</field></record>
