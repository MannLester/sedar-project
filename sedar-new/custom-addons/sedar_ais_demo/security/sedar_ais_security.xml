<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_sedar_ais" model="res.groups.privilege">
        <field name="name">Fleet Monitoring</field>
        <field name="category_id" ref="sedar_marine_operations.module_category_sedar_marine"/>
        <field name="sequence">35</field>
    </record>
    <record id="group_sedar_ais_user" model="res.groups">
        <field name="name">AIS Fleet Monitoring User</field>
        <field name="privilege_id" ref="privilege_sedar_ais"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_sedar_ais_manager" model="res.groups">
        <field name="name">AIS Simulation Manager</field>
        <field name="privilege_id" ref="privilege_sedar_ais"/>
        <field name="implied_ids" eval="[Command.link(ref('group_sedar_ais_user')), Command.link(ref('sedar_marine_operations.group_operations_manager'))]"/>
    </record>
</odoo>
