<odoo>
    <record id="view_sedar_dashboard_metric_kanban" model="ir.ui.view">
        <field name="name">sedar.dashboard.metric.kanban</field>
        <field name="model">sedar.dashboard.metric</field>
        <field name="arch" type="xml">
            <kanban default_group_by="module_area">
                <field name="name"/>
                <field name="value"/>
                <field name="unit"/>
                <field name="status"/>
                <field name="module_area"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_#{record.status.raw_value}">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="fs-2 fw-bold mt-2">
                                <field name="value"/>
                                <span class="fs-5 text-muted"><field name="unit"/></span>
                            </div>
                            <div class="mt-2">
                                <span>Status: <field name="status"/></span>
                            </div>
                            <div class="text-muted mt-2">
                                <field name="note"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sedar_dashboard_metric_list" model="ir.ui.view">
        <field name="name">sedar.dashboard.metric.list</field>
