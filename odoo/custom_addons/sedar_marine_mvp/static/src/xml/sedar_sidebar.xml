<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sedar_marine_mvp.NavBarSidebar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[contains(@class, 'o_main_navbar')]" position="after">
            <aside class="o_sedar_sidebar d-print-none">
                <div class="o_sedar_sidebar_brand">
                    <div class="o_sedar_brand_logo"><img src="/sedar_marine_mvp/static/src/img/sedar-logo-wide.png" alt="SEDAR Tug Services Corp."/></div>
                </div>

                <nav class="o_sedar_sidebar_nav" aria-label="SEDAR navigation">
                    <div class="o_sedar_nav_group">
                        <div class="o_sedar_nav_heading">Command Center</div>
                        <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                            <a t-if="app.xmlid and app.xmlid.startsWith('sedar_marine_mvp.') and app.name === 'Management Dashboard'"
                                t-att-href="getMenuItemHref(app)"
                                t-att-data-menu-xmlid="app.xmlid"
                                t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                <i class="fa fa-th-large"/>
                                <span t-esc="app.name"/>
                            </a>
                        </t>
                    </div>

                    <div class="o_sedar_nav_group">
                        <div class="o_sedar_nav_heading">Operations and Assets</div>
                        <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                            <a t-if="app.xmlid and app.xmlid.startsWith('sedar_marine_mvp.') and ['Tug Operations', 'Technical and Maintenance'].includes(app.name)"
                                t-att-href="getMenuItemHref(app)"
                                t-att-data-menu-xmlid="app.xmlid"
                                t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                <i t-if="app.name === 'Tug Operations'" class="fa fa-ship"/>
                                <i t-if="app.name === 'Technical and Maintenance'" class="fa fa-wrench"/>
                                <span t-esc="app.name"/>
                            </a>
                        </t>
                    </div>

                    <div class="o_sedar_nav_group">
                        <div class="o_sedar_nav_heading">People and Safety</div>
                        <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                            <a t-if="app.xmlid and app.xmlid.startsWith('sedar_marine_mvp.') and ['Crewing', 'Human Resources', 'Health, Safety, Security and Environment'].includes(app.name)"
                                t-att-href="getMenuItemHref(app)"
                                t-att-data-menu-xmlid="app.xmlid"
                                t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                <i t-if="app.name === 'Crewing'" class="fa fa-users"/>
                                <i t-if="app.name === 'Human Resources'" class="fa fa-user"/>
                                <i t-if="app.name === 'Health, Safety, Security and Environment'" class="fa fa-shield"/>
                                <span t-esc="app.name"/>
                            </a>
                        </t>
                    </div>

                    <div class="o_sedar_nav_group">
                        <div class="o_sedar_nav_heading">Resources and Finance</div>
                        <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                            <a t-if="app.xmlid and (app.xmlid.startsWith('sedar_marine_mvp.') or app.xmlid.startsWith('sedar_marketing.') or app.xmlid.startsWith('sedar_procurement.')) and ['Finance and Accounting', 'Procurement', 'Inventory Management', 'Marketing'].includes(app.name)"
                                t-att-href="getMenuItemHref(app)"
                                t-att-data-menu-xmlid="app.xmlid"
                                t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                <i t-if="app.name === 'Finance and Accounting'" class="fa fa-money"/>
                                <i t-if="app.name === 'Procurement'" class="fa fa-shopping-cart"/>
                                <i t-if="app.name === 'Inventory Management'" class="fa fa-archive"/>
                                <i t-if="app.name === 'Marketing'" class="fa fa-bullhorn"/>
                                <span t-esc="app.name"/>
                            </a>
                        </t>
                    </div>

                    <div class="o_sedar_nav_group">
                        <div class="o_sedar_nav_heading">System and Compliance</div>
                        <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                            <a t-if="app.xmlid and app.xmlid.startsWith('sedar_marine_mvp.') and ['Document Control', 'Corporate Management'].includes(app.name)"
                                t-att-href="getMenuItemHref(app)"
                                t-att-data-menu-xmlid="app.xmlid"
                                t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                <i t-if="app.name === 'Document Control'" class="fa fa-file-text"/>
                                <i t-if="app.name === 'Corporate Management'" class="fa fa-briefcase"/>
                                <span t-esc="app.name"/>
                            </a>
                        </t>
                    </div>
                </nav>

                <div class="o_sedar_sidebar_footer">
                    <div class="o_sedar_user_avatar"><img src="/sedar_marine_mvp/static/src/img/sedar-logo-mark.png" alt="SEDAR"/></div>
                    <div>
                        <div class="o_sedar_user_name">SEDAR MVP</div>
                        <div class="o_sedar_user_role">Marine Operations</div>
                    </div>
                </div>
            </aside>
        </xpath>
    </t>
</templates>
