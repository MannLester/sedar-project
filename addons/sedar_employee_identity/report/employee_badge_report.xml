<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sedar_employee_badge_report" model="ir.actions.report">
        <field name="name">Employee Badge</field>
        <field name="model">hr.employee.public</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sedar_employee_identity.report_employee_badge</field>
        <field name="report_file">sedar_employee_identity.report_employee_badge</field>
        <field name="print_report_name">'Employee Badge - %s' % (object.name)</field>
    </record>

    <template id="report_employee_badge">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="employee">
                <div class="page" style="font-family: Arial, sans-serif; padding: 24px;">
                    <div style="width: 340px; border: 1px solid #b8c7ca; border-radius: 8px; overflow: hidden;">
                        <div style="background: #0f3b4a; color: #ffffff; padding: 14px 18px;">
                            <div style="font-size: 12px; font-weight: 700; letter-spacing: 0; text-transform: uppercase;">SEDAR</div>
                            <div style="font-size: 20px; font-weight: 700; margin-top: 4px;">Employee Identification</div>
                        </div>
                        <div style="padding: 18px;">
                            <div style="font-size: 22px; font-weight: 700; line-height: 1.2;" t-esc="employee.name"/>
                            <div style="color: #42575b; margin-top: 6px;" t-esc="employee.sedar_crew_rank or employee.job_title or 'Employee'"/>
                            <div style="border-top: 1px solid #d8e1e3; margin: 16px 0; padding-top: 14px;">
                                <div style="font-size: 11px; color: #5d7478; text-transform: uppercase;">Employee ID</div>
                                <div style="font-size: 18px; font-weight: 700;" t-esc="employee.sedar_employee_code"/>
                            </div>
                            <div style="display: table; width: 100%;">
                                <div style="display: table-cell; vertical-align: top; width: 126px;">
                                    <img t-att-src="'/report/barcode/QR/%s?width=120&amp;height=120' % employee.sedar_barcode_value" style="display: block; height: 120px; width: 120px;"/>
                                </div>
                                <div style="display: table-cell; vertical-align: top; padding-left: 12px;">
                                    <div style="font-size: 11px; color: #5d7478; text-transform: uppercase;">Current Boat</div>
                                    <div style="font-weight: 700; margin-bottom: 10px;" t-esc="employee.sedar_current_vessel_id.display_name if employee.sedar_current_vessel_id else 'Not assigned'"/>
                                    <div style="font-size: 11px; color: #5d7478; text-transform: uppercase;">Department</div>
                                    <div style="font-weight: 700;" t-esc="employee.department_id.display_name if employee.department_id else 'Not assigned'"/>
                                </div>
                            </div>
                            <div style="margin-top: 16px;">
                                <img t-att-src="'/report/barcode/Code128/%s?width=300&amp;height=56&amp;humanreadable=1' % employee.sedar_barcode_value" style="display: block; height: 56px; max-width: 300px;"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
