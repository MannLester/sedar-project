<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="maintenance_stage_waiting_parts" model="maintenance.stage">
        <field name="name">Waiting for Parts</field>
        <field name="sequence">2</field>
        <field name="done">False</field>
    </record>
    <record id="cron_generate_due_maintenance_work" model="ir.cron">
        <field name="name">SEDAR: Generate Due Maintenance Work</field>
        <field name="model_id" ref="model_sedar_maintenance_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_due_work_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
