<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_near_miss_workflow" model="ir.ui.view">
        <field name="name">sedar.hsse.near.miss.workflow</field>
        <field name="model">sedar.hsse.near.miss</field>
        <field name="inherit_id" ref="sedar_hsse.view_sedar_hsse_near_miss_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_review" string="Start Review" type="object" class="oe_highlight" invisible="state != 'reported'"/>
                    <button name="action_require_action" string="Require Action" type="object" invisible="state != 'review'"/>
                    <button name="action_close" string="Close" type="object" class="oe_highlight" invisible="state not in ['review', 'action']"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
            </xpath>
            <field name="reporter_id" position="after"><field name="owner_id"/><field name="job_order_id"/></field>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Corrective Actions">
                        <field name="action_ids">
                            <tree editable="bottom">
                                <field name="name"/><field name="owner_id"/><field name="due_date"/><field name="state"/><field name="overdue"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_inspection_workflow" model="ir.ui.view">
        <field name="name">sedar.hsse.inspection.workflow</field>
        <field name="model">sedar.hsse.inspection</field>
        <field name="inherit_id" ref="sedar_hsse.view_sedar_hsse_inspection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_start" string="Start Inspection" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_finish" string="Finish Checklist" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_close" string="Close Actions" type="object" class="oe_highlight" invisible="state != 'action'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar"/>
                </header>
            </xpath>
            <field name="vessel_id" position="after"><field name="job_order_id"/><field name="failed_count" readonly="1"/></field>
            <xpath expr="//notebook" position="inside">
                <page string="Corrective Actions" invisible="not action_ids">
                    <field name="action_ids">
                        <tree editable="bottom">
                            <field name="name"/><field name="owner_id"/><field name="due_date"/><field name="state"/><field name="overdue"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_risk_workflow" model="ir.ui.view">
        <field name="name">sedar.hsse.risk.assessment.workflow</field>
        <field name="model">sedar.hsse.risk.assessment</field>
        <field name="inherit_id" ref="sedar_hsse.view_sedar_hsse_risk_assessment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_submit" string="Submit for Review" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'review'"/>
                    <button name="action_mark_mitigated" string="Mark Mitigated" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
            </xpath>
            <field name="activity" position="before"><field name="vessel_id"/><field name="job_order_id"/><field name="owner_id"/></field>
            <field name="risk_score" position="after"><field name="risk_level" widget="badge"/></field>
            <field name="mitigation" position="after">
                <field name="residual_likelihood"/><field name="residual_severity"/><field name="residual_score" readonly="1"/>
            </field>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Control Actions">
                        <field name="action_ids">
                            <tree editable="bottom">
                                <field name="name"/><field name="owner_id"/><field name="due_date"/><field name="state"/><field name="overdue"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_permit_workflow" model="ir.ui.view">
        <field name="name">sedar.hsse.permit.workflow</field>
        <field name="model">sedar.hsse.permit</field>
        <field name="inherit_id" ref="sedar_hsse.view_sedar_hsse_permit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_start_renewal" string="Start Renewal" type="object" class="oe_highlight" invisible="state not in ['valid', 'expired']"/>
                    <button name="action_submit_review" string="Submit for Review" type="object" class="oe_highlight" invisible="state != 'renewal'"/>
                    <button name="action_approve_renewal" string="Approve Renewal" type="object" class="oe_highlight" invisible="state != 'review'"/>
                    <field name="state" widget="statusbar"/>
                </header>
            </xpath>
            <field name="expiry_status" position="after">
                <field name="renewal_owner_id"/><field name="attachment" filename="attachment_name"/><field name="attachment_name" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_corrective_action_tree" model="ir.ui.view">
        <field name="name">sedar.hsse.corrective.action.tree</field>
        <field name="model">sedar.hsse.corrective.action</field>
        <field name="arch" type="xml">
            <tree decoration-danger="overdue" decoration-muted="state == 'done'">
                <field name="name"/><field name="source_name"/><field name="vessel_id"/><field name="owner_id"/><field name="due_date"/><field name="state"/><field name="overdue"/>
            </tree>
        </field>
    </record>
    <record id="view_corrective_action_form" model="ir.ui.view">
        <field name="name">sedar.hsse.corrective.action.form</field>
        <field name="model">sedar.hsse.corrective.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state != 'open'"/>
                    <button name="action_done" string="Complete" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet><group><field name="name"/><field name="source_name" readonly="1"/><field name="vessel_id" readonly="1"/><field name="owner_id"/><field name="due_date"/><field name="overdue"/><field name="notes"/><field name="completion_note"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_corrective_actions" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field><field name="res_model">sedar.hsse.corrective.action</field><field name="view_mode">tree,form</field>
    </record>

    <record id="view_training_tree" model="ir.ui.view">
        <field name="name">sedar.hsse.training.tree</field><field name="model">sedar.hsse.training</field>
        <field name="arch" type="xml"><tree><field name="training_date"/><field name="name"/><field name="training_type"/><field name="vessel_id"/><field name="trainer"/><field name="state"/><field name="expiry_status"/></tree></field>
    </record>
    <record id="view_training_form" model="ir.ui.view">
        <field name="name">sedar.hsse.training.form</field><field name="model">sedar.hsse.training</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_complete" string="Complete Training" type="object" class="oe_highlight" invisible="state != 'planned'"/><button name="action_cancel" string="Cancel" type="object" invisible="state != 'planned'"/><button name="action_reset_planned" string="Reset to Planned" type="object" invisible="state == 'planned'"/><field name="state" widget="statusbar"/></header>
                <sheet><group><field name="name"/><field name="training_type"/><field name="vessel_id"/><field name="trainer"/><field name="training_date"/><field name="expiry_date"/><field name="expiry_status"/><field name="attendee_ids" widget="many2many_tags"/><field name="attachment" filename="attachment_name"/><field name="attachment_name" invisible="1"/><field name="notes"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_hsse_training" model="ir.actions.act_window">
        <field name="name">Training Records</field><field name="res_model">sedar.hsse.training</field><field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_corrective_actions" name="Corrective Actions" parent="sedar_hsse.menu_root" action="action_corrective_actions" sequence="60"/>
    <menuitem id="menu_hsse_training" name="Training Records" parent="sedar_hsse.menu_root" action="action_hsse_training" sequence="70"/>
</odoo>
