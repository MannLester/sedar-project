<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_document_control_register" model="ir.ui.view">
        <field name="name">sedar.document.control.register</field>
        <field name="model">sedar.document.control</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <tree class="o_sedar_document_register" default_order="expiry_date asc, name asc" decoration-warning="status == 'renewal'" decoration-danger="status == 'expired'">
                <field name="name"/>
                <field name="document_type" widget="badge"/>
                <field name="owner_department"/>
                <field name="vessel_id"/>
                <field name="expiry_date"/>
                <field name="status" widget="badge"/>
                <field name="approval_status" widget="badge" optional="hide"/>
                <field name="document_link" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_document_control_search" model="ir.ui.view">
        <field name="name">sedar.document.control.search</field>
        <field name="model">sedar.document.control</field>
        <field name="inherit_id" eval="False"/>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_type"/>
                <field name="owner_department"/>
                <field name="vessel_id"/>
                <field name="renewal_owner"/>
                <filter name="documents_for_renewal" string="For Renewal" domain="[('status', '=', 'renewal')]"/>
                <filter name="valid_documents" string="Valid" domain="[('status', '=', 'valid')]"/>
                <filter name="expired_documents" string="Expired" domain="[('status', '=', 'expired')]"/>
                <separator/>
                <filter name="vessel_certificates" string="Vessel Certificates" domain="[('document_type', '=', 'vessel_certificate')]"/>
                <filter name="contracts" string="Contracts" domain="[('document_type', '=', 'contract')]"/>
                <filter name="permits" string="Permits" domain="[('document_type', '=', 'permit')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_document_type" string="Document Type" context="{'group_by': 'document_type'}"/>
                    <filter name="group_by_owner_department" string="Owner Department" context="{'group_by': 'owner_department'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_vessel" string="Vessel" context="{'group_by': 'vessel_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_document_control_workflow" model="ir.ui.view">
        <field name="name">sedar.document.control.workflow</field>
        <field name="model">sedar.document.control</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <form class="o_sedar_document_form">
                <header>
                    <button name="action_submit_review" string="Submit for Review" type="object" class="oe_highlight" invisible="approval_status != 'draft'"/>
                    <button name="action_approve_document" string="Approve" type="object" class="oe_highlight" invisible="approval_status != 'for_review'"/>
                    <button name="action_reject_document" string="Return to Draft" type="object" invisible="approval_status != 'for_review'"/>
                    <button name="action_start_renewal" string="Start New Version" type="object" class="oe_highlight" invisible="approval_status != 'approved'"/>
                    <field name="approval_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="document_type"/>
                            <field name="owner_department"/>
                            <field name="vessel_id"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="renewal_due_date"/>
                            <field name="status"/>
                            <field name="document_link"/>
                        </group>
                    </group>
                    <group string="Review">
                        <group>
                            <field name="owner_id"/>
                            <field name="renewal_owner"/>
                            <field name="reviewer_id"/>
                            <field name="approval_date"/>
                            <field name="previous_version_id"/>
                        </group>
                        <group>
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                            <field name="workflow_notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_control_register" model="ir.actions.act_window">
        <field name="name">Controlled Documents</field>
        <field name="res_model">sedar.document.control</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_document_control_register"/>
        <field name="search_view_id" ref="view_document_control_search"/>
    </record>

    <record id="action_document_control_register_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_document_control_register"/>
        <field name="act_window_id" ref="action_document_control_register"/>
    </record>

    <record id="action_document_control_register_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_document_control_workflow"/>
        <field name="act_window_id" ref="action_document_control_register"/>
    </record>
</odoo>
