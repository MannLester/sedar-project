    </record>

    <record id="overview_applications" model="sedar.job.hiring.overview">
        <field name="name">Job Applications</field>
        <field name="sequence">20</field>
        <field name="icon">fa-file-text</field>
        <field name="description">New applicants with skills, requirements, and submitted documents for screening.</field>
        <field name="action_xmlid">sedar_recruitment_link.action_sedar_job_applications</field>
    </record>

