<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sedar_job_hiring_overview_kanban" model="ir.ui.view">
        <field name="name">sedar.job.hiring.overview.kanban</field>
        <field name="model">sedar.job.hiring.overview</field>
        <field name="arch" type="xml">
            <kanban class="o_sedar_job_hiring_overview" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="description"/>
                <field name="icon"/>
                <field name="record_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_sedar_hiring_card">
                            <button type="object" name="action_open_target" class="o_sedar_hiring_card_button">
                                <div class="o_sedar_hiring_card_icon">
                                    <i t-att-class="'fa ' + record.icon.raw_value"/>
                                </div>
                                <div class="o_sedar_hiring_card_body">
                                    <strong><field name="name"/></strong>
                                    <span><field name="description"/></span>
                                </div>
                                <div class="o_sedar_hiring_card_count">
                                    <field name="record_count"/>
                                </div>
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_sedar_job_hiring_overview" model="ir.actions.act_window">
        <field name="name">Job Hiring</field>
        <field name="res_model">sedar.job.hiring.overview</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_sedar_job_hiring_overview_kanban"/>
        <field name="target">current</field>
    </record>
</odoo>
