<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Petty cash setup -->
  <record id="view_expense_category_tree" model="ir.ui.view">
    <field name="name">sedar.finance.expense.category.tree</field>
    <field name="model">sedar.finance.expense.category</field>
    <field name="arch" type="xml">
      <tree class="o_sedar_finance_list">
        <field name="name"/>
        <field name="account_id"/>
        <field name="company_id"/>
        <field name="active"/>
      </tree>
    </field>
  </record>
  <record id="view_expense_category_form" model="ir.ui.view">
    <field name="name">sedar.finance.expense.category.form</field>
    <field name="model">sedar.finance.expense.category</field>
    <field name="arch" type="xml">
      <form class="o_sedar_finance_form">
        <sheet>
          <group>
            <field name="name"/>
            <field name="account_id" options="{'no_create': True}"/>
            <field name="company_id"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_expense_category" model="ir.actions.act_window">
    <field name="name">Expense Categories</field>
    <field name="res_model">sedar.finance.expense.category</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_expense_category_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_expense_category_form')})]"/>
  </record>
  <record id="view_petty_fund_tree" model="ir.ui.view">
    <field name="name">sedar.finance.petty.fund.tree</field>
    <field name="model">sedar.finance.petty.fund</field>
    <field name="arch" type="xml">
      <tree class="o_sedar_finance_list">
        <field name="name"/>
        <field name="journal_id"/>
        <field name="account_id"/>
        <field name="advance_account_id"/>
        <field name="company_id"/>
        <field name="active"/>
      </tree>
    </field>
  </record>
  <record id="view_petty_fund_form" model="ir.ui.view">
    <field name="name">sedar.finance.petty.fund.form</field>
    <field name="model">sedar.finance.petty.fund</field>
    <field name="arch" type="xml">
      <form class="o_sedar_finance_form">
        <sheet>
          <group>
            <field name="name"/>
            <field name="journal_id" options="{'no_create': True}"/>
            <field name="account_id" options="{'no_create': True}"/>
            <field name="advance_account_id" options="{'no_create': True}"/>
            <field name="company_id"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_petty_fund" model="ir.actions.act_window">
    <field name="name">Petty Cash Funds</field>
    <field name="res_model">sedar.finance.petty.fund</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_petty_fund_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_petty_fund_form')})]"/>
  </record>
  <!-- Petty cash transactions -->
  <record id="view_petty_cash_search" model="ir.ui.view">
    <field name="name">sedar.finance.petty.cash.search</field>
    <field name="model">sedar.finance.petty.cash</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="date"/>
        <field name="employee_id"/>
        <field name="partner_id"/>
        <field name="vessel_id"/>
        <field name="job_order_id"/>
        <field name="state"/>
        <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
        <group expand="0" string="Group By">
          <filter string="Date" name="date_group" context="{'group_by':'date'}"/>
          <filter string="Employee" name="employee_group" context="{'group_by':'employee_id'}"/>
          <filter string="State" name="state_group" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_petty_cash_tree" model="ir.ui.view">
    <field name="name">sedar.finance.petty.cash.tree</field>
    <field name="model">sedar.finance.petty.cash</field>
    <field name="arch" type="xml">
      <tree class="o_sedar_finance_list">
        <field name="name"/>
        <field name="date"/>
        <field name="category_id"/>
        <field name="employee_id"/>
        <field name="partner_id"/>
        <field name="fund_id"/>
        <field name="vessel_id" optional="hide"/>
        <field name="job_order_id" optional="hide"/>
        <field name="amount" sum="Total"/>
        <field name="state"/>
      </tree>
    </field>
  </record>
  <record id="view_petty_cash_form" model="ir.ui.view">
    <field name="name">sedar.finance.petty.cash.form</field>
    <field name="model">sedar.finance.petty.cash</field>
    <field name="arch" type="xml">
      <form class="o_sedar_finance_form">
        <header>
          <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state not in ('draft','rejected')"/>
          <button name="action_approve" string="Approve and Post" type="object" class="btn-primary" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <button name="action_reject" string="Reject" type="object" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="date"/>
              <field name="category_id"/>
              <field name="fund_id"/>
              <field name="amount"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group>
              <field name="partner_id"/>
              <field name="employee_id"/>
              <field name="vessel_id"/>
              <field name="job_order_id"/>
              <field name="maintenance_request_id"/>
            </group>
          </group>
          <group>
            <field name="description"/>
            <field name="move_id" readonly="1"/>
            <field name="company_id"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_petty_cash" model="ir.actions.act_window">
    <field name="name">Petty Cash Expenses</field>
    <field name="res_model">sedar.finance.petty.cash</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_petty_cash_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_petty_cash_form')})]"/>
    <field name="search_view_id" ref="view_petty_cash_search"/>
  </record>
  <!-- Advances and liquidations -->
  <record id="view_cash_advance_search" model="ir.ui.view">
    <field name="name">sedar.finance.cash.advance.search</field>
    <field name="model">sedar.finance.cash.advance</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="date"/>
        <field name="employee_id"/>
        <field name="fund_id"/>
        <field name="state"/>
        <filter string="Outstanding" name="outstanding" domain="[('state','in',('released','partial'))]"/>
        <group expand="0" string="Group By">
          <filter string="Employee" name="employee_group" context="{'group_by':'employee_id'}"/>
          <filter string="Date" name="date_group" context="{'group_by':'date'}"/>
          <filter string="State" name="state_group" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_cash_advance_tree" model="ir.ui.view">
    <field name="name">sedar.finance.cash.advance.tree</field>
    <field name="model">sedar.finance.cash.advance</field>
    <field name="arch" type="xml">
      <tree class="o_sedar_finance_list">
        <field name="name"/>
        <field name="date"/>
        <field name="employee_id"/>
        <field name="purpose"/>
        <field name="fund_id"/>
        <field name="amount" sum="Total"/>
        <field name="outstanding_amount" sum="Outstanding"/>
        <field name="state"/>
      </tree>
    </field>
  </record>
  <record id="view_cash_advance_form" model="ir.ui.view">
    <field name="name">sedar.finance.cash.advance.form</field>
    <field name="model">sedar.finance.cash.advance</field>
    <field name="arch" type="xml">
      <form class="o_sedar_finance_form">
        <header>
          <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state not in ('draft','rejected')"/>
          <button name="action_approve" string="Approve" type="object" class="btn-primary" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <button name="action_release" string="Release and Post" type="object" class="btn-primary" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'approved'"/>
          <button name="action_reject" string="Reject" type="object" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,released,partial,liquidated,rejected"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="purpose"/>
              <field name="date"/>
              <field name="fund_id"/>
            </group>
            <group>
              <field name="advance_account_id" groups="sedar_finance_operations.group_finance_officer" options="{'no_create': True}"/>
              <field name="amount"/>
              <field name="currency_id" invisible="1"/>
              <field name="liquidated_amount" readonly="1"/>
              <field name="outstanding_amount" readonly="1"/>
              <field name="move_id" readonly="1"/>
              <field name="company_id"/>
            </group>
          </group>
          <notebook>
            <page string="Liquidations">
              <field name="liquidation_ids" readonly="1">
                <tree>
                  <field name="name"/>
                  <field name="date"/>
                  <field name="expense_amount"/>
                  <field name="cash_returned"/>
                  <field name="total_settlement"/>
                  <field name="state"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_cash_advance" model="ir.actions.act_window">
    <field name="name">Employee Cash Advances</field>
    <field name="res_model">sedar.finance.cash.advance</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_cash_advance_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_cash_advance_form')})]"/>
    <field name="search_view_id" ref="view_cash_advance_search"/>
  </record>
  <record id="view_liquidation_search" model="ir.ui.view">
    <field name="name">sedar.finance.advance.liquidation.search</field>
    <field name="model">sedar.finance.advance.liquidation</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="date"/>
        <field name="employee_id"/>
        <field name="advance_id"/>
        <field name="vessel_id"/>
        <field name="job_order_id"/>
        <field name="state"/>
        <group expand="0" string="Group By">
          <filter string="Employee" name="employee_group" context="{'group_by':'employee_id'}"/>
          <filter string="Date" name="date_group" context="{'group_by':'date'}"/>
          <filter string="State" name="state_group" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_liquidation_tree" model="ir.ui.view">
    <field name="name">sedar.finance.advance.liquidation.tree</field>
    <field name="model">sedar.finance.advance.liquidation</field>
    <field name="arch" type="xml">
      <tree class="o_sedar_finance_list">
        <field name="name"/>
        <field name="date"/>
        <field name="employee_id"/>
        <field name="advance_id"/>
        <field name="expense_amount" sum="Expenses"/>
        <field name="cash_returned" sum="Cash Returned"/>
        <field name="total_settlement" sum="Total"/>
        <field name="state"/>
      </tree>
    </field>
  </record>
  <record id="view_liquidation_form" model="ir.ui.view">
    <field name="name">sedar.finance.advance.liquidation.form</field>
    <field name="model">sedar.finance.advance.liquidation</field>
    <field name="arch" type="xml">
      <form class="o_sedar_finance_form">
        <header>
          <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state not in ('draft','rejected')"/>
          <button name="action_approve" string="Approve and Post" type="object" class="btn-primary" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <button name="action_reject" string="Reject" type="object" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="advance_id" domain="[('state','in',('released','partial'))]"/>
              <field name="employee_id"/>
              <field name="date"/>
              <field name="advance_outstanding"/>
              <field name="fund_id"/>
            </group>
            <group>
              <field name="vessel_id"/>
              <field name="job_order_id"/>
              <field name="maintenance_request_id"/>
              <field name="cash_returned"/>
              <field name="expense_amount"/>
              <field name="total_settlement"/>
              <field name="currency_id" invisible="1"/>
              <field name="company_id" invisible="1"/>
              <field name="move_id" readonly="1"/>
            </group>
          </group>
          <field name="line_ids">
            <tree editable="bottom">
              <field name="category_id"/>
              <field name="description"/>
              <field name="amount" sum="Total"/>
              <field name="currency_id" column_invisible="True"/>
              <field name="company_id" column_invisible="True"/>
            </tree>
          </field>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_liquidation" model="ir.actions.act_window">
    <field name="name">Advance Liquidations</field>
    <field name="res_model">sedar.finance.advance.liquidation</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_liquidation_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_liquidation_form')})]"/>
    <field name="search_view_id" ref="view_liquidation_search"/>
  </record>
  <!-- Disbursements -->
  <record id="view_disbursement_search" model="ir.ui.view">
    <field name="name">sedar.finance.disbursement.search</field>
    <field name="model">sedar.finance.disbursement</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="date"/>
        <field name="supplier_id"/>
        <field name="purchase_id"/>
        <field name="journal_id"/>
        <field name="vessel_id"/>
        <field name="job_order_id"/>
        <field name="state"/>
        <filter string="Outstanding Checks" name="outstanding" domain="[('check_status','in',('outstanding','stale'))]"/>
        <group expand="0" string="Group By">
          <filter string="Supplier" name="supplier_group" context="{'group_by':'supplier_id'}"/>
          <filter string="PO" name="po_group" context="{'group_by':'purchase_id'}"/>
          <filter string="Journal" name="journal_group" context="{'group_by':'journal_id'}"/>
          <filter string="State" name="state_group" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_disbursement_tree" model="ir.ui.view">
    <field name="name">sedar.finance.disbursement.tree</field>
    <field name="model">sedar.finance.disbursement</field>
    <field name="arch" type="xml">
      <tree class="o_sedar_finance_list">
        <field name="name"/>
        <field name="date"/>
        <field name="purchase_id"/>
        <field name="supplier_id"/>
        <field name="journal_id"/>
        <field name="payment_type"/>
        <field name="check_number" optional="show"/>
        <field name="amount" sum="Total"/>
        <field name="check_status"/>
        <field name="state"/>
      </tree>
    </field>
  </record>
  <record id="view_disbursement_form" model="ir.ui.view">
    <field name="name">sedar.finance.disbursement.form</field>
    <field name="model">sedar.finance.disbursement</field>
    <field name="arch" type="xml">
      <form class="o_sedar_finance_form">
        <header>
          <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state not in ('draft','rejected')"/>
          <button name="action_approve" string="Approve" type="object" class="btn-primary" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <button name="action_release" string="Release Payment" type="object" class="btn-primary" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'approved'"/>
          <button name="action_mark_cleared" string="Mark Cleared" type="object" invisible="state != 'released' or payment_type != 'check' or check_status != 'outstanding'"/>
          <button name="action_mark_stale" string="Mark Stale" type="object" invisible="state != 'released' or payment_type != 'check' or check_status != 'outstanding'"/>
          <button name="action_void" string="Void Check" type="object" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'released' or payment_type != 'check' or check_status == 'cleared'"/>
          <button name="action_reject" string="Reject" type="object" groups="sedar_finance_operations.group_finance_manager" invisible="state != 'submitted'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,released,void,rejected"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="purchase_id" domain="[('state','in',('purchase','done'))]"/>
              <field name="bill_id" domain="[('move_type','=','in_invoice'),('state','=','posted'),('payment_state','!=','paid'),('invoice_line_ids.purchase_line_id.order_id','=',purchase_id)]"/>
              <field name="supplier_id"/>
              <field name="date"/>
              <field name="journal_id"/>
            </group>
            <group>
              <field name="amount"/>
              <field name="currency_id" invisible="1"/>
              <field name="payment_type"/>
              <field name="check_number" invisible="payment_type != 'check'"/>
              <field name="check_date" invisible="payment_type != 'check'"/>
              <field name="check_status" readonly="1"/>
              <field name="clearing_date" readonly="1"/>
              <field name="payment_id" readonly="1"/>
            </group>
          </group>
          <group string="Operations">
            <field name="vessel_id"/>
            <field name="job_order_id"/>
            <field name="maintenance_request_id"/>
            <field name="company_id"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_disbursement" model="ir.actions.act_window">
    <field name="name">Disbursements and Checks</field>
    <field name="res_model">sedar.finance.disbursement</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_disbursement_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_disbursement_form')})]"/>
    <field name="search_view_id" ref="view_disbursement_search"/>
  </record>
  <!-- Collections -->
  <record id="view_collection_search" model="ir.ui.view">
    <field name="name">sedar.finance.collection.search</field>
    <field name="model">sedar.finance.collection</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="deposit_date"/>
        <field name="customer_id"/>
        <field name="invoice_id"/>
        <field name="journal_id"/>
        <field name="state"/>
        <group expand="0" string="Group By">
          <filter string="Client" name="client_group" context="{'group_by':'customer_id'}"/>
          <filter string="Deposit Date" name="date_group" context="{'group_by':'deposit_date'}"/>
          <filter string="Journal" name="journal_group" context="{'group_by':'journal_id'}"/>
          <filter string="State" name="state_group" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_collection_tree" model="ir.ui.view">
    <field name="name">sedar.finance.collection.tree</field>
    <field name="model">sedar.finance.collection</field>
    <field name="arch" type="xml">
      <tree class="o_sedar_finance_list">
        <field name="name"/>
        <field name="deposit_date"/>
        <field name="customer_id"/>
        <field name="invoice_id"/>
        <field name="journal_id"/>
        <field name="method"/>
        <field name="amount" sum="Total"/>
        <field name="state"/>
      </tree>
    </field>
  </record>
  <record id="view_collection_form" model="ir.ui.view">
    <field name="name">sedar.finance.collection.form</field>
    <field name="model">sedar.finance.collection</field>
    <field name="arch" type="xml">
      <form class="o_sedar_finance_form">
        <header>
          <button name="action_confirm" string="Confirm and Register Payment" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_bounce" string="Mark Bounced" type="object" class="btn-secondary" invisible="state != 'confirmed'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,bounced"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="invoice_id"/>
              <field name="customer_id"/>
              <field name="journal_id"/>
              <field name="deposit_date"/>
              <field name="amount"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group>
              <field name="method"/>
              <field name="bank_reference"/>
              <field name="check_number" invisible="method != 'check'"/>
              <field name="payment_id" readonly="1"/>
              <field name="company_id"/>
              <field name="bounced_reason" invisible="state == 'draft'" readonly="state == 'bounced'"/>
              <field name="bounced_date" invisible="state != 'bounced'"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_collection" model="ir.actions.act_window">
    <field name="name">Collections</field>
    <field name="res_model">sedar.finance.collection</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_collection_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_collection_form')})]"/>
    <field name="search_view_id" ref="view_collection_search"/>
  </record>
  <!-- Billing masters, tariffs, rebates -->
  <record id="view_terminal_tree" model="ir.ui.view">
    <field name="name">sedar.finance.terminal.tree</field>
