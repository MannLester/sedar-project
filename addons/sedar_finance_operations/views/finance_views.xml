  <!-- Additive native and operations extensions -->
  <record id="view_job_order_form_finance" model="ir.ui.view">
    <field name="name">sedar.job.order.form.finance</field>
    <field name="model">sedar.job.order</field>
    <field name="inherit_id" ref="sedar_tug_ops.view_sedar_job_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='requested_date']" position="after">
        <field name="terminal_id"/>
        <field name="service_id"/>
        <field name="move_count"/>
        <field name="billable_hours"/>
        <field name="agent_id"/>
      </xpath>
    </field>
  </record>
  <record id="view_towage_billing_form_finance" model="ir.ui.view">
    <field name="name">sedar.towage.billing.form.finance</field>
    <field name="model">sedar.towage.billing</field>
    <field name="inherit_id" ref="sedar_tug_ops.view_sedar_towage_billing_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_create_invoice']" position="attributes">
        <attribute name="string">Confirm and Invoice</attribute>
      </xpath>
      <xpath expr="//field[@name='rate_basis']" position="before">
        <field name="terminal_id"/>
        <field name="service_id"/>
        <field name="agent_id"/>
        <field name="tariff_id" domain="[('state','=','approved'),('client_id','=',customer_id),('terminal_id','=',terminal_id),('service_id','=',service_id)]"/>
      </xpath>
      <xpath expr="//field[@name='rate_basis']" position="attributes">
        <attribute name="readonly">tariff_id</attribute>
        <attribute name="force_save">1</attribute>
      </xpath>
      <xpath expr="//field[@name='rate']" position="attributes">
        <attribute name="readonly">tariff_id</attribute>
        <attribute name="force_save">1</attribute>
      </xpath>
      <xpath expr="//field[@name='amount']" position="after">
        <field name="rebate_rate_id"/>
        <field name="rebate_amount"/>
        <field name="rebate_move_id"/>
      </xpath>
    </field>
  </record>
  <record id="view_account_journal_form_bank_control" model="ir.ui.view">
    <field name="name">account.journal.form.sedar.bank.control</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='type']" position="after">
        <field name="sedar_statement_date" invisible="type not in ('bank','cash')"/>
        <field name="sedar_statement_balance" invisible="type not in ('bank','cash')"/>
        <field name="sedar_posted_book_balance" readonly="1" invisible="type not in ('bank','cash')"/>
        <field name="sedar_outstanding_checks" readonly="1" invisible="type not in ('bank','cash')"/>
        <field name="sedar_available_cash" readonly="1" invisible="type not in ('bank','cash')"/>
      </xpath>
    </field>
  </record>
  <record id="view_account_move_filter_finance" model="ir.ui.view">
    <field name="name">account.move.filter.sedar.finance</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_move_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <field name="sedar_purchase_id"/>
        <field name="sedar_vessel_id"/>
        <field name="sedar_job_order_id"/>
        <field name="sedar_maintenance_request_id"/>
        <field name="sedar_petty_cash_id"/>
        <field name="sedar_cash_advance_id"/>
        <field name="sedar_disbursement_id"/>
        <field name="sedar_collection_id"/>
        <field name="sedar_finance_billing_id"/>
      </xpath>
    </field>
  </record>
