<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_sedar_finance" model="ir.module.category">
        <field name="name">SEDAR Finance</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_finance_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="module_category_sedar_finance"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_finance_officer" model="res.groups">
        <field name="name">Finance Officer</field>
        <field name="category_id" ref="module_category_sedar_finance"/>
        <field name="implied_ids" eval="[
            (4, ref('group_finance_cashier')),
            (4, ref('account.group_account_user')),
            (4, ref('partner_statement.group_activity_statement')),
            (4, ref('partner_statement.group_outstanding_statement'))
        ]"/>
    </record>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="category_id" ref="module_category_sedar_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_officer')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <!-- MVP showcase mode: every internal user can open and operate the finance demo. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_finance_manager'))]"/>
    </record>
</odoo>
