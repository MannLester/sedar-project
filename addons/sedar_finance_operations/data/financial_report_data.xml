<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mis_instance_profit_loss" model="mis.report.instance">
        <field name="name">SEDAR Profit and Loss Comparison</field>
        <field name="report_id" ref="mis_template_financial_report.report_pl"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="comparison_mode" eval="True"/>
        <field name="landscape_pdf" eval="True"/>
    </record>
    <record id="mis_pl_current_month" model="mis.report.instance.period">
        <field name="name">Current Month</field>
        <field name="report_instance_id" ref="mis_instance_profit_loss"/>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>
    <record id="mis_pl_previous_month" model="mis.report.instance.period">
        <field name="name">Previous Month</field>
        <field name="report_instance_id" ref="mis_instance_profit_loss"/>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>
    <record id="mis_pl_year_to_date" model="mis.report.instance.period">
        <field name="name">Year to Date</field>
        <field name="report_instance_id" ref="mis_instance_profit_loss"/>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="is_ytd" eval="True"/>
        <field name="sequence">30</field>
    </record>

    <record id="mis_instance_balance_sheet" model="mis.report.instance">
        <field name="name">SEDAR Balance Sheet Comparison</field>
        <field name="report_id" ref="mis_template_financial_report.report_bs"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="comparison_mode" eval="True"/>
        <field name="landscape_pdf" eval="True"/>
    </record>
    <record id="mis_bs_current_month" model="mis.report.instance.period">
        <field name="name">Current Month</field>
        <field name="report_instance_id" ref="mis_instance_balance_sheet"/>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>
    <record id="mis_bs_previous_month" model="mis.report.instance.period">
        <field name="name">Previous Month</field>
        <field name="report_instance_id" ref="mis_instance_balance_sheet"/>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>

    <record id="action_profit_loss_comparison" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">mis.report.instance</field>
        <field name="res_id" ref="mis_instance_profit_loss"/>
        <field name="view_mode">form</field>
    </record>
    <record id="action_balance_sheet_comparison" model="ir.actions.act_window">
        <field name="name">Balance Sheet</field>
        <field name="res_model">mis.report.instance</field>
        <field name="res_id" ref="mis_instance_balance_sheet"/>
        <field name="view_mode">form</field>
    </record>
    <record id="action_cash_flow_report" model="ir.actions.act_window">
        <field name="name">Cash Flow</field>
        <field name="res_model">mis.report.instance</field>
        <field name="res_id" ref="mis_builder_cash_flow.mis_instance_cash_flow"/>
        <field name="view_mode">form</field>
    </record>
</odoo>
