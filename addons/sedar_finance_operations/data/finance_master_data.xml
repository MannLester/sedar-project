<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="account_petty_cash" model="account.account">
        <field name="name">Petty Cash</field>
        <field name="code">101510</field>
        <field name="account_type">asset_cash</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_employee_advances" model="account.account">
        <field name="name">Employee Cash Advances</field>
        <field name="code">101610</field>
        <field name="account_type">asset_current</field>
        <field name="reconcile" eval="True"/>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_fuel" model="account.account">
        <field name="name">Fuel and Lubricants Expense</field>
        <field name="code">610100</field>
        <field name="account_type">expense_direct_cost</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_vessel_repairs" model="account.account">
        <field name="name">Vessel Repairs and Maintenance</field>
        <field name="code">610200</field>
        <field name="account_type">expense_direct_cost</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_office" model="account.account">
        <field name="name">Office Supplies Expense</field>
        <field name="code">610300</field>
        <field name="account_type">expense</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_travel" model="account.account">
        <field name="name">Transportation and Travel Expense</field>
        <field name="code">610400</field>
        <field name="account_type">expense</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_crew_welfare" model="account.account">
        <field name="name">Crew Meals and Welfare Expense</field>
        <field name="code">610500</field>
        <field name="account_type">expense</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_drydock" model="account.account">
        <field name="name">Dry Docking Expense</field>
        <field name="code">610600</field>
        <field name="account_type">expense_direct_cost</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_bank" model="account.account">
        <field name="name">Bank Charges Expense</field>
        <field name="code">610700</field>
        <field name="account_type">expense</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_expense_other" model="account.account">
        <field name="name">Other Operating Expense</field>
        <field name="code">610900</field>
        <field name="account_type">expense</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="account_towage_income" model="account.account">
        <field name="name">Towage Service Income</field>
        <field name="code">400100</field>
        <field name="account_type">income</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="journal_petty_cash" model="account.journal">
        <field name="name">Main Petty Cash</field>
        <field name="code">PCSH</field>
        <field name="type">cash</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="default_account_id" ref="account_petty_cash"/>
    </record>
    <record id="petty_fund_main" model="sedar.finance.petty.fund">
        <field name="name">Main Petty Cash Fund</field>
        <field name="journal_id" ref="journal_petty_cash"/>
        <field name="account_id" ref="account_petty_cash"/>
        <field name="advance_account_id" ref="account_employee_advances"/>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="expense_category_fuel" model="sedar.finance.expense.category"><field name="name">Fuel and Lubricants</field><field name="account_id" ref="account_expense_fuel"/><field name="company_id" ref="base.main_company"/></record>
    <record id="expense_category_repairs" model="sedar.finance.expense.category"><field name="name">Vessel Repairs and Maintenance</field><field name="account_id" ref="account_expense_vessel_repairs"/><field name="company_id" ref="base.main_company"/></record>
    <record id="expense_category_office" model="sedar.finance.expense.category"><field name="name">Office Supplies</field><field name="account_id" ref="account_expense_office"/><field name="company_id" ref="base.main_company"/></record>
    <record id="expense_category_travel" model="sedar.finance.expense.category"><field name="name">Transportation and Travel</field><field name="account_id" ref="account_expense_travel"/><field name="company_id" ref="base.main_company"/></record>
    <record id="expense_category_crew" model="sedar.finance.expense.category"><field name="name">Crew Meals and Welfare</field><field name="account_id" ref="account_expense_crew_welfare"/><field name="company_id" ref="base.main_company"/></record>
    <record id="expense_category_drydock" model="sedar.finance.expense.category"><field name="name">Dry Docking</field><field name="account_id" ref="account_expense_drydock"/><field name="company_id" ref="base.main_company"/></record>
    <record id="expense_category_bank" model="sedar.finance.expense.category"><field name="name">Bank Charges</field><field name="account_id" ref="account_expense_bank"/><field name="company_id" ref="base.main_company"/></record>
    <record id="expense_category_other" model="sedar.finance.expense.category"><field name="name">Other Operating Expense</field><field name="account_id" ref="account_expense_other"/><field name="company_id" ref="base.main_company"/></record>

    <record id="service_towage" model="sedar.finance.service">
        <field name="name">Towage Service</field>
        <field name="code">TOWAGE</field>
        <field name="income_account_id" ref="account_towage_income"/>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
