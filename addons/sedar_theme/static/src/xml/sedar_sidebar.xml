<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sedar_theme.NavBarSidebar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[contains(@class, 'o_main_navbar')]" position="after">
            <aside class="o_sedar_shell d-print-none">
                <input id="o_sedar_sidebar_state" class="o_sedar_sidebar_state" type="checkbox" checked="checked"/>
                <div class="o_sedar_icon_rail">
                    <label class="o_sedar_sidebar_toggle o_sedar_sidebar_expand" for="o_sedar_sidebar_state" title="Open sidebar">
                        <i class="fa fa-bars"/>
                    </label>
                    <div class="o_sedar_rail_logo">S</div>
                    <div class="o_sedar_rail_icons">
                        <i class="fa fa-th-large"/>
                        <i class="fa fa-ship"/>
                        <i class="fa fa-wrench"/>
                        <i class="fa fa-users"/>
                        <i class="fa fa-life-ring"/>
                        <i class="fa fa-money"/>
                        <i class="fa fa-shopping-cart"/>
                        <i class="fa fa-archive"/>
                        <i class="fa fa-file-text"/>
                        <i class="fa fa-bar-chart"/>
                    </div>
                    <div class="o_sedar_rail_avatar"/>
                </div>

                <section class="o_sedar_sidebar">
                    <div class="o_sedar_sidebar_brand">
                        <div class="o_sedar_logo_mark">S</div>
                        <div class="o_sedar_brand_copy">
                            <div class="o_sedar_logo_text">SEDAR</div>
                            <div class="o_sedar_logo_subtitle">TUG SERVICE CORP.</div>
                        </div>
                        <label class="o_sedar_sidebar_toggle o_sedar_sidebar_collapse" for="o_sedar_sidebar_state" title="Close sidebar">
                            <i class="fa fa-angle-left"/>
                        </label>
                    </div>

                    <nav class="o_sedar_sidebar_nav" aria-label="SEDAR navigation">
                        <details class="o_sedar_nav_group" open="open">
                            <summary class="o_sedar_nav_parent">
                                <span><i class="fa fa-users"/>Human Resources</span>
                                <i class="fa fa-angle-down o_sedar_nav_chevron"/>
                            </summary>
                            <div class="o_sedar_nav_children">
                                <details class="o_sedar_nav_subgroup" open="open">
                                    <summary class="o_sedar_nav_item o_sedar_nav_subparent">
                                        <span>Job Hiring</span>
                                        <i class="fa fa-angle-down o_sedar_nav_chevron"/>
                                    </summary>
                                    <div class="o_sedar_nav_subchildren">
                                        <a class="o_sedar_nav_item" href="/web#action=sedar_recruitment_link.action_sedar_job_hiring_overview&amp;model=sedar.job.hiring.overview&amp;view_type=kanban">
                                            <span>Overview</span>
                                        </a>
                                        <a class="o_sedar_nav_item" href="/web#action=sedar_recruitment_link.action_sedar_job_dispatch&amp;model=sedar.job.dispatch&amp;view_type=kanban">
                                            <span>Job Dispatch Orders</span>
                                        </a>
                                        <a class="o_sedar_nav_item" href="/web#action=sedar_recruitment_link.action_sedar_job_applications&amp;model=hr.applicant&amp;view_type=kanban">
                                            <span>Job Applications</span>
                                        </a>
                                        <a class="o_sedar_nav_item" href="/web#action=sedar_recruitment_link.action_sedar_pending_interviews&amp;model=hr.applicant&amp;view_type=kanban">
                                            <span>Pending Interviews</span>
                                        </a>
                                        <a class="o_sedar_nav_item" href="/web#action=sedar_recruitment_link.action_sedar_final_assessment&amp;model=hr.applicant&amp;view_type=kanban">
                                            <span>Final Assessment</span>
                                        </a>
                                        <a class="o_sedar_nav_item" href="/web#action=sedar_recruitment_link.action_sedar_contract_signing&amp;model=hr.applicant&amp;view_type=kanban">
                                            <span>Contract Signing</span>
                                        </a>
                                    </div>
                                </details>
                                <span class="o_sedar_nav_item o_sedar_nav_placeholder">Placeholder 1</span>
                            </div>
                        </details>

                        <details class="o_sedar_nav_group">
                            <summary class="o_sedar_nav_parent">
                                <span><i class="fa fa-money"/>Finance and Accounting</span>
                                <i class="fa fa-angle-down o_sedar_nav_chevron"/>
                            </summary>
                            <div class="o_sedar_nav_children">
                                <span class="o_sedar_nav_item o_sedar_nav_placeholder">Placeholder 1</span>
                            </div>
                        </details>

                        <details class="o_sedar_nav_group" open="open">
                            <summary class="o_sedar_nav_parent">
                                <span><i class="fa fa-shopping-cart"/>Procurement</span>
                                <i class="fa fa-angle-down o_sedar_nav_chevron"/>
                            </summary>
                            <div class="o_sedar_nav_children">
                                <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                                    <a t-if="app.xmlid === 'stock.menu_stock_root'"
                                       t-att-href="getMenuItemHref(app)"
                                       t-att-data-menu-xmlid="app.xmlid"
                                       t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                       t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                        <span>Inventory</span>
                                    </a>
                                </t>
                                <span class="o_sedar_nav_item o_sedar_nav_placeholder">Placeholder 1</span>
                            </div>
                        </details>

                        <details class="o_sedar_nav_group" open="open">
                            <summary class="o_sedar_nav_parent">
                                <span><i class="fa fa-life-ring"/>HSSE</span>
                                <i class="fa fa-angle-down o_sedar_nav_chevron"/>
                            </summary>
                            <div class="o_sedar_nav_children">
                                <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                                    <a t-if="app.xmlid === 'sedar_hsse.menu_root'"
                                       t-att-href="getMenuItemHref(app)"
                                       t-att-data-menu-xmlid="app.xmlid"
                                       t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                       t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                        <span>Incident Reports</span>
                                    </a>
                                </t>
                                <span class="o_sedar_nav_item o_sedar_nav_placeholder">Placeholder 1</span>
                            </div>
                        </details>

                        <details class="o_sedar_nav_group">
                            <summary class="o_sedar_nav_parent">
                                <span><i class="fa fa-comments"/>Customer Relations</span>
                                <i class="fa fa-angle-down o_sedar_nav_chevron"/>
                            </summary>
                            <div class="o_sedar_nav_children">
                                <span class="o_sedar_nav_item o_sedar_nav_placeholder">Help Desk</span>
                                <span class="o_sedar_nav_item o_sedar_nav_placeholder">Placeholder 1</span>
                            </div>
                        </details>

                        <details class="o_sedar_nav_group" open="open">
                            <summary class="o_sedar_nav_parent">
                                <span><i class="fa fa-th-large"/>Executive Dashboard</span>
                                <i class="fa fa-angle-down o_sedar_nav_chevron"/>
                            </summary>
                            <div class="o_sedar_nav_children">
                                <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                                    <a t-if="app.xmlid === 'sedar_dashboard.menu_root'"
                                       t-att-href="getMenuItemHref(app)"
                                       t-att-data-menu-xmlid="app.xmlid"
                                       t-att-class="{'o_sedar_nav_item': true, 'active': currentApp and currentApp.id === app.id}"
                                       t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                        <span>Company Calendar</span>
                                    </a>
                                </t>
                                <span class="o_sedar_nav_item o_sedar_nav_placeholder">Placeholder 1</span>
                            </div>
                        </details>
                    </nav>

                    <div class="o_sedar_sidebar_footer">
                        <div class="o_sedar_user_avatar">S</div>
                        <div class="o_sedar_footer_copy">
                            <div class="o_sedar_user_name">SEDAR MVP</div>
                            <div class="o_sedar_user_role">Placeholder logo</div>
                        </div>
                        <i class="fa fa-sign-out o_sedar_footer_icon" aria-hidden="true"/>
                    </div>
                </section>
            </aside>
        </xpath>
    </t>
</templates>
