<odoo>
    <record id="view_sedar_crew_leave_tree" model="ir.ui.view">
        <field name="name">sedar.crew.leave.tree</field>
        <field name="model">sedar.crew.leave</field>
        <field name="arch" type="xml">
            <tree>
                <field name="crew_id"/>
                <field name="leave_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_sedar_crew_leave_form" model="ir.ui.view">
        <field name="name">sedar.crew.leave.form</field>
        <field name="model">sedar.crew.leave</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="crew_id"/>
                        <field name="leave_type"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sedar_crew_leave" model="ir.actions.act_window">
        <field name="name">Leave</field>
        <field name="res_model">sedar.crew.leave</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
