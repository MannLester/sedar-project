<odoo>
    <record id="view_sedar_doc_contract_tree" model="ir.ui.view">
        <field name="name">sedar.doc.contract.tree</field>
        <field name="model">sedar.doc.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="expiry_status"/>
            </tree>
        </field>
    </record>
    <record id="view_sedar_doc_contract_form" model="ir.ui.view">
        <field name="name">sedar.doc.contract.form</field>
        <field name="model">sedar.doc.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="contract_type"/>
                        <field name="effective_date"/>
                        <field name="expiry_date"/>
                        <field name="expiry_status"/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sedar_doc_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">sedar.doc.contract</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
