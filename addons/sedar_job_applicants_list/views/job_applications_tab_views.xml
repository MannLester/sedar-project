<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sedar_recruitment_link.action_sedar_job_applications" model="ir.actions.act_window">
        <field name="name">Job Applications</field>
        <field name="view_id" ref="sedar_job_applicants_list.view_sedar_dashboard_job_applicant_kanban"/>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('sedar_hiring_state', '=', 'application')]</field>
        <field name="context">{'default_sedar_hiring_state': 'application'}</field>
    </record>

    <record id="sedar_recruitment_link.action_sedar_job_applications_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="sedar_job_applicants_list.view_sedar_dashboard_job_applicant_kanban"/>
        <field name="act_window_id" ref="sedar_recruitment_link.action_sedar_job_applications"/>
    </record>

    <record id="sedar_recruitment_link.action_sedar_job_applications_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="sedar_job_applicants_list.view_sedar_dashboard_job_applicant_tree"/>
        <field name="act_window_id" ref="sedar_recruitment_link.action_sedar_job_applications"/>
    </record>

    <record id="sedar_recruitment_link.action_sedar_job_applications_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sedar_job_applicants_list.view_sedar_dashboard_job_applicant_form"/>
        <field name="act_window_id" ref="sedar_recruitment_link.action_sedar_job_applications"/>
    </record>
</odoo>
