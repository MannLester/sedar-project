<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sedar_marketing.MarketingDashboard">
        <div class="o_sedar_marketing_dashboard">
            <div class="o_sedar_marketing_topbar">
                <div>
                    <h1>Dashboard</h1>
                    <p>Overview of marketing and service operations.</p>
                </div>
                <div class="o_sedar_marketing_actions">
                    <button class="o_sedar_request_button" t-on-click="openNewServiceRequest">
                        <i class="fa fa-plus"/> New Service Request
                    </button>
                    <button class="o_sedar_schedule_button" t-on-click="openCalendar">
                        <i class="fa fa-calendar"/> Schedule Appointment
                    </button>
                </div>
            </div>

            <div class="o_sedar_kpi_grid">
                <t t-foreach="state.kpis" t-as="kpi" t-key="kpi.label">
                    <section class="o_sedar_kpi_card">
                        <div>
                            <h2 t-esc="kpi.label"/>
                            <strong t-esc="kpi.value"/>
                            <span t-if="kpi.note" t-esc="kpi.note"/>
                        </div>
                        <i t-att-class="'fa ' + kpi.icon"/>
                    </section>
                </t>
            </div>

            <div class="o_sedar_marketing_content">
                <section class="o_sedar_request_panel">
                    <div class="o_sedar_panel_header">
                        <h2>Active Service Requests</h2>
                    </div>
                    <table class="o_sedar_request_table">
                        <thead>
                            <tr>
                                <th>Ref No.</th>
                                <th>Customer</th>
                                <th>Service Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.requests" t-as="request" t-key="request.ref">
                                <tr>
                                    <td><strong t-esc="request.ref"/></td>
                                    <td>
                                        <strong t-esc="request.customer"/>
                                        <small t-if="request.vessel" t-esc="request.vessel"/>
                                    </td>
                                    <td><span class="o_sedar_service_type" t-esc="request.service"/></td>
                                    <td>
                                        <span t-att-title="statusMeta(request.status).title" t-att-class="'o_sedar_status_pill ' + statusMeta(request.status).className" t-esc="statusMeta(request.status).label"/>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="!state.requests.length">
                                <td colspan="4" class="o_sedar_empty_requests">No active service requests yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section class="o_sedar_schedule_panel">
                    <div class="o_sedar_panel_header">
                        <h2>Today’s Schedule</h2>
                    </div>
                    <div class="o_sedar_timeline">
                        <t t-foreach="state.schedule" t-as="item" t-key="item.time + item.title">
                            <article class="o_sedar_schedule_item">
                                <time t-esc="item.time"/>
                                <span t-att-class="'o_sedar_timeline_dot ' + item.className"/>
                                <div>
                                    <span t-att-class="'o_sedar_schedule_tag ' + item.className" t-esc="item.type"/>
                                    <h3 t-esc="item.title"/>
                                    <p t-esc="item.customer"/>
                                </div>
                            </article>
                        </t>
                        <p t-if="!state.schedule.length" class="o_sedar_empty_schedule">No appointments scheduled today.</p>
                    </div>
                    <button class="o_sedar_calendar_link" t-on-click="openCalendar">View Full Calendar</button>
                </section>
            </div>
        </div>
    </t>

    <t t-name="sedar_marketing.MarketingDraftsBoard">
        <div class="o_sedar_marketing_dashboard o_sedar_marketing_drafts">
            <div class="o_sedar_marketing_topbar">
                <div>
                    <h1>Saved Drafts</h1>
                    <p>Continue incomplete service requests without using the raw Odoo list.</p>
                </div>
                <div class="o_sedar_marketing_actions">
                    <button class="o_sedar_schedule_button" t-on-click="openDashboard"><i class="fa fa-arrow-left"/> Back to Dashboard</button>
                    <button class="o_sedar_request_button" t-on-click="openNewServiceRequest"><i class="fa fa-plus"/> New Service Request</button>
                </div>
            </div>

            <section class="o_sedar_request_panel o_sedar_drafts_panel">
                <div class="o_sedar_panel_header">
                    <h2>Marketing Draft Register</h2>
                    <span><t t-esc="state.drafts.length"/> drafts</span>
                </div>
                <div class="o_sedar_drafts_list">
                    <t t-foreach="state.drafts" t-as="draft" t-key="draft.id">
                        <article class="o_sedar_draft_row" t-att-data-id="draft.id" t-on-click="openDraft">
                            <div class="o_sedar_draft_ref">
                                <strong t-esc="draft.ref"/>
                                <span t-esc="draft.stepLabel"/>
                            </div>
                            <div class="o_sedar_draft_main">
                                <h3 t-esc="draft.customer"/>
                                <p t-esc="draft.contact"/>
                            </div>
                            <div class="o_sedar_draft_service">
                                <span t-esc="draft.service"/>
                                <small t-esc="draft.communication_method || 'No method'"/>
                            </div>
                            <div class="o_sedar_draft_status">
                                <span>Draft</span>
                                <small>Updated <t t-esc="draft.updated"/></small>
                            </div>
                        </article>
                    </t>
                    <div t-if="!state.drafts.length" class="o_sedar_empty_drafts">
                        <i class="fa fa-folder-open-o"/>
                        <h3>No saved drafts</h3>
                        <p>Draft service requests will appear here after you save them.</p>
                    </div>
                </div>
            </section>
        </div>
    </t>
</templates>
