<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sedar_owner_preview.OwnerPreviewDashboard">
        <main class="sop_page">
            <section class="sop_hero">
                <div>
                    <h1 t-esc="focusCopy.title"/>
                    <p class="sop_intro" t-esc="focusCopy.intro"/>
                </div>
            </section>

            <section t-if="isOverview" class="sop_metrics">
                <article t-foreach="workflows" t-as="item" t-key="item.label" t-att-class="'sop_metric sop_metric_action ' + item.className" t-on-click="() => openAction(item.action)">
                    <i t-att-class="'fa ' + item.icon"/>
                    <div>
                        <span t-esc="item.label"/>
                        <strong t-esc="item.value"/>
                        <small t-esc="item.note"/>
                    </div>
                </article>
            </section>

            <t t-if="state.activeModule === 'AIS / GPS Control' || state.activeModule === 'Owner Vessel Card' || isOverview">
                <section t-att-class="isOverview ? 'sop_grid sop_overview_map_grid' : 'sop_grid sop_gps_map_grid'">
                    <article class="sop_panel sop_map_panel">
                        <div class="sop_panel_header">
                            <div>
                                <h2>AIS / GPS FLEET MAP</h2>
                            </div>
                        </div>
                        <div class="sop_map">
                            <div class="sop_map_canvas" t-att-style="mapZoomStyle">
                                <div class="sop_map_grid"/>
                                <span class="sop_port p1">Batangas Port</span>
                                <span class="sop_port p2">Manila Bay</span>
                                <span class="sop_port p3">Navotas Yard</span>
                                <button t-foreach="vessels" t-as="vessel" t-key="vessel.name"
                                        type="button"
                                        t-att-class="'sop_marker ' + vessel.statusClass + (vessel_index === state.activeVessel ? ' is-active' : '')"
                                        t-att-style="'left: ' + vessel.lng + '%; top: ' + vessel.lat + '%;'"
                                        t-on-click="() => selectVessel(vessel_index)">
                                    <i class="fa fa-location-arrow"/>
                                    <span t-esc="vessel.name"/>
                                </button>
                            </div>
                            <aside t-if="state.mapZoomed" class="sop_map_details" aria-live="polite">
                                <div class="sop_map_details_header">
                                    <div>
                                        <small>VESSEL DETAILS</small>
                                        <strong t-esc="selectedVessel.name"/>
                                    </div>
                                    <button type="button" class="sop_map_details_close" aria-label="Close vessel details" t-on-click="closeMapDetails">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                                <span t-att-class="'sop_vessel_status ' + selectedVessel.statusClass" t-esc="selectedVessel.status"/>
                                <div class="sop_map_details_location">
                                    <i class="fa fa-map-marker"/>
                                    <span t-esc="selectedVessel.location"/>
                                </div>
                                <dl>
                                    <div><dt>Speed</dt><dd t-esc="selectedVessel.speed"/></div>
                                    <div><dt>Heading</dt><dd t-esc="selectedVessel.heading"/></div>
                                    <div><dt>Signal</dt><dd t-esc="selectedVessel.tracking"/></div>
                                    <div t-if="selectedVessel.role"><dt>Type</dt><dd t-esc="selectedVessel.role"/></div>
                                    <div t-if="selectedVessel.power"><dt>Power</dt><dd t-esc="selectedVessel.power"/></div>
                                    <div t-if="selectedVessel.bollard"><dt>Bollard Pull</dt><dd t-esc="selectedVessel.bollard"/></div>
                                    <div t-if="selectedVessel.fuelOnHand"><dt>Fuel on Hand</dt><dd t-esc="selectedVessel.fuelOnHand"/></div>
                                    <div t-if="selectedVessel.availabilityRate"><dt>Availability</dt><dd t-esc="selectedVessel.availabilityRate"/></div>
                                    <div t-if="selectedVessel.utilizationRate"><dt>Utilization</dt><dd t-esc="selectedVessel.utilizationRate"/></div>
                                </dl>
                                <div t-if="selectedVessel.lastUpdate" class="sop_map_details_update">
                                    <i class="fa fa-clock-o"/>
                                    <span>Last GPS update</span>
                                    <strong t-esc="selectedVessel.lastUpdate"/>
                                </div>
                            </aside>
                            <div class="sop_vessel_picker">
                                <div class="sop_vessel_track">
                                    <div class="sop_vessel_set" t-foreach="[0, 1]" t-as="copy" t-key="copy">
                                        <button t-foreach="vessels" t-as="vessel" t-key="vessel.name"
                                                type="button"
                                                t-att-class="vessel_index === state.activeVessel ? 'is-active' : ''"
                                                t-on-click="() => selectVessel(vessel_index)">
                                            <strong t-esc="vessel.name"/>
                                            <div class="sop_vessel_meta">
                                                <span class="sop_vessel_location" t-att-title="vessel.location">
                                                    <i class="fa fa-map-marker"/>
                                                    <span t-esc="vessel.location"/>
                                                </span>
                                                <span t-att-class="'sop_vessel_status ' + vessel.statusClass" t-esc="vessel.status"/>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>

                    <section t-if="isOverview" class="sop_panel sop_attention">
                        <div class="sop_panel_header">
                            <div><h2>NEEDS ATTENTION</h2></div>
                            <span class="sop_active_module"><t t-esc="state.alerts.length"/> items</span>
                        </div>
                        <div class="sop_alert_list">
                            <button t-foreach="state.alerts" t-as="alert" t-key="alert.title" type="button"
                                    t-att-class="'sop_alert is-' + alert.severity" t-on-click="() => openAction(alert.action)">
                                <i t-att-class="alert.severity === 'critical' ? 'fa fa-exclamation-circle' : (alert.severity === 'warning' ? 'fa fa-clock-o' : 'fa fa-info-circle')"/>
                                <span><small t-esc="alert.area"/><strong t-esc="alert.title"/><p t-esc="alert.detail"/></span>
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>
                    </section>

                </section>
            </t>

            <t t-if="state.activeModule === 'Payroll'">
                <section class="sop_focus_grid">
                    <article class="sop_panel sop_focus_main">
                        <div class="sop_panel_header">
                            <div>
                                <h2>Crew Payroll Batch</h2>
                                <p>General flow for approval, statutory deductions, and posting preview</p>
                            </div>
                            <span class="sop_badge is-watch">Draft batch</span>
                        </div>
                        <div class="sop_table">
                            <div class="sop_table_head"><span>Crew</span><span>Vessel</span><span>Hours</span><span>OT</span><span>Gross</span><span>Deductions</span><span>Net</span><span>Status</span></div>
                            <div t-foreach="payrollRows" t-as="row" t-key="row.crew">
                                <span t-esc="row.crew"/><span t-esc="row.vessel"/><span t-esc="row.hours"/><span t-esc="row.overtime"/><span t-esc="row.gross"/><span t-esc="row.deductions"/><span t-esc="row.net"/><span t-esc="row.state"/>
                            </div>
                        </div>
                    </article>
                    <aside class="sop_panel">
                        <h2>Payroll Flow</h2>
                        <div class="sop_step_list">
                            <div><strong>1</strong><span>Collect attendance and vessel shift data</span></div>
                            <div><strong>2</strong><span>Compute overtime, allowance, and dry dock allocation</span></div>
                            <div><strong>3</strong><span>Preview SSS, PhilHealth, PAGIBIG, tax deductions</span></div>
                            <div><strong>4</strong><span>Approve batch and post journal/payment</span></div>
                        </div>
                    </aside>
                </section>
            </t>

            <t t-if="state.activeModule === 'Dry Dock'">
                <section class="sop_focus_grid">
                    <article class="sop_panel sop_focus_main">
                        <div class="sop_panel_header">
                            <div>
                                <h2>MT SEDAR Lakan Dry Dock</h2>
                                <p>Scope, milestone, contractor, cost, and dispatch-blocking preview</p>
                            </div>
                            <span class="sop_badge is-risk">Blocked from dispatch</span>
                        </div>
                        <div class="sop_drydock_summary">
                            <div><span>Progress</span><strong>63%</strong><em><b style="width:63%"/></em></div>
                            <div><span>Budget</span><strong>PHP 2.8M</strong><small>PHP 2.1M committed</small></div>
                            <div><span>Target Release</span><strong>Jul 18</strong><small>Sea trial pending</small></div>
                        </div>
                        <div class="sop_milestones">
                            <div t-foreach="dryDockMilestones" t-as="step" t-key="step.name">
                                <span><strong t-esc="step.name"/><small t-esc="step.owner"/></span>
                                <em><b t-att-style="'width:' + step.progress + '%'"/></em>
                                <i t-esc="step.state"/>
                            </div>
                        </div>
                    </article>
                    <aside class="sop_panel">
                        <h2>Owner Questions Answered</h2>
                        <div class="sop_step_list">
                            <div><strong>?</strong><span>Why is this tug unavailable?</span></div>
                            <div><strong>?</strong><span>Which contractor is delaying the job?</span></div>
                            <div><strong>?</strong><span>What part is missing and how much is committed?</span></div>
                            <div><strong>?</strong><span>When can operations schedule it again?</span></div>
                        </div>
                    </aside>
                </section>
            </t>

            <t t-if="state.activeModule === 'Audit / ISO'">
                <section class="sop_focus_grid">
                    <article class="sop_panel sop_focus_main">
                        <div class="sop_panel_header">
                            <div>
                                <h2>Audit / ISO Evidence Board</h2>
                                <p>Evidence, revision, retention, owner, and sign-off preview</p>
                            </div>
                            <span class="sop_badge is-watch">7 open items</span>
                        </div>
                        <div class="sop_cards_2">
                            <article t-foreach="auditRows" t-as="row" t-key="row.item">
                                <strong t-esc="row.item"/>
                                <p><t t-esc="row.owner"/> - Due <t t-esc="row.due"/></p>
                                <span t-esc="row.state"/>
                            </article>
                        </div>
                    </article>
                    <aside class="sop_panel">
                        <h2>ISO Controls</h2>
                        <div class="sop_step_list">
                            <div><strong>R</strong><span>Locked revision history</span></div>
                            <div><strong>E</strong><span>Evidence packet checklist</span></div>
                            <div><strong>S</strong><span>Sign-off by responsible department</span></div>
                            <div><strong>A</strong><span>Audit trail for management review</span></div>
                        </div>
                    </aside>
                </section>
            </t>

            <t t-if="state.activeModule === 'Inventory Barcode'">
                <section class="sop_focus_grid">
                    <article class="sop_panel sop_focus_main">
                        <div class="sop_panel_header">
                            <div>
                                <h2>Barcode Issue Flow</h2>
                                <p>Scanner-style workflow for spare parts, fuel, lubricants, and vessel stock</p>
                            </div>
                            <span class="sop_badge is-good">Scan ready</span>
                        </div>
                        <div class="sop_scan_box">
                            <i class="fa fa-barcode"/>
                            <strong>SP-STEER-SEAL-002</strong>
                            <span>Steering pump seal kit</span>
                        </div>
                        <div class="sop_step_cards">
                            <article t-foreach="barcodeSteps" t-as="step" t-key="step.label">
                                <span t-esc="step.label"/>
                                <strong t-esc="step.value"/>
                                <p t-esc="step.note"/>
                            </article>
                        </div>
                    </article>
                    <aside class="sop_panel">
                        <h2>Result</h2>
                        <div class="sop_callout">
                            <strong>Stock move created</strong>
                            <p>Part is issued to MT SEDAR Marikit, linked to maintenance request MR-0241, and becomes visible in vessel cost.</p>
                        </div>
                    </aside>
                </section>
            </t>

            <t t-if="state.activeModule === 'Bank Feed'">
                <section class="sop_focus_grid">
                    <article class="sop_panel sop_focus_main">
                        <div class="sop_panel_header">
                            <div>
                                <h2>Imported Bank Transactions</h2>
                                <p>Preview of bank statement import, matching, exceptions, and cash position</p>
                            </div>
                            <span class="sop_badge is-good">PHP 8.7M available</span>
                        </div>
                        <div class="sop_table sop_bank_table">
                            <div class="sop_table_head"><span>Date</span><span>Bank</span><span>Transaction</span><span>Amount</span><span>Match</span></div>
                            <div t-foreach="bankRows" t-as="row" t-key="row.detail">
                                <span t-esc="row.date"/><span t-esc="row.bank"/><span t-esc="row.detail"/><span t-esc="row.amount"/><span t-esc="row.match"/>
                            </div>
                        </div>
                    </article>
                    <aside class="sop_panel">
                        <h2>Cash Controls</h2>
                        <div class="sop_step_list">
                            <div><strong>1</strong><span>Import statement</span></div>
                            <div><strong>2</strong><span>Match customer receipt or check release</span></div>
                            <div><strong>3</strong><span>Flag unknown deposit or stale check</span></div>
                            <div><strong>4</strong><span>Update available cash for owner view</span></div>
                        </div>
                    </aside>
                </section>
            </t>

            <t t-if="state.activeModule === 'KPI Trends' || isOverview">
                <section class="sop_exec_grid">
                    <article class="sop_panel sop_exec_finance">
                        <div class="sop_panel_header">
                            <div>
                                <h2>Financial Overview</h2>
                                <p>Revenue vs Operating Expenses — 12-month trailing</p>
                            </div>
                            <span class="sop_badge is-good">PHP 6.66M latest</span>
                        </div>
                        <div class="sop_exec_finance_chart">
                            <svg viewBox="0 0 600 210" preserveAspectRatio="none" class="sop_area_chart">
                                <defs>
                                    <linearGradient id="gradRevenue" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#0f6b72" stop-opacity="0.3"/>
                                        <stop offset="100%" stop-color="#0f6b72" stop-opacity="0.03"/>
                                    </linearGradient>
                                    <linearGradient id="gradOpex" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#c87913" stop-opacity="0.2"/>
                                        <stop offset="100%" stop-color="#c87913" stop-opacity="0.02"/>
                                    </linearGradient>
                                </defs>
                                <polygon t-att-points="financialArea(financialData.revenue, 7000)" fill="url(#gradRevenue)"/>
                                <polyline t-att-points="financialLine(financialData.revenue, 7000)" fill="none" stroke="#0f6b72" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <polygon t-att-points="financialArea(financialData.opex, 7000)" fill="url(#gradOpex)"/>
                                <polyline t-att-points="financialLine(financialData.opex, 7000)" fill="none" stroke="#c87913" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="6,4"/>
                            </svg>
                            <div class="sop_exec_finance_labels">
                                <t t-foreach="financialData.months" t-as="m" t-key="m">
                                    <span t-esc="m"/>
                                </t>
                            </div>
                        </div>
                        <div class="sop_exec_finance_legend">
                            <span class="sop_legend_item"><span class="sop_legend_dot" style="background:#0f6b72"/>Revenue</span>
                            <span class="sop_legend_item"><span class="sop_legend_dot" style="background:#c87913"/>OPEX</span>
                            <span class="sop_exec_finance_net">Net margin PHP 2.36M</span>
                        </div>
                    </article>

                    <article class="sop_panel sop_exec_util">
                        <div class="sop_panel_header">
                            <div>
                                <h2>Fleet Utilization</h2>
                                <p>Working vs idle, standby, and drydock hours by vessel</p>
                            </div>
                        </div>
                        <div class="sop_exec_util_bars">
                            <div t-foreach="fleetUtil" t-as="v" t-key="v.name" class="sop_exec_util_row">
                                <span class="sop_exec_util_name" t-esc="v.name"/>
                                <div class="sop_exec_util_bar">
                                    <t t-foreach="utilBarSegments(v)" t-as="seg" t-key="seg.key">
                                        <div t-att-style="'width:' + seg.pct + '%;background:' + seg.color"/>
                                    </t>
                                </div>
                                <span class="sop_exec_util_pct" t-esc="v.working + '%'"/>
                            </div>
                        </div>
                        <div class="sop_exec_util_legend">
                            <span class="sop_legend_item"><span class="sop_legend_dot" style="background:#0f3b4a"/>Working</span>
                            <span class="sop_legend_item"><span class="sop_legend_dot" style="background:#b83b31"/>Idle</span>
                            <span class="sop_legend_item"><span class="sop_legend_dot" style="background:#c87913"/>Standby</span>
                            <span class="sop_legend_item"><span class="sop_legend_dot" style="background:#687f85"/>Drydock</span>
                        </div>
                    </article>

                    <article class="sop_panel sop_exec_revenue">
                        <div class="sop_panel_header">
                            <div>
                                <h2>Revenue by Service</h2>
                                <p>Quarterly breakdown by service type</p>
                            </div>
                        </div>
                        <div class="sop_exec_doughnut_wrap">
                            <svg viewBox="0 0 180 180" class="sop_exec_doughnut">
                                <defs>
                                    <filter id="doughnutShadow" x="-20%" y="-20%" width="140%" height="140%">
                                        <feDropShadow dx="0" dy="2" stdDeviation="4" flood-opacity="0.1"/>
                                    </filter>
                                </defs>
                                <g filter="url(#doughnutShadow)">
                                    <t t-foreach="revenueByService" t-as="slice" t-key="slice.label">
                                        <path t-att-d="doughnutPath(slice_index, revenueByService.length)" t-att-fill="slice.color" stroke="#ffffff" stroke-width="2"/>
                                    </t>
                                </g>
                                <circle cx="90" cy="90" r="48" fill="#ffffff"/>
                                <circle cx="90" cy="90" r="48" fill="none" stroke="#eef2f3" stroke-width="1"/>
                                <text x="90" y="84" text-anchor="middle" class="sop_doughnut_center_label">PHP</text>
                                <text x="90" y="106" text-anchor="middle" class="sop_doughnut_center_value">6.66M</text>
                            </svg>
                            <div class="sop_exec_doughnut_legend">
                                <t t-foreach="revenueByService" t-as="slice" t-key="slice.label">
                                    <div class="sop_exec_doughnut_item">
                                        <span class="sop_legend_dot" t-att-style="'background:' + slice.color"/>
                                        <span class="sop_exec_doughnut_item_label" t-esc="slice.label"/>
                                        <span class="sop_exec_doughnut_item_value" t-esc="'PHP ' + (slice.value / 1000).toFixed(1) + 'M'"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </article>
                </section>
            </t>

            <section t-if="isOverview" class="sop_panel sop_modules">
                <div class="sop_panel_header">
                    <div>
                        <h2>Missing Workflow Visualizations</h2>
                        <p>General flows and dummy data for the client to understand the target output</p>
                    </div>
                    <span class="sop_active_module">Overview</span>
                </div>
                <div class="sop_module_grid">
                    <button t-foreach="modules" t-as="module" t-key="module.title"
                            type="button"
                            t-att-class="module.title === state.activeModule ? 'is-active' : ''"
                            t-on-click="() => selectModule(module)">
                        <span t-esc="module.status"/>
                        <strong t-esc="module.title"/>
                        <p t-esc="module.text"/>
                    </button>
                </div>
            </section>
        </main>
    </t>
</templates>
