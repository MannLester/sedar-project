<odoo>
    <record id="view_sedar_hsse_risk_assessment_tree" model="ir.ui.view">
        <field name="name">sedar.hsse.risk.assessment.tree</field>
        <field name="model">sedar.hsse.risk.assessment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="activity"/>
                <field name="hazard"/>
                <field name="likelihood"/>
                <field name="severity"/>
                <field name="risk_score"/>
            </tree>
        </field>
    </record>
    <record id="view_sedar_hsse_risk_assessment_form" model="ir.ui.view">
        <field name="name">sedar.hsse.risk.assessment.form</field>
        <field name="model">sedar.hsse.risk.assessment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="activity"/>
                        <field name="hazard"/>
                        <field name="likelihood"/>
                        <field name="severity"/>
                        <field name="risk_score"/>
                        <field name="mitigation"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sedar_hsse_risk_assessment" model="ir.actions.act_window">
        <field name="name">Risk Assessments</field>
        <field name="res_model">sedar.hsse.risk.assessment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
