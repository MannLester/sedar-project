<odoo>
    <record id="view_sedar_hsse_inspection_tree" model="ir.ui.view">
        <field name="name">sedar.hsse.inspection.tree</field>
        <field name="model">sedar.hsse.inspection</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="name"/>
                <field name="inspection_type"/>
                <field name="auditor_id"/>
                <field name="vessel_id"/>
            </tree>
        </field>
    </record>
    <record id="view_sedar_hsse_inspection_form" model="ir.ui.view">
        <field name="name">sedar.hsse.inspection.form</field>
        <field name="model">sedar.hsse.inspection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="inspection_type"/>
                        <field name="auditor_id"/>
                        <field name="date"/>
                        <field name="vessel_id"/>
                        <field name="findings"/>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="item"/>
                                    <field name="result"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sedar_hsse_inspection" model="ir.actions.act_window">
        <field name="name">Inspections &amp; Audits</field>
        <field name="res_model">sedar.hsse.inspection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
